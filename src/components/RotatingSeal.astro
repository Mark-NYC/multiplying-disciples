---
// Small rotating brand detail — inspired by the rotating seal on YWAM's
// homepage, built from our own artwork. Three independent layers: a
// solid dark plate (so the light artwork stays legible regardless of
// which section background this sits on), a fixed-but-slowly-turning
// center logo (md-logo-square.webp, used as-is), and an SVG text ring
// that rotates the opposite direction around it. Clicking/activating
// the whole seal scrolls back to top — see the inline script below.
// Kept separate from BrandSeal.astro (the static crosshair seal used
// in the footer/article CTA band): that one is a wordless page
// ornament, this one is a real logo plus a specific "back to top"
// action.
interface Props {
  // Set false for a purely decorative, non-animated instance (e.g. the
  // footer) — same artwork, same markup, zero movement.
  spin?: boolean;
  // Fixed diameter (e.g. "6.5rem") that overrides the default
  // responsive sizing at every breakpoint. Leave unset to use the
  // built-in 96px/112px/132px mobile/tablet/desktop scale.
  size?: string;
  // Backing plate color (any valid CSS color). Defaults to the brand's
  // Primary Green.
  plate?: string;
  class?: string;
}

const { spin = true, size, plate, class: className } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
const ringId = `rotating-seal-ring-${uid}`;
const styleParts = [
  size && `--rotating-seal-size: ${size}`,
  plate && `--rotating-seal-plate: ${plate}`,
].filter(Boolean);
const style = styleParts.length ? styleParts.join('; ') : undefined;
---

<button
  type="button"
  class:list={['rotating-seal', { 'rotating-seal--static': !spin }, className]}
  style={style}
  aria-label="Back to top">
  <span class="rotating-seal__plate" aria-hidden="true"></span>
  <svg class="rotating-seal__ring" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <defs>
      <path id={ringId} d="M 100,100 m -80,0 a 80,80 0 1,1 160,0 a 80,80 0 1,1 -160,0" />
    </defs>
    <circle cx="100" cy="100" r="97" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
    <text font-size="11.5" letter-spacing="3.5" font-weight="700" fill="currentColor">
      <textPath href={`#${ringId}`}
        >MULTIPLYING DISCIPLES &#8226; FIELD-TESTED &#8226; MULTIPLYING DISCIPLES &#8226; FIELD-TESTED &#8226;</textPath
      >
    </text>
  </svg>
  <img
    class="rotating-seal__logo"
    src="/md-logo-square.webp"
    alt=""
    width="200"
    height="200"
    loading="lazy"
    decoding="async"
  />
</button>

<script>
  // One listener for every seal instance on the page (there's normally
  // just one). Scroll-to-top only — no navigation, no hash change, so
  // it works identically on every page.
  document.addEventListener('click', (event) => {
    const seal = (event.target as Element).closest('.rotating-seal');
    if (!seal) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  });
</script>

<style>
  /* Plain, unstyled button reset — this must read as a small brand mark,
     not a UI control. */
  .rotating-seal {
    position: relative;
    display: block;
    /* --rotating-seal-size (set via the `size` prop) wins at every
       breakpoint when present; otherwise falls back to the responsive
       scale below. */
    width: var(--rotating-seal-size, 6rem);
    height: var(--rotating-seal-size, 6rem);
    padding: 0;
    margin: 0;
    background: none;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-footer-text-muted);
    flex-shrink: 0;
  }

  @media (min-width: 641px) {
    .rotating-seal {
      width: var(--rotating-seal-size, 7rem);
      height: var(--rotating-seal-size, 7rem);
    }
  }

  @media (min-width: 1024px) {
    .rotating-seal {
      width: var(--rotating-seal-size, 8.25rem);
      height: var(--rotating-seal-size, 8.25rem);
    }
  }

  /* Restrained focus ring — visible for keyboard users, not styled to
     look like a button. */
  .rotating-seal:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
  }

  /* Solid dark plate behind the ring + logo — both are light-colored
     artwork made for a dark ground, so the seal carries its own
     backdrop instead of depending on the section it's placed in. */
  .rotating-seal__plate {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--rotating-seal-plate, var(--color-primary));
  }

  .rotating-seal__ring {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    text-transform: uppercase;
    animation: rotating-seal-spin-cw 50s linear infinite;
  }

  /* Fixed-center logo — used exactly as provided, no shadows/glow/
     borders. It turns the opposite direction from the ring, a little
     slower, so the two layers never feel like one spinning graphic.
     The static translate is the resting position whenever the
     animation is off (reduced motion, or the non-spinning variant) —
     without it the image would sit corner-anchored instead of
     centered when `animation` drops to `none`. */
  .rotating-seal__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 46%;
    height: 46%;
    border-radius: 0;
    animation: rotating-seal-spin-ccw 70s linear infinite;
  }

  @keyframes rotating-seal-spin-cw {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes rotating-seal-spin-ccw {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(-360deg);
    }
  }

  /* Desktop only — touch devices don't get a lingering "hover" state
     that never releases. */
  @media (hover: hover) and (pointer: fine) {
    .rotating-seal:hover .rotating-seal__ring {
      animation-duration: 30s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotating-seal__ring,
    .rotating-seal__logo {
      animation: none;
    }
  }

  /* Non-spinning variant (spin={false}) — identical artwork, position,
     and size; no movement, ever, regardless of hover or motion
     preference. */
  .rotating-seal--static .rotating-seal__ring,
  .rotating-seal--static .rotating-seal__logo {
    animation: none;
  }
</style>
