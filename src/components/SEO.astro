---
import { SITE } from '../data/site';
import { imageDimensions } from '../lib/image-dimensions.mjs';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  type?: 'website' | 'article';
  author?: { name: string; url: string };
  // Opt-in per page (via an article's `og_image_alt`): when set, the
  // social image gets width/height/type/alt tags. Dimensions come from
  // the real file, type from the extension — nothing hardcoded, and
  // pages that don't set it are untouched.
  ogImageAlt?: string;
  // Explicit, ordered image list for the Article JSON-LD `image` array
  // (site-relative paths, resolved to absolute here). Falls back to the
  // single social image when empty.
  schemaImages?: string[];
  publishedDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  // Opt-in FAQ pairs (see the articles schema). Each becomes a
  // schema.org Question in a FAQPage block; only pass Q&As that are
  // visible in the page body.
  faq?: { question: string; answer: string }[];
  // Opt-in sitewide entity schema (Organization + WebSite). Set once,
  // on the homepage, so Google/AI have a single authoritative
  // Organization node (logo + real sameAs profiles) and a WebSite node
  // that advertises the real /search/?q= endpoint. Every other page
  // keeps only the lightweight publisher stub in its Article/WebPage
  // graph — no duplicate Organization entities across the site.
  siteSchema?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  type = 'website',
  author,
  ogImageAlt,
  schemaImages = [],
  publishedDate,
  updatedDate,
  noindex = false,
  faq = [],
  siteSchema = false,
} = Astro.props;

const pageTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const resolvedImage = ogImage
  ? new URL(ogImage, SITE.url).toString()
  : undefined;

const MIME_BY_EXT: Record<string, string> = {
  webp: 'image/webp',
  png: 'image/png',
  jpg: 'image/jpeg',
  jpeg: 'image/jpeg',
  gif: 'image/gif',
};

// Enhanced social-image metadata, derived (not hardcoded) from the
// image file itself; only produced when the page opts in with an alt.
const ogImageMeta =
  ogImage && ogImageAlt
    ? {
        ...imageDimensions(ogImage),
        type: MIME_BY_EXT[ogImage.split('.').pop()?.toLowerCase() ?? ''],
        alt: ogImageAlt,
      }
    : undefined;

// Article schema image array: the explicit ordered list when provided,
// otherwise the single social image (prior behavior).
const schemaImageUrls =
  schemaImages.length > 0
    ? schemaImages.map((src) => new URL(src, SITE.url).toString())
    : resolvedImage
      ? [resolvedImage]
      : [];

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        mainEntityOfPage: canonical,
        url: canonical,
        ...(publishedDate ? { datePublished: publishedDate.toISOString() } : {}),
        ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
        ...(schemaImageUrls.length ? { image: schemaImageUrls } : {}),
        ...(author
          ? {
              author: {
                '@type': 'Person',
                name: author.name,
                url: new URL(author.url, SITE.url).toString(),
              },
            }
          : {}),
        publisher: {
          '@type': 'Organization',
          name: SITE.name,
          url: SITE.url,
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: title,
        description,
        url: canonical,
      };

// Optional FAQPage block, emitted only when the page supplies visible
// Q&As. Kept separate from the Article/WebPage graph so it stays valid
// on its own.
const faqJsonLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : undefined;

// Sitewide entity graph, emitted once (homepage). The Organization's
// sameAs uses only the real, owner-provided social profiles in
// site.ts; the WebSite's SearchAction points at the real /search/
// GET endpoint (see the header/menu search forms). Logo is the square
// brand mark. No address/phone/contact is asserted here — Organization
// is the correct type for a ministry resource site, not LocalBusiness.
const organizationJsonLd = siteSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: new URL('/md-logo-square.webp', SITE.url).toString(),
      description: SITE.description,
      sameAs: Object.values(SITE.social).filter(Boolean),
    }
  : undefined;

const websiteJsonLd = siteSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      url: SITE.url,
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE.url}/search/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    }
  : undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  /* Indexable pages get the full-visibility preview directive that the old
     WordPress/Yoast site emitted by default and the Astro rebuild dropped:
     without it Google falls back to max-image-preview:standard, shrinking the
     large image previews (including the /wp-content/ images) this site
     historically surfaced in Search and AI surfaces. noindex pages keep the
     original noindex, nofollow and never get a preview directive. */
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )
}

<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{resolvedImage && <meta property="og:image" content={resolvedImage} />}
{ogImageMeta?.width && <meta property="og:image:width" content={String(ogImageMeta.width)} />}
{ogImageMeta?.height && <meta property="og:image:height" content={String(ogImageMeta.height)} />}
{ogImageMeta?.type && <meta property="og:image:type" content={ogImageMeta.type} />}
{ogImageMeta?.alt && <meta property="og:image:alt" content={ogImageMeta.alt} />}

<meta name="twitter:card" content={resolvedImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{resolvedImage && <meta name="twitter:image" content={resolvedImage} />}
{ogImageMeta?.alt && <meta name="twitter:image:alt" content={ogImageMeta.alt} />}

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
{faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}
{organizationJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />}
{websiteJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)} />}
