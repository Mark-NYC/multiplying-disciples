---
import { PRIMARY_NAV, MENU_FEATURED, MENU_TOPICS, MENU_CONTACT } from '../data/navigation';
import { SITE } from '../data/site';
import RotatingSeal from './RotatingSeal.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : href !== '' && currentPath.startsWith(href);

// Desktop header nav drops "About" — it stays in the hamburger menu,
// which renders the full PRIMARY_NAV.
const HEADER_NAV = PRIMARY_NAV.filter((link) => link.label !== 'About');
// The header's own "Join a Lab" button is redundant on the homepage
// (the hero already leads with the lab CTA), so hide it there.
const isHome = currentPath === '/';
---

<header class:list={['site-header', { 'site-header--home': currentPath === '/' }]}>
  <div class="site-header__inner">
    <a class="site-header__logo" href="/">
      <img src="/images/logo.png" alt={SITE.name} width="290" height="44" />
    </a>

    <nav aria-label="Primary" class="site-header__nav-wrap">
      <ul class="site-header__nav">
        {
          HEADER_NAV.map((link) =>
            link.children ? (
              <li class="site-header__dropdown">
                <details>
                  <summary aria-haspopup="true">{link.label}</summary>
                  <ul class="site-header__dropdown-menu">
                    {link.children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <div class="site-header__actions">
        {/* A real link, not a JS toggle — search lives at /search/ so
            this stays useful with JavaScript disabled. */}
        <a class="site-header__search" href="/search/" aria-label="Search the site">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.8-4.8" />
          </svg>
        </a>
        {!isHome && <a class="button button--small" href="/#ch-practice">Join a Lab</a>}
        <ul class="site-header__socials">
          <li>
            <a href={SITE.social.facebook} aria-label="Multiplying Disciples on Facebook">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.9.25-1.5 1.55-1.5H16.5V4.3C16.2 4.26 15.2 4.17 14 4.17c-2.4 0-4 1.46-4 4.15V10.5H7.5v3H10V21h3.5z" />
              </svg>
            </a>
          </li>
          <li>
            <a href={SITE.social.instagram} aria-label="Multiplying Disciples on Instagram">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
              </svg>
            </a>
          </li>
          <li>
            <a href={SITE.social.youtube} aria-label="Multiplying Disciples on YouTube">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M21.6 7.5c-.25-1-1-1.75-2-2C17.9 5 12 5 12 5s-5.9 0-7.6.5c-1 .25-1.75 1-2 2C2 9.2 2 12 2 12s0 2.8.4 4.5c.25 1 1 1.75 2 2C6.1 19 12 19 12 19s5.9 0 7.6-.5c1-.25 1.75-1 2-2 .4-1.7.4-4.5.4-4.5s0-2.8-.4-4.5zM10 15V9l5.2 3-5.2 3z" />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </nav>

    {/* Menu trigger. The checkbox + labels are the no-JavaScript
        fallback (open/close still work); the real <button>s are
        unhidden by the script below, which then owns state, focus,
        Escape, and scroll lock. */}
    <input type="checkbox" id="nav-toggle" class="site-header__toggle-input" />
    <label for="nav-toggle" class="site-header__toggle" data-menu-fallback-open aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </label>
    <button
      type="button"
      class="site-header__toggle"
      data-menu-open
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Menu"
      hidden
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <label class="site-header__backdrop" for="nav-toggle" data-menu-backdrop aria-hidden="true"
    ></label>

    <div class="site-menu" id="site-menu" data-menu-panel aria-label="Site menu" tabindex="-1">
      {/* Top bar: logo · search · close (close sits top-right on desktop,
          drops to the foot on mobile — see CSS). */}
      <div class="site-menu__bar">
        <RotatingSeal size="3.5rem" plate="#6f6552" class="site-menu__seal" />

        {/* Real GET form to /search/ — works with no JS (query lives in
            ?q=, read by src/pages/search/index.astro). */}
        <form class="site-menu__search" action="/search/" method="get" role="search">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="M21 21l-4.8-4.8" />
          </svg>
          <input type="search" name="q" placeholder="Search Multiplying Disciples" aria-label="Search Multiplying Disciples" />
        </form>
      </div>

      <nav aria-label="Site menu" class="site-menu__nav">
        {/* Column 1 — the large primary destinations + CTA. */}
        <div class="site-menu__col site-menu__col--lead">
          <ul class="site-menu__primary">
            {PRIMARY_NAV.map((link) => (
              <li>
                <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <a class="button site-menu__cta" href="/#ch-practice">Join a Live Lab</a>

          <ul class="site-menu__socials">
            <li>
              <a href={SITE.social.facebook} aria-label="Multiplying Disciples on Facebook">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M13.5 21v-7.5h2.5l.5-3h-3V8.5c0-.9.25-1.5 1.55-1.5H16.5V4.3C16.2 4.26 15.2 4.17 14 4.17c-2.4 0-4 1.46-4 4.15V10.5H7.5v3H10V21h3.5z" />
                </svg>
              </a>
            </li>
            <li>
              <a href={SITE.social.instagram} aria-label="Multiplying Disciples on Instagram">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
                </svg>
              </a>
            </li>
            <li>
              <a href={SITE.social.youtube} aria-label="Multiplying Disciples on YouTube">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                  <path d="M21.6 7.5c-.25-1-1-1.75-2-2C17.9 5 12 5 12 5s-5.9 0-7.6.5c-1 .25-1.75 1-2 2C2 9.2 2 12 2 12s0 2.8.4 4.5c.25 1 1 1.75 2 2C6.1 19 12 19 12 19s5.9 0 7.6-.5c1-.25 1.75-1 2-2 .4-1.7.4-4.5.4-4.5s0-2.8-.4-4.5zM10 15V9l5.2 3-5.2 3z" />
                </svg>
              </a>
            </li>
          </ul>
        </div>

        {/* Column 2 — muted secondary lists. */}
        <div class="site-menu__col site-menu__resources">
          <div class="site-menu__group">
            <p class="eyebrow eyebrow--gold-text">More Resources</p>
            <ul>
              {MENU_FEATURED.map((link) => (
                <li>
                  <a href={link.href} rel={link.externalDomain ? 'noopener' : undefined}>
                    {link.label}
                    {link.externalDomain && (
                      <span class="site-menu__external">{link.externalDomain} &#8599;</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="site-menu__group">
            <p class="eyebrow eyebrow--gold-text">Browse Topics</p>
            <ul>
              {MENU_TOPICS.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
              <li>
                <a href={MENU_CONTACT.href}>{MENU_CONTACT.label}</a>
              </li>
            </ul>
          </div>
        </div>

        {/* Column 3 — a featured sticker (to the sticker shop) and the
            featured article. Desktop only; the mobile sheet stays lean. */}
        <div class="site-menu__col site-menu__featured">
          <a class="site-menu__sticker" href="/stickers/" aria-label="3 Circles gospel stickers">
            <img
              src="/wp-content/uploads/2025/10/3-circles-sticker-cheap-1024x792.webp"
              alt="3 Circles gospel presentation sticker"
              width="1024"
              height="792"
              loading="lazy"
              decoding="async"
            />
            <span class="site-menu__sticker-caption">Order stickers &#8599;</span>
          </a>

          <a class="site-menu__article" href="/the-three-circles-gospel-presentation-step-by-step/">
            <span class="eyebrow eyebrow--gold-text">Featured Article</span>
            <img
              src="/wp-content/uploads/2023/05/3-Circles-Gospel-Presentation-1-1024x576.webp"
              alt="The 3 Circles gospel presentation diagram"
              width="1024"
              height="576"
              loading="lazy"
              decoding="async"
            />
            <span class="site-menu__article-title">The 3 Circles Gospel Presentation</span>
          </a>
        </div>
      </nav>

      {/* Foot: close control (bottom-left on mobile, floated top-right on
          desktop) plus socials. */}
      <div class="site-menu__foot">
        <label for="nav-toggle" class="site-menu__close" data-menu-fallback-close aria-label="Close menu">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </label>
        <button type="button" class="site-menu__close" data-menu-close aria-label="Close menu" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Accessible drawer behavior for the site menu. Progressive
  // enhancement: without JS the checkbox + labels above still open and
  // close the panel; with JS the real buttons take over and add
  // aria-expanded, Escape, a focus trap, focus restoration, and scroll
  // lock.
  const checkbox = document.getElementById('nav-toggle') as HTMLInputElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');
  const fallbackOpen = document.querySelector<HTMLElement>('[data-menu-fallback-open]');
  const fallbackClose = document.querySelector<HTMLElement>('[data-menu-fallback-close]');

  if (checkbox && openBtn && closeBtn && panel && backdrop) {
    // Swap the no-JS controls for the real buttons.
    checkbox.disabled = true;
    checkbox.checked = false;
    fallbackOpen?.setAttribute('hidden', '');
    fallbackClose?.setAttribute('hidden', '');
    openBtn.hidden = false;
    closeBtn.hidden = false;

    let lastFocused: Element | null = null;

    function focusables(): HTMLElement[] {
      return Array.from(
        panel!.querySelectorAll<HTMLElement>('a[href], button:not([hidden]), input:not([disabled])'),
      ).filter((el) => el.offsetParent !== null || el === closeBtn);
    }

    function onKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== 'Tab') return;
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    function open() {
      lastFocused = document.activeElement;
      panel!.classList.add('is-open');
      backdrop!.classList.add('is-open');
      panel!.setAttribute('role', 'dialog');
      panel!.setAttribute('aria-modal', 'true');
      openBtn!.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      // Focus the panel itself (tabindex=-1), not a control — avoids
      // scrolling the sheet to the foot close or popping the mobile
      // keyboard on the search field, while the Tab trap still works.
      panel!.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function close() {
      panel!.classList.remove('is-open');
      backdrop!.classList.remove('is-open');
      panel!.removeAttribute('role');
      panel!.removeAttribute('aria-modal');
      openBtn!.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    }

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    // Following a link should close the drawer (matters for same-page
    // anchors like /#ch-practice, where no navigation event fires).
    panel.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a[href], .rotating-seal')) close();
    });
  }
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  /* Home page only: white bar with no divider under it. */
  .site-header--home {
    background-color: #fff;
    border-bottom-color: transparent;
  }

  .site-header__inner {
    max-width: var(--header-max-width);
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .site-header__logo img {
    height: 1.3rem;
    width: auto;
    border-radius: 0;
  }

  .site-header__toggle-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* The hamburger — shown at every width, far right. Shared styling
     for the no-JS <label> and the real <button>. */
  .site-header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.6rem;
    background: transparent;
    border: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .site-header__toggle[hidden] {
    display: none;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
  }

  .site-header__toggle:hover span {
    background: var(--color-accent-hover);
  }

  .site-header__toggle-input:focus-visible ~ .site-header__toggle {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .site-header__nav-wrap {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2rem;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    text-decoration: none;
    color: var(--color-text);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .site-header__nav a:hover {
    color: var(--color-accent-hover);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-accent-hover);
    font-weight: 700;
  }

  /* Resources dropdown — <details>/<summary> so it works with zero JS.
     (No PRIMARY_NAV item currently has children; kept for when one
     does.) */
  .site-header__dropdown details {
    position: relative;
  }

  .site-header__dropdown summary {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
    color: var(--color-text);
    font-size: 1.15rem;
    font-weight: 500;
    list-style: none;
  }

  .site-header__dropdown summary::-webkit-details-marker {
    display: none;
  }

  .site-header__dropdown summary:hover {
    color: var(--color-accent-hover);
  }

  .site-header__dropdown-menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    min-width: 12rem;
    z-index: 20;
  }

  .site-header__dropdown-menu li {
    white-space: nowrap;
  }

  .site-header__dropdown-menu a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: calc(var(--radius-card) - 4px);
    font-size: 0.95rem;
  }

  .site-header__dropdown-menu a:hover {
    background: var(--color-surface);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .site-header__search {
    display: flex;
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__search:hover {
    color: var(--color-accent-hover);
  }

  .site-header__socials {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__socials a {
    display: flex;
    color: var(--color-text);
  }

  .site-header__socials a:hover {
    color: var(--color-accent-hover);
  }

  /* --- Full-screen menu (YWAM-style layout, MD brand) --------------
     Covers the viewport in Warm Paper: a top bar (logo · search), a
     column of large primary links, a Join-a-Lab CTA, muted resource
     groups, and a foot (close + socials). The close floats top-right on
     desktop and drops to the foot on mobile. */

  /* Backdrop is unused now that the menu is a full-screen sheet. */
  .site-header__backdrop {
    display: none;
  }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background: var(--color-bg);
    padding: 1.1rem 1.5rem 2rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem);
  }

  .site-menu:focus {
    outline: none;
  }

  /* Open state — driven by JS (.is-open) or, without JS, by the checkbox. */
  .site-menu.is-open,
  .site-header__toggle-input:checked ~ .site-menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-menu {
      transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
    }
  }

  /* --- Top bar: logo · search --- */
  .site-menu__bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: var(--header-max-width);
    margin: 0 auto;
  }

  .site-menu__seal {
    flex-shrink: 0;
  }

  .site-menu__search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 32rem;
    padding: 0.65rem 1.1rem;
    background: var(--color-surface);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
  }

  .site-menu__search:focus-within {
    border-color: var(--color-accent);
    background: #fff;
    color: var(--color-text);
  }

  .site-menu__search svg {
    flex-shrink: 0;
  }

  .site-menu__search input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    background: transparent;
    font: inherit;
    font-size: 1rem;
    color: var(--color-text);
  }

  .site-menu__search input::placeholder {
    color: var(--color-text-muted);
  }

  .site-menu__search input:focus {
    outline: none;
  }

  /* --- Nav body --- */
  .site-menu__nav {
    width: 100%;
    max-width: var(--header-max-width);
    margin: 2.5rem auto 0;
    flex: 1 1 auto;
  }

  .site-menu__primary {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-menu__primary a {
    display: inline-block;
    padding: 0.3rem 0;
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-menu__primary a:hover,
  .site-menu__primary a[aria-current='page'] {
    color: var(--color-accent-hover);
  }

  .site-menu__cta {
    display: inline-flex;
    margin-top: 1.75rem;
  }

  .site-menu__resources {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 2.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .site-menu__group .eyebrow {
    margin: 0 0 0.85rem;
  }

  .site-menu__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-menu__group a {
    display: block;
    padding: 0.3rem 0;
    font-size: 1.05rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-menu__group a:hover {
    color: var(--color-accent-hover);
