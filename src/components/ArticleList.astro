---
// ArticleList — the one shared "list of articles" treatment, used by
// the /blog/ index and every hub page so both surfaces read as the
// same visual family. As of the 2026-07 thumbnail redesign this is an
// image-led card grid (3-up desktop, 2-up tablet, 1-up full-width
// mobile): the article's og_image/hero_image caps each card, then the
// hub label, title, description, and — when the article curates any —
// a row of tappable question pills that deep-link into the article at
// the heading that answers them. Articles without an image render as
// clean text cards; articles without questions simply omit the pill
// row. See blog/index.astro and HubLayout.astro.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { imageDimensions } from '../lib/image-dimensions.mjs';

interface Props {
  entries: CollectionEntry<'articles'>[];
  // Hide the per-card hub link (used on hub pages, where every card
  // belongs to the hub the visitor is already on).
  showHub?: boolean;
  // 'h2' on the blog index (cards sit directly under the page H1);
  // 'h3' on hub pages, where the cards sit under a "Key Articles" H2.
  titleHeading?: 'h2' | 'h3';
}

const { entries, showHub = true, titleHeading = 'h2' } = Astro.props;
const TitleTag = titleHeading;

const hubs = showHub ? await getCollection('hubs') : [];

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function hubFor(entry: CollectionEntry<'articles'>) {
  if (!entry.data.hub) return undefined;
  // Hub entry ids are their frontmatter `slug`, not the bare filename.
  return hubs.find((hub) => hub.id === `/${entry.data.hub}/`);
}

function bestDate(entry: CollectionEntry<'articles'>): Date | undefined {
  return entry.data.updated ?? entry.data.date;
}
---

<ul class="article-grid">
  {entries.map((entry) => {
    const hub = showHub ? hubFor(entry) : undefined;
    const date = bestDate(entry);
    const thumb = entry.data.og_image ?? entry.data.hero_image;
    const thumbDims = thumb ? imageDimensions(thumb) : undefined;
    const slug = entry.data.slug;
    const questions = entry.data.questions.slice(0, 3);
    return (
      <li class="article-card">
        {thumb && (
          <a href={slug} class="article-card__media" aria-hidden="true" tabindex="-1">
            <img
              src={thumb}
              alt=""
              loading="lazy"
              decoding="async"
              width={thumbDims?.width ?? 1200}
              height={thumbDims?.height ?? 800}
            />
          </a>
        )}
        <div class="article-card__body">
          {(hub || date) && (
            <p class="article-card__eyebrow">
              {hub && <a href={hub.data.slug} class="article-card__hub">{hub.data.title}</a>}
              {hub && date && <span aria-hidden="true"> &middot; </span>}
              {date && <time datetime={date.toISOString()}>{dateFormatter.format(date)}</time>}
            </p>
          )}
          <TitleTag class="article-card__title">
            <a href={slug}>{entry.data.display_title ?? entry.data.title}</a>
          </TitleTag>
          <p class="article-card__desc">{entry.data.description}</p>
          {questions.length > 0 && (
            <ul class="article-card__questions" aria-label="Questions this article answers">
              {questions.map((question) => (
                <li>
                  <a class="qpill" href={`${slug}#${question.anchor}`}>
                    <span>{question.q}</span>
                    <span class="qpill__arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    );
  })}
</ul>

<style>
  /* Masonry via CSS multi-column: cards keep their natural height (see
     the media rule below) and stagger into columns instead of snapping
     to a shared row baseline. Column-major order — items fill column 1,
     then 2, then 3 — which is fine for a browse grid where the editorial
     lead already lives in the featured band above. */
  .article-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: 3;
    column-gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .article-grid {
      column-count: 2;
    }
  }

  @media (max-width: 600px) {
    .article-grid {
      column-count: 1;
    }
  }

  .article-card {
    display: block;
    /* Vertical rhythm between stacked cards (column-gap only spaces
       columns horizontally) and never let a card split across columns. */
    margin: 0 0 1.5rem;
    break-inside: avoid;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(31, 37, 35, 0.05);
  }

  .article-card:hover {
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .article-card {
      transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }
    .article-card:hover {
      box-shadow: 0 8px 24px rgba(23, 76, 60, 0.12);
      transform: translateY(-2px);
    }
    .article-card__media img {
      transition: transform 0.35s ease;
    }
    .article-card:hover .article-card__media img {
      transform: scale(1.03);
    }
  }

  /* Image caps the card and flexes to the thumbnail's own aspect ratio
     — no forced crop, so nothing gets chopped and the varied shapes are
     what give the masonry grid its stagger. The width/height attributes
     (real intrinsic dimensions) reserve the right space, so there's no
     layout shift as each image loads. */
  .article-card__media {
    display: block;
    overflow: hidden;
    background: var(--color-surface);
  }

  .article-card__media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-card__body {
    padding: 1.1rem 1.15rem 1.2rem;
  }

  .article-card__eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .article-card__hub {
    color: var(--color-gold-text);
    font-weight: 700;
    text-decoration: none;
  }

  .article-card__hub:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-card__title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .article-card__title a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .article-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }

  .article-card__desc {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* Question pills — pushed to the bottom of the card (margin-top:auto)
     so they line up across a row of unequal-length cards, separated by
     a quiet dashed rule. Each links to /article/#answer-heading. */
  .article-card__questions {
    list-style: none;
    margin: 0;
    padding: 0.85rem 0 0;
    border-top: 1px dashed var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .qpill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  .qpill__arrow {
    color: var(--color-accent);
    font-weight: 700;
  }

  .qpill:hover {
    border-color: var(--color-accent);
    background: #ffffff;
    color: var(--color-primary-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .qpill {
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    }
    .qpill:hover {
      transform: translateY(-1px);
    }
  }
</style>
