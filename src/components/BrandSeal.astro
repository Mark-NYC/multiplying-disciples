---
// Clean circular brand seal — circular "MULTIPLYING DISCIPLES ·
// FIELD-TESTED" text around a crosshair mark. Crisp SVG only, no
// distress/displacement filter. Colored via currentColor; sized by
// the parent wrapper. Used sitewide: homepage conviction band,
// footer, article closing CTA band.
const uid = Math.random().toString(36).slice(2, 9);
---

<svg class="brand-seal" viewBox="0 0 200 200" aria-hidden="true">
  <defs>
    <path id={`seal-circle-${uid}`} d="M 100,100 m -78,0 a 78,78 0 1,1 156,0 a 78,78 0 1,1 -156,0" />
  </defs>
  <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="3" />
  <circle cx="100" cy="100" r="62" fill="none" stroke="currentColor" stroke-width="1.5" />
  <text font-size="12" letter-spacing="3.5" font-weight="700" fill="currentColor">
    <textPath href={`#seal-circle-${uid}`}>MULTIPLYING DISCIPLES &#183; FIELD-TESTED &#183; MULTIPLYING DISCIPLES &#183;</textPath>
  </text>
  <path d="M100,70 v60 M70,100 h60" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  <circle cx="100" cy="100" r="6" fill="currentColor" />
</svg>

<style>
  .brand-seal {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
