---
// InsightCard — clarifies a key idea, framework, definition, summary,
// or theological distinction. White card, subtle border, restrained
// shadow, small green eyebrow.
//
// Use: 0-2 per normal article; a long article may use more, spaced far
// apart (roughly one visual break per 600-900 words of surrounding
// text). Do not convert every list or blockquote into one — most
// paragraphs should just stay paragraphs.
//
// `label` is required on purpose: every card should say what kind of
// idea it is (e.g. "The Core Idea", "Key Distinction", "What This
// Means", "Movement Principle", "Summary") rather than defaulting to
// the generic word "Insight" everywhere.
//
// `accent` and `icon` are both optional and off by default — omitting
// them renders exactly the plain white card every other article
// already uses. Only reach for them when a set of cards represents
// parallel, named categories worth telling apart at a glance (e.g. one
// card per role in a framework) — not as routine decoration.
//
// Usage: <InsightCard label="Key Distinction">...markdown...</InsightCard>
// Usage with an icon + accent color:
//   <InsightCard label="The Apostle" accent="clay" icon="/path/icon.png" iconAlt="...">...</InsightCard>
interface Props {
  label: string;
  accent?: 'primary' | 'accent' | 'gold' | 'clay' | 'ink';
  icon?: string;
  iconAlt?: string;
}

const { label, accent, icon, iconAlt } = Astro.props;
---

<div class:list={['fm-insight-card', accent && `fm-insight-card--${accent}`]}>
  <div class="fm-insight-card__head">
    {icon && <img class="fm-insight-card__icon" src={icon} alt={iconAlt ?? ''} loading="lazy" />}
    <p class="fm-insight-card__label">{label}</p>
  </div>
  <div class="fm-insight-card__body">
    <slot />
  </div>
</div>
