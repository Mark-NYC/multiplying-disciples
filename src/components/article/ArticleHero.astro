---
// ArticleHero — category eyebrow, left-aligned title, restrained
// subheading, quiet metadata, then a wide editorial image with a
// specific caption. Never centered, never text-over-photo. Renders
// exactly what it's given — no field is required if the article
// doesn't have it (a subheading-less or image-less article still
// renders a complete-looking hero).
interface Props {
  category: string;
  title: string;
  subheading?: string;
  date?: Date;
  updatedDate?: Date;
  readingTime?: string;
  image?: string;
  imageAlt?: string;
  imageCaption?: string;
}

const { category, title, subheading, date, updatedDate, readingTime, image, imageAlt, imageCaption } =
  Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const metaParts = [
  date && dateFormatter.format(date),
  updatedDate && `Updated ${dateFormatter.format(updatedDate)}`,
  readingTime,
].filter(Boolean);

// A handful of migrated WordPress titles run 80-100+ characters (a
// title plus an em-dash subtitle). Rather than let those wrap to 6+
// lines at full hero size, step the font down so a long legacy title
// still reads as a controlled block, not a wall of text.
const lengthClass = title.length > 70 ? 'fm-hero__headline--long' : title.length > 50 ? 'fm-hero__headline--medium' : '';
---

<header class="fm-hero">
  <p class="fm-hero__category eyebrow eyebrow--gold-text">{category}</p>
  <h1 class:list={['fm-hero__headline', lengthClass]}>{title}</h1>
  {subheading && <p class="fm-hero__subhead">{subheading}</p>}
  {metaParts.length > 0 && <p class="fm-hero__meta">{metaParts.join(' · ')}</p>}
</header>

{
  image && (
    <figure class="fm-hero__image-wrap">
      <img class="fm-hero__image" src={image} alt={imageAlt ?? ''} loading="eager" />
      {imageCaption && <figcaption class="fm-hero__caption">{imageCaption}</figcaption>}
    </figure>
  )
}
