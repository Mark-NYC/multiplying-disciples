---
// ArticleHero — a person-first hero: optional rare eyebrow, one
// left-aligned human headline, one supporting sentence, quiet
// metadata, then a wide editorial image with a specific caption.
// Never centered, never text-over-photo. Renders exactly what it's
// given — no field is required if the article doesn't have it (an
// eyebrow-less, subheading-less, or image-less article still renders
// a complete-looking hero). See ARTICLE_SYSTEM.md ("Article hero")
// for the full authoring rules — in particular, no
// eyebrow by default; the breadcrumb already carries the hub/category
// context, so an eyebrow that just repeats it is visual noise, not a
// second signal.
interface Props {
  eyebrow?: string;
  title: string;
  subheading?: string;
  date?: Date;
  updatedDate?: Date;
  readingTime?: string;
  image?: string;
  imageAlt?: string;
  imageCaption?: string;
}

import { imageDimensions } from '../../lib/image-dimensions.mjs';

const { eyebrow, title, subheading, date, updatedDate, readingTime, image, imageAlt, imageCaption } =
  Astro.props;

// Real intrinsic dimensions (when the file lives in public/) so the
// hero never causes layout shift under the reader.
const dims = image ? imageDimensions(image) : undefined;

// Square/portrait lead images (mostly WordPress-era social graphics
// and portrait photos) would tower over the article at full reading
// width — crop those to a calm editorial 3:2. Landscape images,
// including tool diagrams, render at their natural proportions.
const isTall = dims ? dims.height / dims.width > 0.9 : false;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const metaParts = [
  date && dateFormatter.format(date),
  updatedDate && `Updated ${dateFormatter.format(updatedDate)}`,
  readingTime,
].filter(Boolean);
---

<header class="fm-hero">
  {eyebrow && <p class="fm-hero__eyebrow eyebrow eyebrow--gold-text">{eyebrow}</p>}
  <h1 class="fm-hero__headline">{title}</h1>
  {subheading && <p class="fm-hero__subhead">{subheading}</p>}
  {metaParts.length > 0 && <p class="fm-hero__meta">{metaParts.join(' · ')}</p>}
</header>

{
  image && (
    <figure class="fm-hero__image-wrap">
      <img
        class:list={['fm-hero__image', { 'fm-hero__image--tall': isTall }]}
        src={image}
        alt={imageAlt ?? ''}
        loading="eager"
        fetchpriority="high"
        width={dims?.width}
        height={dims?.height}
      />
      {imageCaption && <figcaption class="fm-hero__caption">{imageCaption}</figcaption>}
    </figure>
  )
}
