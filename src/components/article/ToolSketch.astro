---
// ToolSketch — a hand-drawn tool icon (black ink) shown on a clean white
// card so it reads in both light and dark themes. For the No Place Left /
// Obey.Tools sketch icons that are simple line art rather than full
// artwork. Centered, capped small; optional relevance caption.
import { imageDimensions } from '../../lib/image-dimensions.mjs';

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const dims = imageDimensions(src);
---

<figure class="tool-sketch">
  <div class="tool-sketch__frame">
    <img
      src={src}
      alt={alt}
      width={dims?.width}
      height={dims?.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .tool-sketch {
    margin: 1.75rem auto 2.25rem;
    max-width: 380px;
  }
  .tool-sketch__frame {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card, 12px);
    padding: 1.5rem;
    display: flex;
    justify-content: center;
  }
  .tool-sketch__frame img {
    width: auto;
    max-width: min(100%, 280px);
    height: auto;
  }
  .tool-sketch figcaption {
    margin-top: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
