---
// ArticleCTA — the one canonical end-of-article CTA. See CTA_GUIDE.md
// for the full authoring reference. Never render more than one of
// these per article.
//
// Driven entirely by `articleCta` (an article's `article_cta`
// frontmatter block) plus a UTM content tag. Supports exactly 4 types:
//   - lab:       the Lab CTA — dynamic next-available-lab card
//                (client-side, via src/lib/labs-feed.js — never
//                hardcode lab data here)
//   - tool:      the Practice CTA — one configured primary
//                destination, no lab card
//   - community: the Tribe CTA — one configured primary destination,
//                optional secondary "next lab" link
//   - none:      renders nothing at all
//
// `articleCta` being undefined (an article with no article_cta block)
// still renders — defaults to `type: "lab"` with generic copy. The
// layout is responsible for passing `{ type: 'none' }` for utility
// pages (see ArticleLayout.astro).
interface Destination {
  label: string;
  href: string;
}

interface ArticleCtaData {
  type?: 'lab' | 'tool' | 'community' | 'none';
  stakes_headline?: string;
  bridge_copy?: string;
  image?: string;
  image_alt?: string;
  destination?: Destination;
}

interface Props {
  articleCta?: ArticleCtaData;
  contentTag?: string;
}

import { imageDimensions } from '../../lib/image-dimensions.mjs';

const { articleCta, contentTag } = Astro.props;

const type = articleCta?.type ?? 'lab';
const stakesHeadline = articleCta?.stakes_headline ?? 'Ready to practice this?';
const bridgeCopy = articleCta?.bridge_copy;
const destination = articleCta?.destination;
const eyebrow = 'TAKE THE NEXT STEP';

// Stable per-page id — there is only ever one ArticleCTA per article.
const labContainerId = 'article-cta-lab';

// One fixed, type-mapped lead image per CTA type — the standardized
// default, in one place. Real photos, not stock — see the alt text for
// what's actually shown. Swap the file to change the image sitewide for
// that type. An individual article may override this default via
// `article_cta.image` + `article_cta.image_alt` (both required
// together) when the standardized image doesn't fit its specific
// destination — see CTA_GUIDE.md. Keep that override rare.
const CTA_IMAGES: Record<'lab' | 'tool' | 'community', { src: string; alt: string }> = {
  lab: {
    src: '/images/CTA-Article-Images/Join a Lab.webp',
    alt: 'A group of about ten people smiling together outdoors after a lab — most of the people pictured are not yet following Jesus, met through ordinary relationships.',
  },
  tool: {
    src: '/images/CTA-Article-Images/Get the Conversation Box Tool.webp',
    alt: 'A hand-drawn Conversation Quadrant: Casual, Meaningful, Spiritual, and Discovery.',
  },
  community: {
    src: '/images/CTA-Article-Images/Join The Community.webp',
    alt: 'Four people gathered around a café table with laptops open, meeting together to practice.',
  },
};
const overrideImage =
  articleCta?.image && articleCta?.image_alt
    ? { src: articleCta.image, alt: articleCta.image_alt }
    : undefined;
const ctaImage = type !== 'none' ? (overrideImage ?? CTA_IMAGES[type]) : undefined;
const ctaImageDims = ctaImage ? imageDimensions(ctaImage.src) : undefined;
---

{
  type !== 'none' && (
    <section class="fm-cta">
      {ctaImage && (
        <img
          class="fm-cta__image"
          src={ctaImage.src}
          alt={ctaImage.alt}
          loading="lazy"
          decoding="async"
          width={ctaImageDims?.width}
          height={ctaImageDims?.height}
        />
      )}
      <p class="fm-cta__eyebrow eyebrow eyebrow--gold-text">{eyebrow}</p>
      <h2 class="fm-cta__headline">{stakesHeadline}</h2>
      {bridgeCopy && <p class="fm-cta__body">{bridgeCopy}</p>}

      {
        type === 'lab' && (
          <div
            class="fm-cta__lab"
            id={labContainerId}
            aria-live="polite"
            data-labs-content-tag={contentTag}
          >
            <p class="fm-cta__lab-loading">Loading the next lab&hellip;</p>
          </div>
        )
      }

      {
        type === 'tool' && destination && (
          <div class="fm-cta__actions">
            <a class="button" href={destination.href}>
              {destination.label}
            </a>
          </div>
        )
      }

      {
        type === 'community' && destination && (
          <div class="fm-cta__actions">
            <a class="button" href={destination.href}>
              {destination.label}
            </a>
            <a class="fm-cta__secondary" href="https://www.covomultipliers.com/#upcoming-labs">
              See the next Live Lab
            </a>
          </div>
        )
      }
    </section>
  )
}

<script>
  // No-ops safely for type !== 'lab' (the container above won't exist).
  import { renderArticleCtaLabInto } from '../../lib/labs-feed.js';

  const container = document.getElementById('article-cta-lab');
  if (container) {
    renderArticleCtaLabInto(container, container.dataset.labsContentTag);
  }
</script>
