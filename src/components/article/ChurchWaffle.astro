---
// ChurchWaffle: shows the existing hand-drawn Church Waffle napkin with
// the middle row (apostles' teaching, fellowship, breaking bread,
// prayer) highlighted, like someone ran a marker over that row on a real
// napkin. Article-specific.
//
// The artwork is an article-specific derivative of the shared napkin
// (public/tools-images/Church-Waffle-tool.svg, used by /starter-tools/).
// The derivative (Church-Waffle-tool-middle-row.svg) only ADDS a
// highlighter band behind the middle row; the underlying waffle, icons,
// labels, texture, proportions, and transparent background are
// unchanged, and the shared file is left untouched.
const src = '/tools-images/Church-Waffle-tool-middle-row.svg';
const alt =
  "The Church Waffle: a hand-drawn circle of twelve church practices in three rows of four, with the middle row highlighted in gold marker: apostles' teaching, fellowship, breaking bread, and prayer.";
const fullWaffleHref = '/movement-resources/12-practice-church-circle/';
---

<figure class="fm-napkin">
  <img src={src} alt={alt} width="650" height="650" loading="lazy" decoding="async" />
  <figcaption>
    This guide focuses on the middle row: apostles' teaching, fellowship, breaking bread, and
    prayer.
  </figcaption>
  <p class="fm-napkin__more">
    <a href={fullWaffleHref}>Explore the full Church Waffle</a>
  </p>
</figure>
