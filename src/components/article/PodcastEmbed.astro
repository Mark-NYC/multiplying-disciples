---
// PodcastEmbed — embeds one H3X episode into an article as supporting
// evidence / deeper teaching. Mirrors FieldNote: an article references
// an episode by id; a missing id renders nothing (never a placeholder,
// never "episode coming soon"). Episodes come from the `episodes`
// content collection (src/data/h3x-episodes.json, refreshed by the
// covo-multipliers "Cache H3X Podcast Feed" Action).
//
// Usage (inside an .mdx article body):
//   import PodcastEmbed from '../../components/article/PodcastEmbed.astro';
//   <PodcastEmbed
//     id="charisma-can-fill-a-room-faithfulness-carries-a-movement"
//     intro="Optional editorial lead-in framing why this episode belongs here."
//   />
//
// The episode is evidence, not the article's answer and not a second
// CTA — place it at the point of proof (after a claim, before the how).
// See PODCAST_INTEGRATION_STRATEGY.md (§1a, §8) and PODCAST_EPISODE_MAP.md.
import { getCollection } from 'astro:content';

interface Props {
  id: string;
  intro?: string;
}

const { id, intro } = Astro.props;

const episodes = await getCollection('episodes');
const entry = episodes.find((e) => e.id === id);
const ep = entry?.data;

function formatDate(raw?: string): string {
  if (!raw) return '';
  const d = new Date(raw);
  return isNaN(d.getTime())
    ? ''
    : d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}

const date = formatDate(ep?.pubDate);

// Keep the blurb to one short paragraph: the opening sentence(s) up to
// ~220 chars, ended cleanly on a sentence boundary rather than a
// mid-word chop.
const SUMMARY_MAX = 220;
const rawSummary = ep?.description ?? '';

function toOneParagraph(text: string): string {
  if (!text || text.length <= SUMMARY_MAX) return text;
  const window = text.slice(0, SUMMARY_MAX);
  const lastStop = Math.max(
    window.lastIndexOf('. '),
    window.lastIndexOf('! '),
    window.lastIndexOf('? '),
  );
  if (lastStop > SUMMARY_MAX * 0.5) return window.slice(0, lastStop + 1).trim();
  return window.replace(/\s+\S*$/, '').trim() + '…';
}

const summary = toOneParagraph(rawSummary);

const APPLE_SHOW = 'https://podcasts.apple.com/us/podcast/h3x/id1562206185';
const SPOTIFY_SHOW = 'https://open.spotify.com/show/2NNDtnQaRLeqRU2N3LVayR';
const YOUTUBE_PLAYLIST =
  'https://www.youtube.com/playlist?list=PL1YoQQDZVDO68yuhJzvcu11DQxF3H_y4O';
---

{
  ep && (
    <aside class="podcast-embed" aria-label={`H3X podcast episode: ${ep.title}`}>
      <p class="podcast-embed__label">
        H3X Podcast{date && <span class="podcast-embed__date"> · {date}</span>}
      </p>
      <h3 class="podcast-embed__title">{ep.title}</h3>

      {intro && <p class="podcast-embed__intro">{intro}</p>}

      {ep.audioUrl && (
        <div class="pod-player" data-pod-player>
          <audio class="pod-player__audio" preload="none" src={ep.audioUrl} />

          <div class="pod-player__transport">
            <button
              type="button"
              class="pod-player__btn pod-player__skip"
              data-skip="-15"
              aria-label="Skip back 15 seconds"
            >
              <svg viewBox="0 0 24 24" width="60" height="60" aria-hidden="true">
                <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-dasharray="42 8" stroke-linecap="round" transform="rotate(-90 12 12)" />
                <path d="M12 2.6 8.7 4.4 12 6.2Z" fill="currentColor" />
                <text x="12" y="15.3" text-anchor="middle" font-size="7.2" font-weight="700" fill="currentColor">15</text>
              </svg>
            </button>

            <button
              type="button"
              class="pod-player__btn pod-player__play"
              data-play
              aria-label="Play"
              aria-pressed="false"
            >
              <svg data-icon-play class="pod-player__icon" viewBox="0 0 24 24" width="72" height="72" aria-hidden="true">
                <path d="M8 5.4 19 12 8 18.6Z" fill="currentColor" />
              </svg>
              <svg data-icon-pause class="pod-player__icon is-hidden" viewBox="0 0 24 24" width="72" height="72" aria-hidden="true">
                <rect x="7" y="5.4" width="3.4" height="13.2" rx="1.3" fill="currentColor" />
                <rect x="13.6" y="5.4" width="3.4" height="13.2" rx="1.3" fill="currentColor" />
              </svg>
            </button>

            <button
              type="button"
              class="pod-player__btn pod-player__skip"
              data-skip="30"
              aria-label="Skip forward 30 seconds"
            >
              <svg viewBox="0 0 24 24" width="60" height="60" aria-hidden="true">
                <g transform="translate(24 0) scale(-1 1)">
                  <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-dasharray="42 8" stroke-linecap="round" transform="rotate(-90 12 12)" />
                  <path d="M12 2.6 8.7 4.4 12 6.2Z" fill="currentColor" />
                </g>
                <text x="12" y="15.3" text-anchor="middle" font-size="7.2" font-weight="700" fill="currentColor">30</text>
              </svg>
            </button>
          </div>

          <div class="pod-player__scrub">
            <span class="pod-player__time" data-current>0:00</span>
            <input
              class="pod-player__range"
              type="range"
              min="0"
              max="100"
              step="0.1"
              value="0"
              aria-label="Seek"
              data-range
            />
            <span class="pod-player__time pod-player__time--end" data-remaining>0:00</span>
          </div>

          <div class="pod-player__footer">
            <button type="button" class="pod-player__speed" data-speed aria-label="Playback speed">
              1×
            </button>
          </div>
        </div>
      )}

      {summary && <p class="podcast-embed__summary">{summary}</p>}

      <div class="podcast-embed__platforms">
        <a
          class="podcast-embed__platform"
          href={SPOTIFY_SHOW}
          target="_blank"
          rel="noopener"
          aria-label="Listen on Spotify"
        >
          <img src="/images/podcast/spotify-button.webp" alt="Listen on Spotify" width="275" height="86" loading="lazy" />
        </a>
        <a
          class="podcast-embed__platform"
          href={APPLE_SHOW}
          target="_blank"
          rel="noopener"
          aria-label="Listen on Apple Podcasts"
        >
          <img src="/images/podcast/apple-podcasts-button.webp" alt="Listen on Apple Podcasts" width="384" height="86" loading="lazy" />
        </a>
        <a
          class="podcast-embed__platform"
          href={YOUTUBE_PLAYLIST}
          target="_blank"
          rel="noopener"
          aria-label="Watch on YouTube"
        >
          <img src="/images/podcast/youtube-button.webp" alt="Watch on YouTube" width="275" height="86" loading="lazy" />
        </a>
      </div>
    </aside>
  )
}

<script is:inline>
  // Progressive enhancement for every PodcastEmbed on the page. The
  // native <audio> is the source of truth; these controls drive it. No
  // JS → the audio element still exists and the "Listen on…" links work.
  // is:inline (plain JS, run-once guard) because Astro does not hoist a
  // component's bundled <script> when the component is rendered via MDX.
  (function () {
    if (window.__h3xPodPlayer) return;
    window.__h3xPodPlayer = true;

    function fmt(t) {
      if (!isFinite(t) || t < 0) t = 0;
      var m = Math.floor(t / 60);
      var s = Math.floor(t % 60);
      return m + ':' + String(s).padStart(2, '0');
    }

    var SPEEDS = [1, 1.25, 1.5, 2];

    function initPlayer(root) {
      var audio = root.querySelector('audio');
      var playBtn = root.querySelector('[data-play]');
      var iconPlay = root.querySelector('[data-icon-play]');
      var iconPause = root.querySelector('[data-icon-pause]');
      var range = root.querySelector('[data-range]');
      var cur = root.querySelector('[data-current]');
      var rem = root.querySelector('[data-remaining]');
      var speedBtn = root.querySelector('[data-speed]');
      if (!audio || !playBtn || !range || !cur || !rem) return;

      var speedIndex = 0;

      function paint() {
        var dur = audio.duration || 0;
        var pct = dur ? (audio.currentTime / dur) * 100 : 0;
        range.value = String(pct);
        range.style.setProperty('--pct', pct + '%');
        cur.textContent = fmt(audio.currentTime);
        rem.textContent = '-' + fmt(Math.max(0, dur - audio.currentTime));
      }

      playBtn.addEventListener('click', function () {
        if (audio.paused) audio.play();
        else audio.pause();
      });
      audio.addEventListener('play', function () {
        if (iconPlay) iconPlay.classList.add('is-hidden');
        if (iconPause) iconPause.classList.remove('is-hidden');
        playBtn.setAttribute('aria-label', 'Pause');
        playBtn.setAttribute('aria-pressed', 'true');
      });
      audio.addEventListener('pause', function () {
        if (iconPlay) iconPlay.classList.remove('is-hidden');
        if (iconPause) iconPause.classList.add('is-hidden');
        playBtn.setAttribute('aria-label', 'Play');
        playBtn.setAttribute('aria-pressed', 'false');
      });
      audio.addEventListener('ended', function () {
        audio.currentTime = 0;
      });
      audio.addEventListener('loadedmetadata', paint);
      audio.addEventListener('timeupdate', paint);

      root.querySelectorAll('[data-skip]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var delta = parseFloat(btn.getAttribute('data-skip') || '0');
          var dur = audio.duration || Number.MAX_SAFE_INTEGER;
          audio.currentTime = Math.max(0, Math.min(dur, audio.currentTime + delta));
        });
      });

      range.addEventListener('input', function () {
        var dur = audio.duration || 0;
        if (dur) audio.currentTime = (parseFloat(range.value) / 100) * dur;
        range.style.setProperty('--pct', range.value + '%');
      });

      if (speedBtn) {
        speedBtn.addEventListener('click', function () {
          speedIndex = (speedIndex + 1) % SPEEDS.length;
          audio.playbackRate = SPEEDS[speedIndex];
          speedBtn.textContent = SPEEDS[speedIndex] + '×';
        });
      }

      paint();
    }

    function initAll() {
      document.querySelectorAll('[data-pod-player]').forEach(initPlayer);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();
</script>
