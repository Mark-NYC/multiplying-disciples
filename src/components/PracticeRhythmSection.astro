---
// PracticeRhythmSection — the coaching interruption after Share Jesus.
// This is where coaching + community first appear. Framed around the
// visitor's need to practice, not around explaining CoVo as an org.
export interface RhythmCta {
  label: string;
  href: string;
  external?: boolean;
  ctaLevel?: string;
  ctaType?: string;
  destinationSite?: string;
}

interface Props {
  heading: string;
  copy: string;
  rhythm: string[];
  ctas: RhythmCta[];
}

const { heading, copy, rhythm, ctas } = Astro.props;
---

<section class="rhythm-section" aria-labelledby="rhythm-heading">
  <div class="rhythm-section__inner">
    <h2 id="rhythm-heading">{heading}</h2>
    <p class="rhythm-section__copy">{copy}</p>
    <ol class="rhythm-section__steps" aria-label="The practice rhythm">
      {rhythm.map((step) => <li>{step}</li>)}
    </ol>
    <div class="rhythm-section__ctas">
      {ctas.map((cta) => (
        <a
          class="button button--secondary-dark"
          href={cta.href}
          target={cta.external ? '_blank' : undefined}
          rel={cta.external ? 'noopener' : undefined}
          data-ecosystem-cta
          data-cta-level={cta.ctaLevel}
          data-cta-type={cta.ctaType}
          data-destination-site={cta.destinationSite}
        >
          {cta.label}{cta.external && <span class="rhythm-section__ext" aria-hidden="true">&#8599;</span>}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .rhythm-section {
    padding: 4.5rem 1.5rem;
    text-align: center;
    background: var(--color-primary);
    border-top: 3px solid var(--color-gold);
    border-bottom: 3px solid var(--color-gold);
  }
  .rhythm-section__inner { max-width: 40rem; margin: 0 auto; }
  .rhythm-section h2 {
    margin: 0 0 1rem;
    font-size: var(--fs-h2);
    line-height: 1.15;
    color: var(--color-primary-text);
  }
  .rhythm-section__copy {
    margin: 0 auto 2rem;
    max-width: 34rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: rgba(247, 243, 234, 0.9);
  }
  .rhythm-section__steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 2.25rem;
    padding: 0;
    list-style: none;
  }
  .rhythm-section__steps li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(247, 243, 234, 0.28);
    border-radius: var(--radius-pill);
    font-size: var(--fs-support);
    font-weight: 600;
    color: var(--color-primary-text);
  }
  .rhythm-section__steps li:not(:last-child)::after {
    content: '\2192';
    margin-left: 0.4rem;
    color: var(--color-gold);
  }
  .rhythm-section__ctas {
    display: flex;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .rhythm-section__ext { margin-left: 0.35rem; font-size: 0.85em; }

  @media (max-width: 560px) {
    .rhythm-section { padding: 3.5rem 1.25rem; }
    .rhythm-section__steps li:not(:last-child)::after { display: none; }
    .rhythm-section__ctas .button { width: 100%; max-width: 22rem; text-align: center; }
  }
</style>
