---
// "This Is For You If..." section — sits directly below the hero.
// Two rows of pill-shaped labels drift slowly in opposite directions so a
// visitor can scan for a phrase that matches their own situation within
// the first few seconds. Pure CSS: each row's list is duplicated once so
// the transform-based scroll can loop without a visible seam, no JS.
//
// Reusable: pass your own rowA/rowB label sets (with an optional rare
// `accent` of 'green' | 'gold') to reuse this pattern elsewhere.

interface Pill {
  label: string;
  accent?: 'green' | 'gold';
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  rowA?: Pill[];
  rowB?: Pill[];
}

const {
  eyebrow,
  heading = 'This is for you if you are&hellip;',
  subheading = 'Ordinary believers. Practical tools. Real obedience.',
  rowA = [
    { label: 'ready to share the gospel' },
    { label: 'wanting simple tools' },
    { label: 'tired of only learning theory' },
    { label: 'looking for live practice' },
    { label: 'discipling someone already' },
    { label: 'helping your church make disciples' },
    { label: 'a pastor equipping others' },
    { label: 'a church planter' },
    { label: 'a marketplace disciple' },
    { label: 'starting where you are' },
    { label: 'wanting coaching, not just content', accent: 'gold' },
  ],
  rowB = [
    { label: 'gathering people around Scripture' },
    { label: 'taking one faithful next step', accent: 'green' },
    { label: 'helping ordinary believers obey Jesus' },
    { label: 'learning with others' },
    { label: 'looking for community' },
    { label: 'wanting practical disciple-making' },
    { label: 'sharing your faith at work' },
    { label: 'leading a Discovery Bible Study' },
    { label: 'investing in one person' },
    { label: 'praying for your oikos' },
  ],
} = Astro.props;

const pillClass = (pill: Pill) =>
  ['pill', pill.accent === 'green' && 'pill--accent-green', pill.accent === 'gold' && 'pill--accent-gold']
    .filter(Boolean)
    .join(' ');
---

<section class="for-you" id="ch-for-you" aria-labelledby="for-you-heading">
  <div class="for-you__inner">
    {eyebrow && <p class="eyebrow eyebrow--gold-text">{eyebrow}</p>}
    <h2 id="for-you-heading" set:html={heading} />
    <p class="for-you__subhead">{subheading}</p>
  </div>

  <div class="for-you__rows">
    <div class="for-you__row for-you__row--left">
      <ul class="for-you__track">
        {rowA.map((pill) => <li class={pillClass(pill)}>{pill.label}</li>)}
        {rowA.map((pill) => <li class={pillClass(pill)} aria-hidden="true">{pill.label}</li>)}
      </ul>
    </div>

    <div class="for-you__row for-you__row--right">
      <ul class="for-you__track">
        {rowB.map((pill) => <li class={pillClass(pill)}>{pill.label}</li>)}
        {rowB.map((pill) => <li class={pillClass(pill)} aria-hidden="true">{pill.label}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .for-you {
    padding: 4rem 0 4.5rem;
    background: var(--color-surface);
    text-align: center;
    overflow: hidden;
  }

  .for-you__inner {
    max-width: var(--site-max-width);
    margin: 0 auto 2.75rem;
    padding: 0 1.5rem;
  }

  .for-you__inner h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 3.2vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .for-you__subhead {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  .for-you__rows {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Each row masks its own overflow and fades pills gently at the edges
     rather than clipping them mid-shape. */
  .for-you__row {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 3rem, black calc(100% - 3rem), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 3rem, black calc(100% - 3rem), transparent 100%);
  }

  /* The track holds two identical copies of the row's pills back to back;
     animating exactly half its width and looping is what makes the
     scroll read as endless with no jump. GPU-accelerated via transform;
     nothing else in the layout shifts. */
  .for-you__track {
    display: inline-flex;
    width: max-content;
    margin: 0;
    padding: 0 1.5rem;
    list-style: none;
    gap: 0.75rem;
    will-change: transform;
  }

  .for-you__row--left .for-you__track {
    animation: for-you-scroll-left 70s linear infinite;
  }

  .for-you__row--right .for-you__track {
    animation: for-you-scroll-right 78s linear infinite;
  }

  /* Pause on hover — lets a visitor stop the drift to read a pill without
     any change in speed or direction beforehand. */
  .for-you__row:hover .for-you__track {
    animation-play-state: paused;
  }

  @keyframes for-you-scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes for-you-scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Matches the specificity of the row-specific animation rules above
     (two classes each) so this actually wins the cascade instead of
     losing to them. */
  @media (prefers-reduced-motion: reduce) {
    .for-you__row--left .for-you__track,
    .for-you__row--right .for-you__track {
      animation: none;
    }
  }

  .pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    padding: 0.65rem 1.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    border: 1px solid rgba(79, 157, 105, 0.35);
    color: var(--color-ink);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.2;
    transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .pill:hover {
    background: #efe6d3;
    box-shadow: 0 2px 8px rgba(31, 37, 35, 0.12);
    transform: translateY(-1px);
  }

  .pill--accent-green {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #ffffff;
  }

  .pill--accent-green:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .pill--accent-gold {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-ink);
  }

  .pill--accent-gold:hover {
    background: #c99433;
    border-color: #c99433;
  }

  @media (max-width: 700px) {
    .for-you {
      padding: 3rem 0 3.5rem;
    }

    .for-you__inner {
      margin-bottom: 2rem;
    }

    .for-you__row {
      -webkit-mask-image: linear-gradient(to right, transparent 0, black 1.5rem, black calc(100% - 1.5rem), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, black 1.5rem, black calc(100% - 1.5rem), transparent 100%);
    }

    .for-you__track {
      padding: 0 1rem;
      gap: 0.6rem;
    }

    .pill {
      padding: 0.55rem 1.1rem;
      font-size: 0.85rem;
    }
  }
</style>
