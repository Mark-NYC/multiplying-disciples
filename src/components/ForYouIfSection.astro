---
// "This Is For You If..." section — sits directly below the hero.
// Two rows of pill-shaped labels drift slowly in opposite directions so a
// visitor can scan for a phrase that matches their own situation within
// the first few seconds. Pure CSS: each row's list is duplicated once so
// the transform-based scroll can loop without a visible seam, no JS.
//
// Reusable: pass your own rowA/rowB label sets to reuse this pattern
// elsewhere. Every pill carries equal visual weight by design — no
// per-pill emphasis — so a visitor reads several rather than fixating
// on one.
import CovoMark from './CovoMark.astro';

interface Props {
  eyebrow?: string;
  headingLine1?: string;
  headingLine2?: string;
  rowA?: string[];
  rowB?: string[];
}

const {
  eyebrow,
  // Split in two so a second line can be supplied for a longer
  // heading; left empty, the heading renders as one line with no
  // trailing break (see the conditional in the template below).
  headingLine1 = 'This is for you if…',
  headingLine2 = '',
  rowA = [
    'ready to share your faith',
    'leading a Discovery Bible Study',
    'discipling one person',
    'planting a church',
  ],
  rowB = [
    'sharing Jesus at work',
    'tired of learning without practicing',
    'taking your faithful next step',
    'helping ordinary believers make disciples',
  ],
} = Astro.props;
---

<section class="for-you" id="ch-for-you" aria-labelledby="for-you-heading">
  <div class="for-you__inner">
    <CovoMark />
    {eyebrow && <p class="eyebrow eyebrow--gold-text">{eyebrow}</p>}
    <h2 id="for-you-heading">
      {headingLine1}
      {headingLine2 && (
        <>
          <br class="for-you__break" /> {headingLine2}
        </>
      )}
    </h2>
  </div>

  <div class="for-you__rows">
    <div class="for-you__row for-you__row--left">
      <ul class="for-you__track">
        {rowA.map((label) => <li class="pill">{label}</li>)}
        {rowA.map((label) => <li class="pill" aria-hidden="true">{label}</li>)}
      </ul>
    </div>

    <div class="for-you__row for-you__row--right">
      <ul class="for-you__track">
        {rowB.map((label) => <li class="pill">{label}</li>)}
        {rowB.map((label) => <li class="pill" aria-hidden="true">{label}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .for-you {
    padding: 6.5rem 0 7rem;
    background: var(--color-surface);
    text-align: center;
    overflow: hidden;
  }

  .for-you__inner {
    max-width: var(--site-max-width);
    margin: 0 auto 3.5rem;
    padding: 0 1.5rem;
  }

  /* CovoMark renders its own scoped size/inline-alignment styles, so
     they're overridden here rather than via a class passed into the
     component (see the same pattern in ToolCTA.astro). Centered above
     the heading, larger than its usual inline-badge size. */
  .for-you__inner :global(.covo-mark) {
    display: block;
    width: clamp(3.25rem, 6vw, 4.25rem);
    height: clamp(3.25rem, 6vw, 4.25rem);
    margin: 0 auto 1.5rem;
  }

  .for-you__inner h2 {
    margin: 0;
    font-size: var(--fs-h2);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  /* Desktop reads as one line; the break only activates on mobile
     (see the max-width: 700px block below). */
  .for-you__break {
    display: none;
  }

  .for-you__rows {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  /* Each row masks its own overflow and fades pills gently at the edges
     rather than clipping them mid-shape. */
  .for-you__row {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent 0, black 3rem, black calc(100% - 3rem), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, black 3rem, black calc(100% - 3rem), transparent 100%);
  }

  /* The track holds two identical copies of the row's pills back to back;
     animating exactly half its width and looping is what makes the
     scroll read as endless with no jump. GPU-accelerated via transform;
     nothing else in the layout shifts. Pills may wrap to two lines, so
     items are vertically centered rather than stretched to a uniform
     height. */
  .for-you__track {
    display: inline-flex;
    align-items: center;
    width: max-content;
    margin: 0;
    padding: 0 1.5rem;
    list-style: none;
    gap: 1.1rem;
    will-change: transform;
  }

  /* ~10% slower than the previous pass (70s/78s) so each pill sits on
     screen longer before drifting past. */
  .for-you__row--left .for-you__track {
    animation: for-you-scroll-left 77s linear infinite;
  }

  .for-you__row--right .for-you__track {
    animation: for-you-scroll-right 86s linear infinite;
  }

  /* Pause on hover — lets a visitor stop the drift to read a pill without
     any change in speed or direction beforehand. */
  .for-you__row:hover .for-you__track {
    animation-play-state: paused;
  }

  @keyframes for-you-scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes for-you-scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Matches the specificity of the row-specific animation rules above
     (two classes each) so this actually wins the cascade instead of
     losing to them. */
  @media (prefers-reduced-motion: reduce) {
    .for-you__row--left .for-you__track,
    .for-you__row--right .for-you__track {
      animation: none;
    }
  }

  /* Every pill carries the same visual weight — Warm Paper on Soft Sage,
     a quiet light-green rule, Deep Ink text. Long labels wrap to a
     second line instead of truncating or forcing a wide single line. */
  .pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: normal;
    min-width: 10rem;
    max-width: 18rem;
    /* ~9% taller than the previous pass via extra vertical padding. */
    padding: 0.93rem 1.9rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    border: 1px solid rgba(79, 157, 105, 0.35);
    color: var(--color-ink);
    font-size: var(--fs-support);
    font-weight: 600;
    line-height: 1.35;
    transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .pill:hover {
    background: #efe6d3;
    box-shadow: 0 2px 8px rgba(31, 37, 35, 0.12);
    transform: translateY(-1px);
  }

  @media (max-width: 700px) {
    .for-you {
      /* Extra top room so the section doesn't feel crowded by the hero
         photo above it; bottom padding is unchanged. */
      padding: 6.5rem 0 5.5rem;
    }

    .for-you__inner {
      margin-bottom: 2.5rem;
    }

    .for-you__break {
      display: inline;
    }

    .for-you__rows {
      gap: 1.25rem;
    }

    .for-you__row {
      -webkit-mask-image: linear-gradient(to right, transparent 0, black 1.5rem, black calc(100% - 1.5rem), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, black 1.5rem, black calc(100% - 1.5rem), transparent 100%);
    }

    .for-you__track {
      padding: 0 1rem;
      gap: 0.85rem;
    }

    .pill {
      min-width: 9rem;
      max-width: 15.5rem;
      padding: 0.78rem 1.45rem;
      font-size: var(--fs-support);
    }
  }
</style>
