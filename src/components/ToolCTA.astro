---
import { getCollection } from 'astro:content';
import CovoMark from './CovoMark.astro';

interface NextStep {
  label: string;
  href: string;
}

interface Props {
  // Tool names as written in article/hub frontmatter (e.g. "3 Circles"),
  // matched case-insensitively against the tools collection's `title`.
  tools?: string[];
  nextStep?: NextStep;
}

const { tools = [], nextStep } = Astro.props;

// Recognize CoVo Multipliers as the destination so the next-step button
// carries the same "man" mark and ecosystem tracking used elsewhere on
// the site, without every hub author having to remember to add it.
const nextStepIsCovo = nextStep?.href.includes('covomultipliers.com') ?? false;

const allTools = tools.length ? await getCollection('tools') : [];

const items = tools.map((name) => {
  const match = allTools.find((entry) => entry.data.title.toLowerCase() === name.toLowerCase());
  return {
    label: name,
    href: match ? (match.data.external_url ?? match.data.slug) : undefined,
    pending: !match,
  };
});
---

{
  (items.length > 0 || nextStep) && (
    <aside class="tool-cta" aria-label="Related tools and next step">
      {items.length > 0 && (
        <>
          <h2>Tools for this</h2>
          <ul>
            {items.map((item) =>
              item.href ? (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ) : (
                <li>
                  {item.label} <span class="tool-cta__pending">(coming soon)</span>
                </li>
              ),
            )}
          </ul>
        </>
      )}
      {nextStep && (
        <a
          class="tool-cta__button"
          href={nextStep.href}
          data-ecosystem-cta={nextStepIsCovo ? true : undefined}
          data-cta-level={nextStepIsCovo ? 'level_3' : undefined}
          data-cta-type={nextStepIsCovo ? 'covo_next_step' : undefined}
          data-destination-site={nextStepIsCovo ? 'covo' : undefined}
        >
          {nextStepIsCovo && <CovoMark />}
          {nextStep.label}
        </a>
      )}
    </aside>
  )
}

<style>
  .tool-cta {
    margin: 2.5rem 0;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .tool-cta h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0 0 0.85rem;
  }

  .tool-cta ul {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
  }

  .tool-cta__pending {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .tool-cta__button {
    display: inline-block;
    padding: 0.7rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-primary-text);
    text-decoration: none;
    border-radius: var(--radius-button);
    font-weight: 600;
  }

  .tool-cta__button:hover {
    background: var(--color-primary-hover);
  }

  /* CovoMark is a dark-line-on-transparent icon; invert it to stay
     visible against the button's solid accent-color background, and
     shrink it to fit a single-line button rather than the heading-sized
     default. */
  .tool-cta__button :global(.covo-mark) {
    width: 1.15rem;
    height: 1.15rem;
    margin-right: 0.35rem;
    filter: brightness(0) invert(1);
  }
</style>
