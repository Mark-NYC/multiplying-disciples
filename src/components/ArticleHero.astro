---
// Field Manual article hero — category, headline, one-sentence
// subheading, meta, then a hero image with an editorial caption below
// it. Deliberately never overlays text on the photo (unlike the
// homepage hero): copy reads on plain white first, the photo is a
// separate, later beat.
interface Props {
  category: string;
  title: string;
  subheading?: string;
  date?: Date;
  image?: string;
  imageAlt?: string;
  imageCaption?: string;
}

const { category, title, subheading, date, image, imageAlt, imageCaption } = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<header class="fm-hero">
  <p class="fm-hero__category eyebrow eyebrow--gold-text">{category}</p>
  <h1 class="fm-hero__headline">{title}</h1>
  {subheading && <p class="fm-hero__subhead">{subheading}</p>}
  {date && <p class="fm-hero__meta">{dateFormatter.format(date)}</p>}
</header>

{
  image && (
    <figure class="fm-hero__image-wrap">
      <img class="fm-hero__image" src={image} alt={imageAlt ?? ''} loading="eager" />
      {imageCaption && <figcaption class="fm-hero__caption">{imageCaption}</figcaption>}
    </figure>
  )
}
