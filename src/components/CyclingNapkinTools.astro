---
// CyclingNapkinTools — the reusable looping "field tools on a napkin"
// stage used by all three moves. One napkin shows one tool at a time and
// cycles through two tools on a ~10s loop:
//
//   fresh flat napkin -> tool 1 revealed & demonstrated -> napkin crumples
//   -> fresh flat napkin -> tool 2 revealed & demonstrated -> crumples -> loop
//
// The tool SVGs are inlined (namespaced per instance via loadInlineSvg) so
// their internal named groups can be revealed one at a time. Small overlay
// layers add the marker-style annotations the artwork itself doesn't carry
// (circles around FOLLOW/FISH, the animated Conversation Box names, etc.).
//
// Below the napkin: keyboard-accessible tool tabs (manual controls) and the
// two stable CTA buttons; the CTA matching the tool currently on the napkin
// is highlighted. The loop only runs while the section is meaningfully in
// view, pauses when the tab is hidden or the stage is hovered/focused, and
// is replaced by a static, tab-switchable view under prefers-reduced-motion.
import fs from 'node:fs';
import path from 'node:path';
import { loadInlineSvg } from '../lib/inline-svg.mjs';

export interface ToolCta {
  label: string;
  href: string;
  external?: boolean;
  primary?: boolean;
  ctaLevel?: string;
  ctaType?: string;
  destinationSite?: string;
}
export interface CyclingTool {
  key: string;
  name: string;
  animType: 'follow-fish' | 'conversation' | 'three-circles' | 'testimony' | 'three-thirds' | 'church-waffle';
  svgSrc?: string;
  ariaLabel: string;
  cta: ToolCta;
}
interface Props {
  id: string;
  tools: CyclingTool[];
  flatSrc?: string;
  crumpledSrc?: string;
}

const {
  id,
  tools,
  flatSrc = '/tools-images/blank-napkin.webp',
  crumpledSrc = '/tools-images/crumpled-napkin.webp',
} = Astro.props;

// Build-time: is the crumpled napkin present? If not, the stage falls back
// to a CSS-only crush of the flat napkin so the loop still reads as
// "discarded -> fresh" without a broken image.
const hasCrumpled = (() => {
  try {
    return fs.existsSync(path.join(process.cwd(), 'public', crumpledSrc.replace(/^\//, '')));
  } catch {
    return false;
  }
})();

const primaryIndex = Math.max(0, tools.findIndex((t) => t.cta.primary));

// Church Waffle isolation: the supplied SVG draws one merged `source-artwork`
// path revealed through region clips, so the loose circle cutout leaks corner
// icon/grid bits and every full-cell icon clip catches the circle arc + ~1px
// grid slivers. We (a) inset each icon clip rect so icons never carry the grid
// lines, and (b) inject a clean vector circle that the animation reveals for
// the circle-only stage instead of the leaky clipped `outer-circle` group.
function isolateWaffle(svg: string): string {
  const M = 6; // clip inset (px) — drops grid-line slivers at cell edges
  let out = svg.replace(
    /<rect x="([\d.]+)" y="([\d.]+)" width="([\d.]+)" height="([\d.]+)"\s*\/>/g,
    (_m, x, y, w, h) =>
      `<rect x="${+x + M}" y="${+y + M}" width="${Math.max(0, +w - 2 * M)}" height="${Math.max(0, +h - 2 * M)}"/>`
  );
  // Confine everything the merged artwork draws (grid + icons) to an inner
  // disc so no stroke reaches the rim — the grid/icon clips otherwise catch
  // slivers of the circle arc where they cross it. The clean vector circle is
  // drawn on top, outside this wrapper, so it owns the rim exclusively.
  out = out.replace(
    '</defs>',
    '<clipPath id="cw-inner-disc"><circle cx="325" cy="325" r="298"/></clipPath></defs><g clip-path="url(#cw-inner-disc)">'
  );
  const cleanCircle =
    '<circle class="cw-clean-circle" cx="325" cy="325" r="301" fill="none" ' +
    'stroke="#1F2523" stroke-width="3.4" stroke-linejoin="round" pathLength="1"/>';
  return out.replace('</svg>', `</g>${cleanCircle}</svg>`);
}

// Inline + namespace each real tool SVG. Placeholder tools (3 Circles) get
// a restrained inline schematic instead — swap in a real /tools-images svg
// later by giving that tool an svgSrc.
const inlined = tools.map((t) => {
  if (!t.svgSrc) return '';
  const svg = loadInlineSvg(t.svgSrc, `${id}-${t.key}`);
  return t.animType === 'church-waffle' ? isolateWaffle(svg) : svg;
});

// CTA render order is stable (primary first); tabs follow napkin sequence.
const ctaOrder = tools
  .map((t, i) => ({ t, i }))
  .sort((a, b) => (b.t.cta.primary ? 1 : 0) - (a.t.cta.primary ? 1 : 0));
---

<div class="cnt" data-cnt id={`${id}-stage`} data-primary={primaryIndex} data-has-crumpled={hasCrumpled ? '1' : '0'}>
  <div class="cnt__viewport">
    <div class="cnt__stage" data-state="flat">
      <div class="cnt__paper">
        <img class="cnt__napkin" src={flatSrc} width="800" height="800" alt="" aria-hidden="true" loading="lazy" decoding="async" />
        {tools.map((t, i) => (
          <div
            class:list={['cnt__tool', `cnt__tool--${t.animType}`, { 'is-active': i === 0 }]}
            data-index={i}
            data-tool-name={t.name}
            id={`${id}-panel-${i}`}
            role="tabpanel"
            aria-labelledby={`${id}-tab-${i}`}
          >
            <div class="cnt__art">
              {inlined[i] ? (
                <Fragment set:html={inlined[i]} />
              ) : (
                /* 3 Circles — restrained placeholder schematic (no approved SVG yet). */
                <svg class="cnt__placeholder-svg" viewBox="0 0 400 320" role="img" aria-label={t.ariaLabel}>
                  <g class="tc-emph"><circle class="tc-emph-ring" cx="266" cy="228" r="70" pathLength="1" /></g>
                  <g class="tc-circle tc-c1"><circle cx="200" cy="92" r="66" pathLength="1" /><text x="200" y="97">God&#8217;s design</text></g>
                  <g class="tc-circle tc-c2"><circle cx="134" cy="228" r="66" pathLength="1" /><text x="134" y="233">Brokenness</text></g>
                  <g class="tc-circle tc-c3"><circle cx="266" cy="228" r="66" pathLength="1" /><text x="266" y="233">Gospel</text></g>
                  <g class="tc-arrow"><path d="M168 150 C150 172 140 186 132 204" pathLength="1" /><path d="M132 204 l7 -12 M132 204 l12 4" pathLength="1" /></g>
                  <g class="tc-arrow"><path d="M198 292 C215 300 245 300 262 293" pathLength="1" /><path d="M262 293 l-13 -1 M262 293 l-6 11" pathLength="1" /></g>
                  <g class="tc-arrow"><path d="M300 204 C292 186 282 172 264 150" pathLength="1" /><path d="M264 150 l14 3 M264 150 l7 12" pathLength="1" /></g>
                  <text class="tc-tag" x="200" y="312">3 Circles &middot; simple placeholder</text>
                </svg>
              )}

              {/* --- Annotation overlays (separate layers; never edit the artwork) --- */}
              {t.animType === 'follow-fish' && (
                <svg class="cnt__anno" viewBox="20 12 760 608" aria-hidden="true">
                  <path class="anno-mark anno-follow" pathLength="1" d="M40 545 C90 520 250 518 315 542 C355 557 320 600 250 606 C170 612 60 604 45 578 C38 566 40 556 52 548" />
                  <path class="anno-mark anno-fish" pathLength="1" d="M566 548 C620 528 735 532 758 556 C772 571 742 604 668 606 C606 607 560 598 556 578 C554 566 558 556 570 550" />
                  <path class="anno-mark anno-verse" pathLength="1" d="M214 150 C300 142 430 141 520 145 C555 147 585 150 600 154" />
                </svg>
              )}
              {t.animType === 'conversation' && (
                <div class="cnt__names" aria-hidden="true">
                  <span class="cnt-name cnt-name--a">Alex</span>
                  <span class="cnt-name cnt-name--b">Sam</span>
                  <span class="cnt-name cnt-name--c">Jordan</span>
                  <span class="cnt-pulse"></span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <img
        class="cnt__crumpled"
        src={hasCrumpled ? crumpledSrc : flatSrc}
        width="800"
        height="800"
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <p class="cnt__live" aria-live="polite"></p>

  <div class="cnt__tabs" role="tablist" aria-label="Choose a tool">
    {tools.map((t, i) => (
      <button
        type="button"
        class="cnt__tab"
        role="tab"
        id={`${id}-tab-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`${id}-panel-${i}`}
        tabindex={i === 0 ? 0 : -1}
        data-index={i}
      >
        <span class="cnt__tab-dot" aria-hidden="true"></span>{t.name}
      </button>
    ))}
  </div>

  <div class="cnt__ctas">
    {ctaOrder.map(({ t, i }) => (
      <a
        class:list={['button', { 'button--secondary': !t.cta.primary }, 'cnt__cta', { 'is-current': i === 0 }]}
        data-tool={i}
        href={t.cta.href}
        target={t.cta.external ? '_blank' : undefined}
        rel={t.cta.external ? 'noopener' : undefined}
        data-ecosystem-cta
        data-cta-level={t.cta.ctaLevel}
        data-cta-type={t.cta.ctaType}
        data-destination-site={t.cta.destinationSite}
      >
        {t.cta.label}{t.cta.external && <span class="cnt__ext" aria-hidden="true">&#8599;</span>}
      </a>
    ))}
  </div>
</div>

<script>
  // One controller per napkin. CSS owns the look of each phase; this owns
  // the timeline, the play/pause conditions, and the manual tool tabs.
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  type Phase = { t: number; s: 'flat' | 'demo' | 'crumple' | 'reset'; d: number };
  // ~15s two-tool loop (ms): flat .5, demo 5.0, crumple .8 per tool + 2.4 reset.
  // The longer demo lets each tool land and be read before the napkin crumples.
  const SEQ: Phase[] = [
    { t: 0, s: 'flat', d: 500 }, { t: 0, s: 'demo', d: 5000 }, { t: 0, s: 'crumple', d: 800 },
    { t: 1, s: 'flat', d: 500 }, { t: 1, s: 'demo', d: 5000 }, { t: 1, s: 'crumple', d: 800 },
    { t: 0, s: 'reset', d: 2400 },
  ];

  function setupNapkin(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('.cnt__stage')!;
    const viewport = root.querySelector<HTMLElement>('.cnt__viewport')!;
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.cnt__tool'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.cnt__tab'));
    const ctas = Array.from(root.querySelectorAll<HTMLElement>('.cnt__cta'));
    const live = root.querySelector<HTMLElement>('.cnt__live');
    const names = panels.map((p) => p.dataset.toolName || '');
    const primary = Number(root.dataset.primary || 0);

    let idx = 0;
    let timer: number | undefined;
    let running = false;
    let visible = false;
    let paused = false; // hover / focus

    function setActive(t: number) {
      panels.forEach((p, i) => p.classList.toggle('is-active', i === t));
      tabs.forEach((tb, i) => {
        tb.setAttribute('aria-selected', i === t ? 'true' : 'false');
        tb.tabIndex = i === t ? 0 : -1;
      });
      ctas.forEach((c) => c.classList.toggle('is-current', Number(c.dataset.tool) === t));
      if (live) live.textContent = `Showing the ${names[t]} tool`;
    }

    function applyPhase() {
      const ph = SEQ[idx];
      setActive(ph.t);
      stage.dataset.state = ph.s;
      panels.forEach((p, i) => p.classList.toggle('is-playing', i === ph.t && ph.s === 'demo'));
    }

    function tick() {
      idx = (idx + 1) % SEQ.length;
      applyPhase();
      timer = window.setTimeout(tick, SEQ[idx].d);
    }
    function start() {
      if (running || REDUCED) return;
      running = true;
      root.classList.add('is-animating');
      applyPhase();
      timer = window.setTimeout(tick, SEQ[idx].d);
    }
    function stop() {
      running = false;
      if (timer) window.clearTimeout(timer);
    }
    function evaluate() {
      if (visible && !paused && !document.hidden) start();
      else stop();
    }

    // Manual controls: jump to a tool's fresh reveal and keep looping from there.
    function selectTool(i: number, focusTab = false) {
      if (REDUCED) {
        setActive(i);
        stage.dataset.state = 'static';
        if (focusTab) tabs[i].focus();
        return;
      }
      stop();
      idx = SEQ.findIndex((p) => p.t === i && p.s === 'flat');
      applyPhase();
      if (focusTab) tabs[i].focus();
      running = true;
      timer = window.setTimeout(tick, SEQ[idx].d);
    }

    tabs.forEach((tb, i) => {
      tb.addEventListener('click', () => selectTool(i));
      tb.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          selectTool((i + 1) % tabs.length, true);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          selectTool((i - 1 + tabs.length) % tabs.length, true);
        }
      });
    });

    // Pause while the visitor is inspecting (hover / keyboard focus).
    viewport.addEventListener('pointerenter', () => { paused = true; evaluate(); });
    viewport.addEventListener('pointerleave', () => { paused = false; evaluate(); });
    root.addEventListener('focusin', () => { paused = true; evaluate(); });
    root.addEventListener('focusout', () => {
      if (!root.contains(document.activeElement)) { paused = false; evaluate(); }
    });
    document.addEventListener('visibilitychange', evaluate);

    if (REDUCED) {
      // Static, tab-switchable view: show the primary tool fully revealed.
      root.classList.add('is-static');
      stage.dataset.state = 'static';
      setActive(primary);
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible = e.isIntersecting && e.intersectionRatio >= 0.35;
        evaluate();
      },
      { threshold: [0, 0.35, 0.7] }
    );
    io.observe(root);
  }

  document.querySelectorAll<HTMLElement>('[data-cnt]').forEach(setupNapkin);
</script>

<style is:global>
  /* ===== Internal SVG group reveals (targeted by namespaced id suffix) =====
     Groups start hidden; the active tool's `.is-playing` state fades them in
     with a staggered delay so each tool "draws" onto the napkin. Under the
     static / no-JS / reduced-motion views everything is simply visible. */
  .cnt__tool [id$="-before-section"],
  .cnt__tool [id$="-jesus-center"],
  .cnt__tool [id$="-now-section"],
  .cnt__tool [id$="-bottom-question"],
  .cnt__tool [id$="-top-arrows"],
  .cnt__tool [id$="-look-back"],
  .cnt__tool [id$="-look-up"],
  .cnt__tool [id$="-look-forward"],
  .cnt__tool [id$="-outer-circle"],
  .cnt__tool [id$="-grid-lines"],
  .cnt__tool [id*="-icon-"],
  .cnt__tool [id$="-sign"],
  .cnt__tool [id$="-verse"],
  .cnt__tool [id$="-left-arrow"],
  .cnt__tool [id$="-right-arrow"],
  .cnt__tool [id$="-follow"],
  .cnt__tool [id$="-fish"],
  .cnt__tool [id$="-axes"],
  .cnt__tool [id$="-arrowheads"],
  .cnt__tool [id$="-casual"],
  .cnt__tool [id$="-meaningful"],
  .cnt__tool [id$="-discovery"],
  .cnt__tool [id$="-spiritual"],
  .cnt__tool [id$="-gods-design"],
  .cnt__tool [id$="-brokenness"],
  .cnt__tool [id$="-sin-arrow"],
  .cnt__tool [id$="-jesus"],
  .cnt__tool [id$="-repent-believe"],
  .cnt__tool [id$="-recover-pursue"],
  .cnt__tool [id$="-new-creation"],
  .cnt__tool [id$="-connecting-arrows"],
  .cnt__tool [id$="-labels-and-accents"] {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /* Reveal order + stagger, per animation type, while playing. Timings are
     spread across the ~5s demo window so each tool lands before the crumple. */
  /* 15-Second Testimony: left -> centre -> right -> question */
  .cnt__tool.is-playing [id$="-before-section"] { opacity: 1; transition-delay: 0.4s; }
  .cnt__tool.is-playing [id$="-jesus-center"] { opacity: 1; transition-delay: 1.3s; }
  .cnt__tool.is-playing [id$="-now-section"] { opacity: 1; transition-delay: 2.2s; }
  .cnt__tool.is-playing [id$="-bottom-question"] { opacity: 1; transition-delay: 3.2s; animation: cnt-pop 0.7s ease 4.1s 1; }

  /* Three Thirds: arrows -> back -> up -> forward, then reinforce */
  .cnt__tool.is-playing [id$="-top-arrows"] { opacity: 1; transition-delay: 0.4s; }
  .cnt__tool.is-playing [id$="-look-back"] { opacity: 1; transition-delay: 1.2s; animation: cnt-pop 0.6s ease 3.9s 1; }
  .cnt__tool.is-playing [id$="-look-up"] { opacity: 1; transition-delay: 2.1s; animation: cnt-pop 0.6s ease 4.15s 1; }
  .cnt__tool.is-playing [id$="-look-forward"] { opacity: 1; transition-delay: 3.0s; animation: cnt-pop 0.6s ease 4.4s 1; }

  /* Church Waffle: outer circle -> grid -> icons -> clean glow emphasis.
     Opacity keyframes only (never transforms) so the clipped groups can't
     bleed line fragments. For the spotlight the grid and the ten other icons
     fade out, leaving only the two emphasised icons + their glow — the grid
     is never visible during the emphasis. `g[...]` targets the groups, not
     their like-named clipPath defs. */
  /* Circle stage uses a clean injected vector circle (never the leaky
     clipped `outer-circle` group), so the empty circle has zero stray bits. */
  .cnt__tool--church-waffle .cw-clean-circle { opacity: 0; }
  .cnt__tool--church-waffle.is-playing .cw-clean-circle { animation: cw-in 0.6s ease 0.3s both; }
  .cnt__tool--church-waffle.is-playing g[id$="-grid-lines"] { animation: cw-in 0.6s ease 0.8s both, cw-out 0.5s ease 3.7s forwards; }
  /* ten non-emphasis icons: fade in on stagger, fade out for the spotlight */
  .cnt__tool--church-waffle.is-playing g[id$="-icon-01"] { animation: cw-in 0.5s ease 1.2s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-02"] { animation: cw-in 0.5s ease 1.35s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-03"] { animation: cw-in 0.5s ease 1.5s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-04"] { animation: cw-in 0.5s ease 1.65s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-05"] { animation: cw-in 0.5s ease 1.8s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-08"] { animation: cw-in 0.5s ease 2.1s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-09"] { animation: cw-in 0.5s ease 2.25s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-10"] { animation: cw-in 0.5s ease 2.4s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-11"] { animation: cw-in 0.5s ease 2.55s both, cw-out 0.5s ease 3.7s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-12"] { animation: cw-in 0.5s ease 2.7s both, cw-out 0.5s ease 3.7s forwards; }
  /* the two emphasised icons are interior cells (no circle arc); they stay
     while the grid + other icons clear, then glow — a clean icon-only state */
  .cnt__tool--church-waffle.is-playing g[id$="-icon-06"] { animation: cw-in 0.5s ease 1.95s both, cw-glow 1.1s ease 3.95s forwards; }
  .cnt__tool--church-waffle.is-playing g[id$="-icon-07"] { animation: cw-in 0.5s ease 2.1s both, cw-glow 1.1s ease 4.15s forwards; }

  /* Follow and Fish: box -> verse -> arrows -> FOLLOW -> FISH */
  .cnt__tool.is-playing [id$="-sign"] { opacity: 1; transition-delay: 0.4s; }
  .cnt__tool.is-playing [id$="-verse"] { opacity: 1; transition-delay: 1s; }
  .cnt__tool.is-playing [id$="-left-arrow"] { opacity: 1; transition-delay: 1.6s; }
  .cnt__tool.is-playing [id$="-right-arrow"] { opacity: 1; transition-delay: 1.6s; }
  .cnt__tool.is-playing [id$="-follow"] { opacity: 1; transition-delay: 2.3s; }
  .cnt__tool.is-playing [id$="-fish"] { opacity: 1; transition-delay: 3.2s; }

  /* Conversation Box: axes -> heads -> quadrant labels */
  .cnt__tool.is-playing [id$="-axes"] { opacity: 1; transition-delay: 0.4s; }
  .cnt__tool.is-playing [id$="-arrowheads"] { opacity: 1; transition-delay: 0.8s; }
  .cnt__tool.is-playing [id$="-casual"] { opacity: 1; transition-delay: 1.1s; }
  .cnt__tool.is-playing [id$="-meaningful"] { opacity: 1; transition-delay: 1.3s; }
  .cnt__tool.is-playing [id$="-discovery"] { opacity: 1; transition-delay: 1.5s; }
  .cnt__tool.is-playing [id$="-spiritual"] { opacity: 1; transition-delay: 1.7s; }

  /* 3 Circles gospel tool: design -> brokenness -> sin arrow -> Jesus ->
     repent/believe -> recover/pursue -> new creation -> arrows -> labels,
     then a gold glow on the response (repent & believe). Opacity + filter
     only (no transforms on the clipped groups) so nothing bleeds. */
  .cnt__tool--three-circles.is-playing [id$="-gods-design"] { opacity: 1; transition-delay: 0.3s; }
  .cnt__tool--three-circles.is-playing [id$="-brokenness"] { opacity: 1; transition-delay: 0.8s; }
  .cnt__tool--three-circles.is-playing [id$="-sin-arrow"] { opacity: 1; transition-delay: 1.2s; }
  .cnt__tool--three-circles.is-playing [id$="-jesus"] { opacity: 1; transition-delay: 1.7s; }
  .cnt__tool--three-circles.is-playing [id$="-repent-believe"] { opacity: 1; transition-delay: 2.2s; animation: cw-glow 1.2s ease 4.3s forwards; }
  .cnt__tool--three-circles.is-playing [id$="-recover-pursue"] { opacity: 1; transition-delay: 2.6s; }
  .cnt__tool--three-circles.is-playing [id$="-new-creation"] { opacity: 1; transition-delay: 3s; }
  .cnt__tool--three-circles.is-playing [id$="-connecting-arrows"] { opacity: 1; transition-delay: 3.4s; }
  .cnt__tool--three-circles.is-playing [id$="-labels-and-accents"] { opacity: 1; transition-delay: 3.8s; }

  /* Static / no-JS / reduced-motion: everything visible, no motion. */
  .cnt:not(.is-animating) .cnt__tool [id],
  .cnt.is-static .cnt__tool [id],
  .cnt:not(.is-animating) .cnt__tool--three-circles .tc-circle,
  .cnt:not(.is-animating) .cnt__tool--three-circles .tc-arrow,
  .cnt:not(.is-animating) .cnt__tool--three-circles .tc-tag,
  .cnt.is-static .cnt__tool--three-circles .tc-circle,
  .cnt.is-static .cnt__tool--three-circles .tc-arrow,
  .cnt.is-static .cnt__tool--three-circles .tc-tag { opacity: 1 !important; }
  .cnt.is-static .cnt__tool [id] { transition: none !important; animation: none !important; }

  @keyframes cnt-pop {
    0% { transform: scale(1); }
    45% { transform: scale(1.05); }
    100% { transform: scale(1); }
  }
  @keyframes cw-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes cw-out { from { opacity: 1; } to { opacity: 0; } }
  @keyframes cw-glow {
    0% { filter: none; }
