---
// Click-to-play onboarding video. Renders a poster image with a custom
// play button; the <video> element (and its source) is only created in
// the DOM after a visitor clicks, so the MP4 is never requested on
// initial page load. See ecosystem-tracking.js for the same
// window.dataLayer push pattern this reuses for GA4 events.
//
// Deliberately fills whatever box its parent gives it edge-to-edge (no
// self-imposed max-width, aspect-ratio, radius, or shadow) — the caller
// (e.g. the block-grid video cell on the homepage) owns the box shape,
// same as the site's other edge-to-edge block-grid image cells.
interface Props {
  videoSrc: string;
  posterSrc: string;
  posterAlt: string;
}

const { videoSrc, posterSrc, posterAlt } = Astro.props;
---

<div class="intro-video-frame" data-intro-video data-video-src={videoSrc}>
  <img
    src={posterSrc}
    alt={posterAlt}
    class="intro-video-frame__poster"
    width="1145"
    height="1373"
    loading="lazy"
    data-intro-video-poster
  />
  <div class="intro-video-frame__scrim" aria-hidden="true"></div>
  <button
    type="button"
    class="intro-video-frame__trigger"
    aria-label="Play homepage introduction video"
    data-intro-video-trigger
  >
    <span class="intro-video-frame__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
    </span>
  </button>
</div>

<script>
  import { initHomeIntroVideos } from '../lib/intro-video.js';

  initHomeIntroVideos();
</script>

<style>
  .intro-video-frame {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .intro-video-frame__poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Only a light gradient at the base for play-button contrast — kept
     subtle so the photo doesn't read as darkened. */
  .intro-video-frame__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(31, 37, 35, 0.32) 0%, rgba(31, 37, 35, 0) 42%);
    pointer-events: none;
  }

  /* The button covers the entire frame (not just the play icon) so any
     click on the thumbnail starts playback — the visible circle is a
     purely decorative child, positioned via the button's own flex
     centering rather than absolute placement. */
  .intro-video-frame__trigger {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .intro-video-frame__trigger:focus-visible {
    outline: 3px solid var(--color-gold);
    outline-offset: -3px;
  }

  .intro-video-frame__play {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .intro-video-frame__play svg {
    transform: translateX(2px);
  }

  .intro-video-frame__trigger:hover .intro-video-frame__play,
  .intro-video-frame__trigger:focus-visible .intro-video-frame__play {
    background: #ffffff;
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-video-frame__play {
      transition: none;
    }

    .intro-video-frame__trigger:hover .intro-video-frame__play,
    .intro-video-frame__trigger:focus-visible .intro-video-frame__play {
      transform: none;
    }
  }

  /* Once swapped in, the <video> fills the same box; contain (not
     cover) so playback is never cropped, even though the box itself
     (set by the parent) isn't necessarily 9:16 — it may letterbox. */
  .intro-video-frame :global(.intro-video-frame__player) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--color-ink);
  }
</style>
