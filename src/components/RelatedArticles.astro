---
import { getCollection } from 'astro:content';

interface Props {
  // Site-relative paths matching an article's `slug` frontmatter field,
  // e.g. "/testimony-in-the-bible-20-verses-to-ignite-your-faith/".
  paths: string[];
  heading?: string;
}

const { paths, heading = 'Related articles' } = Astro.props;

// Bespoke landing pages (src/pages/*.astro) aren't collection entries,
// so the slug lookup below can't see them — known titles here keep them
// from rendering as "(coming soon)". Add a row when a page graduates
// from the articles collection to a bespoke page.
const BESPOKE_PAGE_TITLES: Record<string, string> = {
  '/kingdom-ministry-training/': 'Kingdom Ministry Training',
  '/stickers/': 'Stickers',
  '/starter-tools/': 'Start Making Disciples',
};

const allArticles = paths.length ? await getCollection('articles') : [];

function humanize(path: string): string {
  const last = path.replace(/^\/|\/$/g, '').split('/').pop() ?? path;
  return last
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
}

const items = paths.map((path) => {
  const match = allArticles.find((entry) => entry.data.slug === path);
  const bespokeTitle = BESPOKE_PAGE_TITLES[path];
  return {
    href: path,
    label: match ? match.data.title : (bespokeTitle ?? humanize(path)),
    pending: !match && !bespokeTitle,
  };
});
---

{
  items.length > 0 && (
    <section class="related-articles" aria-label={heading}>
      <h2>{heading}</h2>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            {item.pending && <span class="related-articles__pending"> (coming soon)</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related-articles {
    margin: 2.5rem 0;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .related-articles h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin: 0 0 0.85rem;
  }

  .related-articles ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .related-articles li {
    margin: 0.35rem 0;
  }

  .related-articles__pending {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>
