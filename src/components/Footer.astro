---
import { SITE } from '../data/site';

const year = new Date().getFullYear();

const quickLinks = [
  { label: 'Vision', href: '/vision/' },
  { label: 'Beliefs & Values', href: '/beliefs-values/' },
  { label: 'Contact Us', href: '/contact-us/' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <p class="site-footer__logo">{SITE.name}</p>
      <p class="site-footer__tagline">{SITE.tagline}</p>
    </div>
    <div class="site-footer__col">
      <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
      <p><a href="/privacy-policy/">Privacy Policy</a></p>
      <p>Find us in {SITE.address}</p>
    </div>
    <div class="site-footer__col">
      <nav aria-label="Footer">
        <ul class="site-footer__nav">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
  <div class="site-footer__bottom">
    <p>&copy; {year} {SITE.name} &middot; Built by Frontier Creative</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
  }

  .site-footer__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .site-footer__col p {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    color: var(--color-footer-text-muted);
  }

  .site-footer__logo {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-footer-text) !important;
  }

  .site-footer__col a {
    color: var(--color-footer-text-muted);
    text-decoration: underline;
  }

  .site-footer__col a:hover {
    color: var(--color-footer-text);
  }

  .site-footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav li {
    margin: 0 0 0.6rem;
  }

  .site-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    text-align: center;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .site-footer__bottom p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-footer-text-muted);
  }
</style>
