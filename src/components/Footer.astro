---
import { SITE } from '../data/site';
import RotatingSeal from './RotatingSeal.astro';

const year = new Date().getFullYear();

// Mirrors the simplified header nav (Labs / Tools / Articles / About)
// plus the two utility links every footer needs. "Labs" points at the
// homepage's lab section (#ch-practice), not straight to Covo — see the
// matching note in navigation.ts.
const quickLinks = [
  { label: 'Labs', href: '/#ch-practice' },
  { label: 'Tools', href: '/starter-tools/' },
  { label: 'Articles', href: '/blog/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact-us/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <p class="site-footer__logo">{SITE.name}</p>
      <p class="site-footer__tagline">{SITE.tagline}</p>
    </div>
    <div class="site-footer__col">
      <nav aria-label="Footer">
        <ul class="site-footer__nav">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="site-footer__seal">
      <RotatingSeal spin={false} size="6.5rem" />
    </div>
  </div>
  <div class="site-footer__bottom">
    <p>&copy; {year} {SITE.name} &middot; Built by Frontier Creative</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    background: var(--color-footer-bg);
    color: var(--color-footer-text);
  }

  .site-footer__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 2.5rem 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .site-footer__seal {
    justify-self: end;
  }

  @media (max-width: 640px) {
    .site-footer__seal {
      justify-self: start;
    }
  }

  .site-footer__col p {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    color: var(--color-footer-text-muted);
  }

  .site-footer__logo {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-footer-text) !important;
  }

  .site-footer__col a {
    color: var(--color-footer-text-muted);
    text-decoration: underline;
  }

  .site-footer__col a:hover {
    color: var(--color-footer-text);
  }

  .site-footer__nav {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__nav li {
    margin: 0 0 0.6rem;
  }

  .site-footer__bottom {
    border-top: 1px solid rgba(247, 243, 234, 0.12);
    text-align: center;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .site-footer__bottom p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-footer-text-muted);
  }
</style>
