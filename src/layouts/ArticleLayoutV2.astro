---
// Field Manual article layout — used only by articles with
// `article_system: field-manual-v2` in frontmatter (see
// src/pages/[...slug].astro). Every other article keeps using the
// unmodified ArticleLayout. See ARTICLE_DESIGN_SYSTEM.md for the full
// component reference.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedArticles from '../components/article/RelatedArticles.astro';
import ToolCTA from '../components/ToolCTA.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareButtons from '../components/ShareButtons.astro';
import ArticleHero from '../components/article/ArticleHero.astro';
import ArticleCTA from '../components/article/ArticleCTA.astro';
import '../styles/field-manual-article.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: CollectionEntry<'articles'>;
  headings: Heading[];
}

const { article, headings } = Astro.props;
const { data } = article;

const hubs = data.hub ? await getCollection('hubs') : [];
const parentHub = hubs.find((hub) => hub.id === `/${data.hub}/`);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  ...(parentHub ? [{ label: parentHub.data.title, href: parentHub.data.slug }] : []),
  { label: data.title, href: data.slug },
];

// Rough estimate from the raw source body — strips MDX import lines
// and tags rather than trying to be exact. 200wpm, rounded, 1 min floor.
function estimateReadingTime(body: string | undefined): string | undefined {
  if (!body) return undefined;
  const text = body
    .replace(/^import .+$/gm, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[#>*_`]/g, ' ');
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  if (words < 50) return undefined;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min read`;
}

const readingTime = estimateReadingTime((article as unknown as { body?: string }).body);
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={data.canonical}
  ogImage={data.og_image ?? data.hero_image}
  type="article"
  publishedDate={data.date}
  updatedDate={data.updated}
  noindex={data.status === 'source-pending'}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="page-container">
    <Breadcrumbs items={breadcrumbItems} />

    <article>
      <ArticleHero
        category={data.hero_category ?? parentHub?.data.title ?? 'Field Manual'}
        title={data.title}
        subheading={data.hero_subheading}
        date={data.date}
        updatedDate={data.updated}
        readingTime={readingTime}
        image={data.hero_image}
        imageAlt={data.hero_image_alt}
        imageCaption={data.hero_image_caption}
      />

      <div class="fm-article">
        <ShareButtons url={data.canonical} title={data.title} />
        <TableOfContents headings={headings} />
        <slot />
      </div>
    </article>

    <div class="fm-article">
      {parentHub && (
        <p class="article-hub-link">
          Part of the <a href={parentHub.data.slug}>{parentHub.data.title}</a> hub.
        </p>
      )}

      {data.related_articles.length > 0 && <RelatedArticles paths={data.related_articles} />}
      {data.related_tools.length > 0 && <ToolCTA tools={data.related_tools} />}
    </div>

    <ArticleCTA
      variant={data.cta_variant}
      heading={data.cta_heading}
      body={data.cta_body}
      primaryLabel={data.cta_primary_label}
      primaryUrl={data.cta_primary_url}
      secondaryLabel={data.cta_secondary_label}
      secondaryUrl={data.cta_secondary_url}
    />
  </div>
</BaseLayout>
