---
// The one article layout, used by every article on the site — the
// "field manual" system that started as ArticleLayoutV2 on a handful
// of field-test articles and is now the sitewide standard. See
// ARTICLE_SYSTEM.md for the component reference and authoring rules.
//
// Legacy (WordPress-migrated) articles flow through the same layout
// with graceful fallbacks: `og_image` doubles as the hero image when
// no `hero_image` is set, `title` is the H1 when no `display_title`
// exists, and utility pages (`exclude_from_blog: true`) skip the
// share row, reading meta, and end-of-article CTA.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedArticles from '../components/article/RelatedArticles.astro';
import ToolCTA from '../components/ToolCTA.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ShareButtons from '../components/ShareButtons.astro';
import ArticleHero from '../components/article/ArticleHero.astro';
import ArticleCTA from '../components/article/ArticleCTA.astro';
import ArticleIntro from '../components/article/ArticleIntro.astro';
import { ctaContentTag } from '../lib/cta';
import '../styles/article.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: CollectionEntry<'articles'>;
  headings: Heading[];
}

const { article, headings } = Astro.props;
const { data } = article;

const hubs = data.hub ? await getCollection('hubs') : [];
// Hub entry ids are their frontmatter `slug` (e.g. "/church-planting-movements/"),
// not the bare filename — the content layer's default id generation picks up
// the `slug` field automatically.
const parentHub = hubs.find((hub) => hub.id === `/${data.hub}/`);

// Breadcrumb trail: Home, then the article's hub if it has one, then
// the current article itself as the final crumb. The Breadcrumbs
// component renders its last item as the non-link "current page," so
// listing the article last is what makes the hub a link and the
// article the current step (both in the visible trail and the
// BreadcrumbList schema). Uses display_title, falling back to the SEO
// title, to keep the final crumb short and human.
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  ...(parentHub ? [{ label: parentHub.data.title, href: parentHub.data.slug }] : []),
  { label: data.display_title ?? data.title, href: data.slug },
];

// Utility/legal/landing pages (privacy policy, contact, sticker pages…)
// are real pages but not editorial articles: no share row, no reading
// meta, and no automatic end-of-article CTA — their own body already is
// the call to action.
const isUtilityPage = data.exclude_from_blog;

// Rough estimate from the raw source body — strips MDX import lines
// and tags rather than trying to be exact. 200wpm, rounded. Pages
// under ~2 minutes (short tool/download pages) show no reading time
// at all — "1 min read" is meta noise, not reader help.
function estimateReadingTime(body: string | undefined): string | undefined {
  if (!body) return undefined;
  const text = body
    .replace(/^import .+$/gm, '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/[#>*_`]/g, ' ');
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  if (words < 300) return undefined;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min read`;
}

const readingTime = isUtilityPage
  ? undefined
  : estimateReadingTime((article as unknown as { body?: string }).body);

// `hero_image` is the only source of the hero visual — articles that
// open with their own visual (e.g. the 12-disciples portrait grid)
// deliberately have none. WordPress-migrated articles carried their
// old lead thumbnail over as an explicit hero_image during the 2026-07
// consistency pass. Alt falls back to the title for migrated images
// that never had hand-written alt text.
const heroImage = data.hero_image;
const heroImageAlt = data.hero_image_alt ?? data.title;

// End-of-article CTA fallback (see CTA_GUIDE.md): an explicit
// `article_cta` block always wins; an editorial article without one
// gets the default Lab CTA; a utility page gets none.
const articleCta = data.article_cta ?? (isUtilityPage ? { type: 'none' as const } : undefined);

// utm_content tag for the end-of-article CTA's lab link, following the
// "page-slug__cta-level__placement" convention in
// ECOSYSTEM_GROWTH_STRATEGY.md. Shared with the inline CTA
// (ArticleCTAInline) so an in-flow CTA tracks identically.
const ctaTag = ctaContentTag(data.slug);

// CTA placement: an article can move its single CTA up into the reading
// flow by setting `article_cta.placement: inline` and dropping an
// <ArticleCTAInline> in the body (see CTA_GUIDE.md). When it does, the
// layout renders no end-of-article CTA — there is still exactly one.
const ctaPlacement = (articleCta && 'placement' in articleCta ? articleCta.placement : undefined) ?? 'end';
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={data.canonical}
  ogImage={data.og_image ?? data.hero_image}
  type="article"
  author={data.author}
  ogImageAlt={data.og_image_alt}
  schemaImages={data.schema_images}
  publishedDate={data.date}
  updatedDate={data.updated}
  noindex={data.status === 'source-pending'}
  faq={data.faq}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="page-container">
    {/* Always at least Home plus the current article, so the trail
        renders on every article and Home stays a clickable link. */}
    {breadcrumbItems.length > 1 && <Breadcrumbs items={breadcrumbItems} />}

    {
      data.status === 'source-pending' && (
        <p class="source-pending-banner">
          This page is a migration placeholder. Live content has not been imported from WordPress
          yet. Original URL: <a href={data.original_url}>{data.original_url}</a>
        </p>
      )
    }

    <article>
      <ArticleHero
        eyebrow={data.hero_eyebrow}
        title={data.display_title ?? data.title}
        subheading={data.hero_subheading}
        author={data.author}
        date={data.date}
        updatedDate={data.updated}
        readingTime={readingTime}
        image={heroImage}
        imageAlt={heroImageAlt}
        imageCaption={data.hero_image_caption}
      />

      <div class="fm-article">
        {!isUtilityPage && <ShareButtons url={data.canonical} title={data.title} />}
        {data.intro && <ArticleIntro>{data.intro}</ArticleIntro>}
        {!data.hide_toc && <TableOfContents headings={headings} />}
        <slot />
      </div>
    </article>

    <div class="fm-article">
      {parentHub && (
        <p class="article-hub-link">
          Part of the <a href={parentHub.data.slug}>{parentHub.data.title}</a> hub.
        </p>
      )}

      {data.related_articles.length > 0 && <RelatedArticles paths={data.related_articles} />}
      {data.related_tools.length > 0 && <ToolCTA tools={data.related_tools} />}
    </div>

    {ctaPlacement !== 'inline' && <ArticleCTA articleCta={articleCta} contentTag={ctaTag} />}
  </div>
</BaseLayout>

<style>
  .article-hub-link {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>
