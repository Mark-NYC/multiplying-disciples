---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import ToolCTA from '../components/ToolCTA.astro';
import CovoMark from '../components/CovoMark.astro';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { data } = article;

const hubs = data.hub ? await getCollection('hubs') : [];
const parentHub = hubs.find((hub) => hub.id === data.hub);

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  ...(parentHub ? [{ label: parentHub.data.title, href: parentHub.data.slug }] : []),
  { label: data.title, href: data.slug },
];

// Closing "next step" CTA shown on real editorial articles only —
// utility/tool/legal pages (exclude_from_blog: true) already have
// their own specific CTA and shouldn't get a second, generic one.

// utm_content tag for the lab links in this CTA band, following the
// "page-slug__cta-level__placement" convention in
// ECOSYSTEM_GROWTH_STRATEGY.md.
const labsContentTag = `${data.slug.replace(/^\/|\/$/g, '')}__training__cta-band`;
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={data.canonical}
  ogImage={data.og_image}
  type="article"
  publishedDate={data.date}
  updatedDate={data.updated}
  noindex={data.status === 'source-pending'}
>
  <div class="page-container">
    <Breadcrumbs items={breadcrumbItems} />

    {
      data.status === 'source-pending' && (
        <p class="source-pending-banner">
          This page is a migration placeholder. Live content has not been imported from
          WordPress yet. Original URL:{' '}
          <a href={data.original_url}>{data.original_url}</a>
        </p>
      )
    }

    <article>
      {data.og_image && (
        <img class="article-thumbnail" src={data.og_image} alt={data.title} width="800" height="450" />
      )}
      <h1>{data.title}</h1>
      <slot />
    </article>

    {parentHub && (
      <p class="article-hub-link">
        Part of the <a href={parentHub.data.slug}>{parentHub.data.title}</a> hub.
      </p>
    )}

    {data.related_articles.length > 0 && <RelatedArticles paths={data.related_articles} />}
    {data.related_tools.length > 0 && <ToolCTA tools={data.related_tools} />}

    {
      !data.exclude_from_blog && (
        <section class="cta-band">
          <h2><CovoMark /> Be a movement multiplier.</h2>
          <p>Get starter tools and coaching to multiply disciples, leaders, and churches in your city.</p>
          <div
            class="cta-band__lab"
            id="article-next-lab"
            aria-live="polite"
            data-labs-content-tag={labsContentTag}
          >
            <p class="labs-cta__loading">Loading the next lab&hellip;</p>
          </div>
          <div class="cta-band__actions">
            <a class="button button--secondary-dark" href="/contact-us/">Connect</a>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  import { renderLabsInto } from '../lib/labs-feed.js';

  const container = document.getElementById('article-next-lab');
  if (container) {
    renderLabsInto(container, 1, 'Join This Lab', container.dataset.labsContentTag);
  }
</script>

<style>
  .article-thumbnail {
    display: block;
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    margin-bottom: 1.5rem;
  }

  .article-hub-link {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>
