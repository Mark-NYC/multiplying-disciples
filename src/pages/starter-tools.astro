---
// Start Making Disciples — the beginner pathway (animated napkin redesign).
//
// One simple 1-2-3 pathway that puts real field tools in the visitor's
// hands: Find people -> Share Jesus -> Make disciples. Each move is a
// cycling napkin: one blank napkin that reveals a tool, gets crumpled, and
// is replaced by a fresh napkin for the second tool, on a ~10s loop
// (CyclingNapkinTools). The ecosystem is never explained near the top;
// coaching/community appear only once, after the first two moves.
//
// Same URL (/starter-tools/), bespoke page (kingdom-ministry-training
// precedent), hand-indexed for search.
//
// 3 Circles has no approved SVG yet, so its slot uses a restrained inline
// placeholder schematic; the real CTA (/3-circles/) is still wired and the
// slot swaps to a real /tools-images svg by giving that tool an `svgSrc`.
//
// Tracking (src/lib/ecosystem-tracking.js): every CTA carries
// data-ecosystem-cta + the documented data-cta-* schema. Cross-domain links
// (obey.tools / covo) add UTMs; same-domain anchors never get UTMs.
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeStepOverview from '../components/ThreeStepOverview.astro';
import CyclingNapkinTools from '../components/CyclingNapkinTools.astro';
import PracticeRhythmSection from '../components/PracticeRhythmSection.astro';
import FinalActionCards from '../components/FinalActionCards.astro';
import { COVO_COMMUNITY_URL } from '../data/site';

const OBEY = 'https://obey.tools';
const CAMPAIGN = 'disciple_making_pathway';

// Cross-domain UTM (page-slug + placement). Query precedes any #fragment.
// Same-domain links must never call this.
function utm(href: string, content: string): string {
  const params = new URLSearchParams({
    utm_source: 'multiplyingdisciples',
    utm_medium: 'organic_cta',
    utm_campaign: CAMPAIGN,
    utm_content: `starter-tools__${content}`,
  });
  const h = href.indexOf('#');
  const base = h === -1 ? href : href.slice(0, h);
  const frag = h === -1 ? '' : href.slice(h);
  return `${base}${base.includes('?') ? '&' : '?'}${params.toString()}${frag}`;
}

const TOOLS = '/tools-images';

const steps = [
  { number: '1', heading: 'Find people', line: 'Notice who God has already placed around you.', href: '#find-people' },
  { number: '2', heading: 'Share Jesus', line: 'Tell your story and explain the gospel simply.', href: '#share-jesus' },
  { number: '3', heading: 'Make disciples', line: 'Help responsive people obey, gather, and multiply.', href: '#make-disciples' },
];

// Napkin sequence order = array order (tool shown first is index 0). The
// `primary` flag drives the highlighted CTA + the reduced-motion default.
const findPeopleTools = [
  {
    key: 'ff', name: 'Follow and Fish', animType: 'follow-fish' as const,
    svgSrc: `${TOOLS}/Follow-and-Fish-tool.svg`,
    ariaLabel: 'Follow and Fish: a hand-drawn Mark 1:17 sign with arrows pointing to FOLLOW and FISH.',
    cta: { label: 'Use Follow and Fish', href: '/4-1-1/', primary: false, ctaLevel: 'tool', ctaType: 'md-tool', destinationSite: 'multiplyingdisciples' },
  },
  {
    key: 'cb', name: 'Conversation Box', animType: 'conversation' as const,
    svgSrc: `${TOOLS}/Conversation-Quadrant-tool.svg`,
    ariaLabel: 'The Conversation Box: a quadrant of Casual, Meaningful, Discovery, and Spiritual conversations for tracking where each person is.',
    cta: { label: 'Open the Conversation Box', href: utm(`${OBEY}/conversation-box.html`, 'cbox-find'), external: true, primary: true, ctaLevel: 'tool', ctaType: 'obeytools', destinationSite: 'obeytools' },
  },
];

const shareJesusTools = [
  {
    key: 'tc', name: '3 Circles', animType: 'three-circles' as const,
    svgSrc: `${TOOLS}/Three-Circles-Gospel-Tool.svg`,
    ariaLabel: 'The 3 Circles gospel tool: God’s design, brokenness, the gospel through Jesus, and new creation, connected by arrows.',
    cta: { label: 'Learn 3 Circles', href: '/3-circles/', primary: true, ctaLevel: 'tool', ctaType: 'md-tool', destinationSite: 'multiplyingdisciples' },
  },
  {
    key: 'tt15', name: '15-Second Testimony', animType: 'testimony' as const,
    svgSrc: `${TOOLS}/15-Second-Testimony-tool.svg`,
    ariaLabel: 'The 15-Second Testimony: a before, Jesus, and now guide with a closing question.',
    cta: { label: 'Build Your 15-Second Testimony', href: '/15-second-testimony-examples-ignite-your-faith/', primary: false, ctaLevel: 'tool', ctaType: 'md-tool', destinationSite: 'multiplyingdisciples' },
  },
];

const makeDisciplesTools = [
  {
    key: 'th', name: 'Three Thirds', animType: 'three-thirds' as const,
    svgSrc: `${TOOLS}/Three-Thirds-tool.svg`,
    ariaLabel: 'The Three Thirds meeting pattern: look back, look up, and look forward.',
    cta: { label: 'Start With Three Thirds', href: '/three-thirds/', primary: true, ctaLevel: 'tool', ctaType: 'md-tool', destinationSite: 'multiplyingdisciples' },
  },
  {
    key: 'cw', name: 'Church Waffle', animType: 'church-waffle' as const,
    svgSrc: `${TOOLS}/Church-Waffle-tool.svg`,
    ariaLabel: 'The Church Waffle: a circular grid of the twelve practices of a healthy church.',
    cta: { label: 'Use the Church Waffle', href: utm(`${OBEY}/church-assessment.html`, 'waffle-make'), external: true, primary: false, ctaLevel: 'tool', ctaType: 'obeytools', destinationSite: 'obeytools' },
  },
];
---

<BaseLayout
  title="Start Making Disciples: Simple Tools on a Napkin"
  description="Three simple moves — find people, share Jesus, make disciples — and the hand-drawn field tools that help you take your next step with the people already around you."
  canonical="https://multiplyingdisciples.us/starter-tools/"
  ogImage="/tools-images/blank-napkin.webp"
  type="website"
>
  <!-- 1. HERO — one action, one CTA. No ecosystem, no second button. -->
  <section class="st-hero">
    <div class="st-hero__inner">
      <h1>Start Making <span class="fm-underline fm-underline--shape-a fm-underline--clay-text">Disciples</span>.</h1>
      <p class="st-hero__subhead">
        Start with the people God has already placed around you. We&rsquo;ll show you three simple
        moves and the tools that can help.
      </p>
      <p class="st-hero__cta">
        <a
          class="button"
          href="#find-people"
          data-ecosystem-cta
          data-cta-level="tutorial"
          data-cta-type="tutorial-start"
          data-destination-site="multiplyingdisciples"
        >Start With Five People</a>
      </p>
    </div>
  </section>

  <!-- 2. THREE-STEP OVERVIEW — the whole page in one glance. -->
  <ThreeStepOverview steps={steps} />

  <!-- 3. FIND PEOPLE — Follow and Fish -> Conversation Box -->
  <section class="st-stage st-stage--paper" id="find-people">
    <div class="st-stage__inner">
      <div class="st-stage__text">
        <p class="st-stage__eyebrow"><span class="st-stage__num">1</span>Find people</p>
        <h2>Start with people you already know.</h2>
        <p class="st-stage__copy">Pay attention, pray, and begin intentional spiritual conversations with the people already in your life.</p>
        <p class="st-stage__do">Add five names.</p>
      </div>
      <div class="st-stage__visual">
        <CyclingNapkinTools id="find-people" tools={findPeopleTools} />
      </div>
    </div>
  </section>

  <!-- 4. SHARE JESUS — 3 Circles -> 15-Second Testimony -->
  <section class="st-stage st-stage--sage st-stage--reverse" id="share-jesus">
    <div class="st-stage__inner">
      <div class="st-stage__text">
        <p class="st-stage__eyebrow"><span class="st-stage__num">2</span>Share Jesus</p>
        <h2>Share your story, then explain the gospel simply.</h2>
        <p class="st-stage__copy">Say what Jesus has done in your life and draw the gospel simply enough to use in a real conversation.</p>
        <p class="st-stage__do">Practice one tool until you can use it naturally.</p>
      </div>
      <div class="st-stage__visual">
        <CyclingNapkinTools id="share-jesus" tools={shareJesusTools} />
      </div>
    </div>
  </section>

  <!-- 5. COACHING INTERRUPTION — practice + community appear only now. -->
  <PracticeRhythmSection
    heading="Tools are simple. Using them with real people takes practice."
    copy="You learn disciple making by trying, sharing what happened, getting feedback, and going again."
    rhythm={['Learn', 'Use', 'Share', 'Get feedback', 'Repeat']}
    ctas={[
      {
        label: 'Join a Live Practice Lab',
        href: '/#ch-practice',
        ctaLevel: 'training',
        ctaType: 'covo-lab',
        destinationSite: 'multiplyingdisciples',
      },
      {
        label: 'Practice With the Community',
        href: utm(COVO_COMMUNITY_URL, 'community-mid'),
        external: true,
        ctaLevel: 'community',
        ctaType: 'covo-community',
        destinationSite: 'covo',
      },
    ]}
  />

  <!-- 6. MAKE DISCIPLES — Three Thirds -> Church Waffle -->
  <section class="st-stage st-stage--paper" id="make-disciples">
    <div class="st-stage__inner">
      <div class="st-stage__text">
        <p class="st-stage__eyebrow"><span class="st-stage__num">3</span>Make disciples</p>
        <h2>When someone is open, meet again quickly.</h2>
        <p class="st-stage__copy">Help them obey Jesus, gather with others, and begin doing the same with the people they know.</p>
        <p class="st-stage__do">Invite one responsive person to meet again.</p>
      </div>
      <div class="st-stage__visual">
        <CyclingNapkinTools id="make-disciples" tools={makeDisciplesTools} />
      </div>
    </div>
  </section>

  <!-- 7. YOUR FIRST THREE MOVES -->
  <section class="st-first" aria-labelledby="st-first-h">
    <div class="st-first__inner">
      <h2 id="st-first-h">Your first three moves</h2>
      <ol class="st-first__list">
        <li>Add five people to the Conversation Box.</li>
        <li>Start one spiritual conversation.</li>
        <li>Practice with people who will help you keep going.</li>
      </ol>
      <p class="st-first__cta">
        <a
          class="button"
          href={utm(`${OBEY}/conversation-box.html`, 'cbox-firstmove')}
          target="_blank"
          rel="noopener"
          data-ecosystem-cta
          data-cta-level="tool"
          data-cta-type="obeytools"
          data-destination-site="obeytools"
        >Take the First Step <span class="st-ext" aria-hidden="true">&#8599;</span></a>
      </p>
    </div>
  </section>

  <!-- 8. FINAL — two paths only: tools, then practice. -->
  <FinalActionCards
    cards={[
      {
        heading: 'Use the Tools',
        copy: 'Open the toolbox and take your next step.',
        primary: true,
        cta: {
          label: 'Open Obey.Tools',
          href: utm(`${OBEY}/`, 'toolbox-final'),
          external: true,
          ctaLevel: 'tool',
          ctaType: 'obeytools',
          destinationSite: 'obeytools',
        },
      },
      {
        heading: 'Practice With Others',
        copy: 'Join live coaching and a community of people learning through real obedience.',
        cta: {
          label: 'Join the Practice Community',
          href: utm(COVO_COMMUNITY_URL, 'community-final'),
          external: true,
          secondary: true,
          ctaLevel: 'community',
          ctaType: 'covo-community',
          destinationSite: 'covo',
        },
      },
    ]}
  />
</BaseLayout>

<style>
  /* --- 1. Hero --------------------------------------------------- */
  .st-hero {
    padding: 5.5rem 1.25rem 4rem;
    text-align: center;
    background: var(--color-bg);
  }
  .st-hero__inner { max-width: 42rem; margin: 0 auto; }
  .st-hero h1 {
    max-width: 20ch;
    margin: 0 auto 1.4rem;
    font-size: var(--fs-h1);
    line-height: 1.08;
    color: var(--color-primary);
  }
  .st-hero__subhead {
    max-width: 34rem;
    margin: 0 auto 2.25rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .st-hero__cta { margin: 0; }
  .st-hero__cta .button { padding: 0.95rem 2.3rem; font-size: 1.1rem; font-weight: 700; }

  /* --- 3-6. Napkin stages --------------------------------------- */
  .st-stage { padding: 5rem 1.5rem; }
  .st-stage--paper { background: var(--color-bg); }
  .st-stage--sage { background: var(--color-surface); }
  .st-stage__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 861px) {
    .st-stage--reverse .st-stage__text { order: 2; }
    .st-stage--reverse .st-stage__visual { order: 1; }
  }
  .st-stage__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-clay-text);
  }
  .st-stage__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-primary);
    font-size: 0.85rem;
  }
  .st-stage__text h2 {
    margin: 0 0 1rem;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-primary);
  }
  .st-stage__copy {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .st-stage__do {
    margin: 1.5rem 0 0;
    padding: 0.7rem 1rem;
    display: inline-block;
    background: #ffffff;
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-button);
    font-weight: 700;
    color: var(--color-primary);
  }
  .st-stage--sage .st-stage__do { background: var(--color-bg); }

  @media (max-width: 860px) {
    .st-stage { padding: 3.5rem 1.25rem; }
    .st-stage__inner { grid-template-columns: 1fr; row-gap: 2rem; }
  }

  /* --- 7. First three moves ------------------------------------- */
  .st-first {
    padding: 4.5rem 1.5rem;
    background: var(--color-surface);
    text-align: center;
  }
  .st-first__inner { max-width: 36rem; margin: 0 auto; }
  .st-first h2 { margin: 0 0 1.75rem; font-size: var(--fs-h2); color: var(--color-primary); }
  .st-first__list {
    margin: 0 auto 2rem;
    max-width: 28rem;
    padding: 0;
    list-style: none;
    counter-reset: m;
    text-align: left;
  }
  .st-first__list li {
    counter-increment: m;
    position: relative;
    padding: 0.85rem 0 0.85rem 3rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.0625rem;
    color: var(--color-ink);
  }
  .st-first__list li:last-child { border-bottom: none; }
  .st-first__list li::before {
    content: counter(m);
    position: absolute;
    left: 0;
    top: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-primary-text);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .st-first__cta { margin: 0; }
  .st-first__cta .button { padding: 1rem 2.4rem; font-size: 1.1rem; font-weight: 700; }
  .st-ext { font-size: 0.85em; }

  @media (max-width: 560px) {
    .st-hero { padding: 4rem 1.25rem 3rem; }
    .st-first { padding: 3.5rem 1.25rem; }
  }
</style>
