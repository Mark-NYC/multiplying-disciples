---
// Start Making Disciples — the beginner pathway (napkin redesign).
//
// One simple 1-2-3 pathway that puts real field tools in the visitor's
// hands: Find people -> Share Jesus -> Make disciples. The page reads like
// notes on a napkin, not a software product page: each move is one napkin
// visual (blank-napkin.webp) with two hand-drawn tool SVGs layered on top.
//
// The ecosystem is never explained near the top — coaching/community appear
// only once, after the first two moves. Same URL (/starter-tools/), bespoke
// page (kingdom-ministry-training precedent), hand-indexed for search.
//
// Tools: tool artwork lives in /public/tools-images/ (hand-drawn SVGs on a
// napkin base). 3 Circles has no SVG yet, so its slot renders a clearly
// labelled placeholder card — the real CTA (/3-circles/) is still wired.
//
// Tracking (src/lib/ecosystem-tracking.js): every CTA carries
// data-ecosystem-cta + the documented data-cta-* schema. Cross-domain links
// (obey.tools / covo) add UTMs; same-domain anchors never get UTMs.
import BaseLayout from '../layouts/BaseLayout.astro';
import ThreeStepOverview from '../components/ThreeStepOverview.astro';
import NapkinToolStage from '../components/NapkinToolStage.astro';
import PracticeRhythmSection from '../components/PracticeRhythmSection.astro';
import FinalActionCards from '../components/FinalActionCards.astro';
import { COVO_COMMUNITY_URL } from '../data/site';

const OBEY = 'https://obey.tools';
const CAMPAIGN = 'disciple_making_pathway';

// Cross-domain UTM (page-slug + placement). Query precedes any #fragment.
// Same-domain links must never call this.
function utm(href: string, content: string): string {
  const params = new URLSearchParams({
    utm_source: 'multiplyingdisciples',
    utm_medium: 'organic_cta',
    utm_campaign: CAMPAIGN,
    utm_content: `starter-tools__${content}`,
  });
  const h = href.indexOf('#');
  const base = h === -1 ? href : href.slice(0, h);
  const frag = h === -1 ? '' : href.slice(h);
  return `${base}${base.includes('?') ? '&' : '?'}${params.toString()}${frag}`;
}

const TOOLS = '/tools-images';

const steps = [
  { number: '1', heading: 'Find people', line: 'Notice who God has already placed around you.', href: '#find-people' },
  { number: '2', heading: 'Share Jesus', line: 'Tell your story and explain the gospel simply.', href: '#share-jesus' },
  { number: '3', heading: 'Make disciples', line: 'Help responsive people obey, gather, and multiply.', href: '#make-disciples' },
];
---

<BaseLayout
  title="Start Making Disciples: Simple Tools on a Napkin"
  description="Three simple moves — find people, share Jesus, make disciples — and the hand-drawn field tools that help you take your next step with the people already around you."
  canonical="https://multiplyingdisciples.us/starter-tools/"
  ogImage="/tools-images/blank-napkin.webp"
  type="website"
>
  <!-- 1. HERO — one action, one CTA. No ecosystem, no second button. -->
  <section class="st-hero">
    <div class="st-hero__inner">
      <h1>Start Making <span class="fm-underline fm-underline--shape-a fm-underline--clay-text">Disciples</span>.</h1>
      <p class="st-hero__subhead">
        Start with the people God has already placed around you. We&rsquo;ll show you three simple
        moves and the tools that can help.
      </p>
      <p class="st-hero__cta">
        <a
          class="button"
          href="#find-people"
          data-ecosystem-cta
          data-cta-level="tutorial"
          data-cta-type="tutorial-start"
          data-destination-site="multiplyingdisciples"
        >Start With Five People</a>
      </p>
    </div>
  </section>

  <!-- 2. THREE-STEP OVERVIEW — the whole page in one glance. -->
  <ThreeStepOverview steps={steps} />

  <!-- 3. FIND PEOPLE — Conversation Box (action) + Follow and Fish (concept) -->
  <NapkinToolStage
    id="find-people"
    number="1"
    eyebrow="Find people"
    heading="Start with people you already know."
    copy="Pay attention, pray, and begin intentional spiritual conversations with the people already in your life."
    immediateAction="Add five names."
    primary={{
      label: 'Open the Conversation Box',
      href: utm(`${OBEY}/conversation-box.html`, 'cbox-find'),
      external: true,
      ctaLevel: 'tool',
      ctaType: 'obeytools',
      destinationSite: 'obeytools',
    }}
    secondary={{
      label: 'Use Follow and Fish',
      href: '/4-1-1/',
      ctaLevel: 'tool',
      ctaType: 'md-tool',
      destinationSite: 'multiplyingdisciples',
    }}
    tools={[
      { src: `${TOOLS}/Conversation-Quadrant-tool.svg`, name: 'Conversation Box', alt: 'The Conversation Box: a quadrant of Casual, Meaningful, Discovery, and Spiritual conversations.', role: 'dominant' },
      { src: `${TOOLS}/Follow-and-Fish-tool.svg`, name: 'Follow and Fish', alt: 'Follow and Fish: a hand-drawn Mark 1:17 sign pointing to follow Jesus and fish for people.', role: 'support' },
    ]}
    variant="paper"
  />

  <!-- 4. SHARE JESUS — 3 Circles (placeholder) + 15-Second Testimony -->
  <NapkinToolStage
    id="share-jesus"
    number="2"
    eyebrow="Share Jesus"
    heading="Share your story, then explain the gospel simply."
    copy="Say what Jesus has done in your life and draw the gospel simply enough to use in a real conversation."
    immediateAction="Practice one tool until you can use it naturally."
    primary={{
      label: 'Learn 3 Circles',
      href: '/3-circles/',
      ctaLevel: 'tool',
      ctaType: 'md-tool',
      destinationSite: 'multiplyingdisciples',
    }}
    secondary={{
      label: 'Build Your 15-Second Testimony',
      href: '/15-second-testimony-examples-ignite-your-faith/',
      ctaLevel: 'tool',
      ctaType: 'md-tool',
      destinationSite: 'multiplyingdisciples',
    }}
    tools={[
      { name: '3 Circles', role: 'dominant', placeholder: true },
      { src: `${TOOLS}/15-Second-Testimony-tool.svg`, name: '15-Second Testimony', alt: 'The 15-Second Testimony: a hand-drawn before / how / after guide to telling your story.', role: 'support' },
    ]}
    variant="sage"
    reverse={true}
  />

  <!-- 5. COACHING INTERRUPTION — practice + community appear only now. -->
  <PracticeRhythmSection
    heading="Tools are simple. Using them with real people takes practice."
    copy="You learn disciple making by trying, sharing what happened, getting feedback, and going again."
    rhythm={['Learn', 'Use', 'Share', 'Get feedback', 'Repeat']}
    ctas={[
      {
        label: 'Join a Live Practice Lab',
        href: '/#ch-practice',
        ctaLevel: 'training',
        ctaType: 'covo-lab',
        destinationSite: 'multiplyingdisciples',
      },
      {
        label: 'Practice With the Community',
        href: utm(COVO_COMMUNITY_URL, 'community-mid'),
        external: true,
        ctaLevel: 'community',
        ctaType: 'covo-community',
        destinationSite: 'covo',
      },
    ]}
  />

  <!-- 6. MAKE DISCIPLES — Three Thirds (action) + Church Waffle (support) -->
  <NapkinToolStage
    id="make-disciples"
    number="3"
    eyebrow="Make disciples"
    heading="When someone is open, meet again quickly."
    copy="Help them obey Jesus, gather with others, and begin doing the same with the people they know."
    immediateAction="Invite one responsive person to meet again."
    primary={{
      label: 'Start with Three Thirds',
      href: '/three-thirds/',
      ctaLevel: 'tool',
      ctaType: 'md-tool',
      destinationSite: 'multiplyingdisciples',
    }}
    secondary={{
      label: 'Use the Church Waffle',
      href: utm(`${OBEY}/church-assessment.html`, 'waffle-make'),
      external: true,
      ctaLevel: 'tool',
      ctaType: 'obeytools',
      destinationSite: 'obeytools',
    }}
    tools={[
      { src: `${TOOLS}/Three-Thirds-tool.svg`, name: 'Three Thirds', alt: 'The Three Thirds meeting pattern: look back, look up, look forward.', role: 'dominant' },
      { src: `${TOOLS}/Church-Waffle-tool.svg`, name: 'Church Waffle', alt: 'The Church Waffle: a circular grid of the twelve practices of a healthy church.', role: 'support' },
    ]}
    variant="paper"
  />

  <!-- 7. YOUR FIRST THREE MOVES -->
  <section class="st-first" aria-labelledby="st-first-h">
    <div class="st-first__inner">
      <h2 id="st-first-h">Your first three moves</h2>
      <ol class="st-first__list">
        <li>Add five people to the Conversation Box.</li>
        <li>Start one spiritual conversation.</li>
        <li>Practice with people who will help you keep going.</li>
      </ol>
      <p class="st-first__cta">
        <a
          class="button"
          href={utm(`${OBEY}/conversation-box.html`, 'cbox-firstmove')}
          target="_blank"
          rel="noopener"
          data-ecosystem-cta
          data-cta-level="tool"
          data-cta-type="obeytools"
          data-destination-site="obeytools"
        >Take the First Step <span class="st-ext" aria-hidden="true">&#8599;</span></a>
      </p>
    </div>
  </section>

  <!-- 8. FINAL — two paths only: tools, then practice. -->
  <FinalActionCards
    cards={[
      {
        heading: 'Use the Tools',
        copy: 'Open the toolbox and take your next step.',
        primary: true,
        cta: {
          label: 'Open Obey.Tools',
          href: utm(`${OBEY}/`, 'toolbox-final'),
          external: true,
          ctaLevel: 'tool',
          ctaType: 'obeytools',
          destinationSite: 'obeytools',
        },
      },
      {
        heading: 'Practice With Others',
        copy: 'Join live coaching and a community of people learning through real obedience.',
        cta: {
          label: 'Join the Practice Community',
          href: utm(COVO_COMMUNITY_URL, 'community-final'),
          external: true,
          secondary: true,
          ctaLevel: 'community',
          ctaType: 'covo-community',
          destinationSite: 'covo',
        },
      },
    ]}
  />

  <noscript>
    <style>
      /* Without JS the scroll-reveal never fires — show every layer. */
      .napkin__base, .napkin__tool { opacity: 1 !important; }
    </style>
  </noscript>
</BaseLayout>

<script>
  // Once-only reveal for each napkin as it scrolls into view. Reduced
  // motion is already handled in CSS (layers render visible); we still
  // add the class so nothing stays hidden. No looping, no library.
  const napkins = document.querySelectorAll<HTMLElement>('.napkin[data-reveal]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduced || !('IntersectionObserver' in window)) {
    napkins.forEach((n) => n.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25, rootMargin: '0px 0px -8% 0px' }
    );
    napkins.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* --- 1. Hero --------------------------------------------------- */
  .st-hero {
    padding: 5.5rem 1.25rem 4rem;
    text-align: center;
    background: var(--color-bg);
  }
  .st-hero__inner { max-width: 42rem; margin: 0 auto; }
  .st-hero h1 {
    max-width: 20ch;
    margin: 0 auto 1.4rem;
    font-size: var(--fs-h1);
    line-height: 1.08;
    color: var(--color-primary);
  }
  .st-hero__subhead {
    max-width: 34rem;
    margin: 0 auto 2.25rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .st-hero__cta { margin: 0; }
  .st-hero__cta .button { padding: 0.95rem 2.3rem; font-size: 1.1rem; font-weight: 700; }

  /* --- 7. First three moves ------------------------------------- */
  .st-first {
    padding: 4.5rem 1.5rem;
    background: var(--color-surface);
    text-align: center;
  }
  .st-first__inner { max-width: 36rem; margin: 0 auto; }
  .st-first h2 { margin: 0 0 1.75rem; font-size: var(--fs-h2); color: var(--color-primary); }
  .st-first__list {
    margin: 0 auto 2rem;
    max-width: 28rem;
    padding: 0;
    list-style: none;
    counter-reset: m;
    text-align: left;
  }
  .st-first__list li {
    counter-increment: m;
    position: relative;
    padding: 0.85rem 0 0.85rem 3rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.0625rem;
    color: var(--color-ink);
  }
  .st-first__list li:last-child { border-bottom: none; }
  .st-first__list li::before {
    content: counter(m);
    position: absolute;
    left: 0;
    top: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-primary-text);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .st-first__cta { margin: 0; }
  .st-first__cta .button { padding: 1rem 2.4rem; font-size: 1.1rem; font-weight: 700; }
  .st-ext { font-size: 0.85em; }

  @media (max-width: 560px) {
    .st-hero { padding: 4rem 1.25rem 3rem; }
    .st-first { padding: 3.5rem 1.25rem; }
  }
</style>
