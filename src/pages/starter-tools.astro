---
// Start Making Disciples — the beginner tutorial (v2).
//
// Reworked from a six-step tutorial + three-site ecosystem explainer
// into one simple 1-2-3 pathway that puts real tools in the visitor's
// hands: Find people -> Share Jesus -> Make disciples. The visitor
// experiences the pathway first; coaching/community appear only after
// the first two stages, and the three-site architecture is never
// explained on the page (they are already on Multiplying Disciples).
//
// Same URL, bespoke page (kingdom-ministry-training precedent),
// hand-indexed for search. Tool visuals are real Obey.Tools interface
// screenshots (captured from the mark-nyc/obey-tools repo) and the
// official 3 Circles diagram — never stock art, never generic icons.
//
// Tracking (src/lib/ecosystem-tracking.js): every primary CTA carries
// data-ecosystem-cta. Cross-domain links (obey.tools / covo) add the
// documented UTM structure; same-domain anchors never get UTMs.
import BaseLayout from '../layouts/BaseLayout.astro';
import { imageDimensions } from '../lib/image-dimensions.mjs';
import { COVO_COMMUNITY_URL } from '../data/site';

const OBEY = 'https://obey.tools';
const CAMPAIGN = 'disciple_making_pathway';

// Cross-domain UTM (page-slug + level + placement). Query precedes any
// #fragment. Same-domain links must not call this.
function utm(href: string, content: string): string {
  const params = new URLSearchParams({
    utm_source: 'multiplyingdisciples',
    utm_medium: 'organic_cta',
    utm_campaign: CAMPAIGN,
    utm_content: `starter-tools__${content}`,
  });
  const h = href.indexOf('#');
  const base = h === -1 ? href : href.slice(0, h);
  const frag = h === -1 ? '' : href.slice(h);
  return `${base}${base.includes('?') ? '&' : '?'}${params.toString()}${frag}`;
}

// Tool preview visuals (real Obey.Tools UI + the 3 Circles diagram).
function img(src: string) {
  return { src, ...imageDimensions(src) };
}
const shots = {
  conversationBox: img('/images/tools/conversation-box.png'),
  fourQuestions: img('/images/tools/4-questions.png'),
  threeCircles: img('/images/tools/3-circles.webp'),
  storiesOfHope: img('/images/tools/stories-of-hope.png'),
  commands: img('/images/tools/commands-of-christ.png'),
  churchCircle: img('/images/tools/church-circle.png'),
};
---

<BaseLayout
  title="Start Making Disciples: Simple Tools & Coaching"
  description="Three simple moves — find people, share Jesus, make disciples — and the tools that help you take your next step with the people already around you."
  canonical="https://multiplyingdisciples.us/starter-tools/"
  ogImage="/images/tools/3-circles.webp"
  type="website"
>
  <!-- 1. HERO — one action, one CTA. No ecosystem, no second button. -->
  <section class="st-hero">
    <div class="st-hero__inner">
      <h1>Start Making <span class="fm-underline fm-underline--shape-a fm-underline--clay-text">Disciples</span>.</h1>
      <p class="st-hero__subhead">
        Start with the people God has already placed around you. We&rsquo;ll show you three simple
        moves and the tools that can help.
      </p>
      <p class="st-hero__cta">
        <a
          class="button"
          href="#find-people"
          data-ecosystem-cta
          data-cta-level="tutorial"
          data-cta-type="tutorial-start"
          data-destination-site="multiplyingdisciples"
        >Start With Five People</a>
      </p>
    </div>
  </section>

  <!-- 2. THREE-STEP PATHWAY OVERVIEW — the whole page in one glance. -->
  <section class="st-path" aria-label="The pathway">
    <ol class="st-path__list">
      <li class="st-path__step">
        <span class="st-path__num">1</span>
        <h2>Find people</h2>
        <p>Notice who God has already placed around you and begin spiritual conversations.</p>
      </li>
      <li class="st-path__step">
        <span class="st-path__num">2</span>
        <h2>Share Jesus</h2>
        <p>Share your story, explain the gospel, and see who wants to continue.</p>
      </li>
      <li class="st-path__step">
        <span class="st-path__num">3</span>
        <h2>Make disciples</h2>
        <p>Help responsive people obey Jesus, gather with others, and do the same.</p>
      </li>
    </ol>
  </section>

  <!-- 3. STEP 1: FIND PEOPLE -->
  <section class="st-stage st-stage--paper" id="find-people">
    <div class="st-stage__inner">
      <div class="st-stage__intro">
        <p class="st-stage__kicker">1 &middot; Find people</p>
        <h2>Start with people you already know.</h2>
        <p>
          Pray for them, listen well, and look for chances to move an ordinary conversation toward
          Jesus. Use the Conversation Box to name the people already in your life and track where
          each conversation is going.
        </p>
      </div>
      <div class="st-stage__actions">
        <p class="st-do">Add five names.</p>
        <p class="st-stage__cta">
          <a
            class="button"
            href={utm(`${OBEY}/conversation-box.html`, 'tool__cbox-step1')}
            target="_blank"
            rel="noopener"
            data-ecosystem-cta
            data-cta-level="tool"
            data-cta-type="obeytools"
            data-destination-site="obeytools"
          >Open the Conversation Box <span class="st-ext">&#8599;</span></a>
        </p>
        <p class="st-support">
          <strong>4 Questions</strong> — discover where someone is spiritually and what a faithful
          next step could be. <a
            href={utm(`${OBEY}/4-questions.html`, 'tool__4q-step1')}
            target="_blank"
            rel="noopener"
            data-ecosystem-cta
            data-cta-level="tool"
            data-cta-type="obeytools"
            data-destination-site="obeytools"
          >See the 4 Questions &#8599;</a>
        </p>
      </div>
      <div class="st-stage__visual">
        <figure class="st-frame st-frame--primary">
          <span class="st-frame__bar" aria-hidden="true"><i></i><i></i><i></i><em>obey.tools/conversation-box</em></span>
          <img src={shots.conversationBox.src} width={shots.conversationBox.width} height={shots.conversationBox.height} alt="The Conversation Box tool: Casual, Meaningful, Discovery, and Spiritual columns for tracking where each person is." loading="lazy" decoding="async" />
        </figure>
        <figure class="st-frame st-frame--small">
          <span class="st-frame__bar" aria-hidden="true"><i></i><i></i><i></i><em>obey.tools/4-questions</em></span>
          <img src={shots.fourQuestions.src} width={shots.fourQuestions.width} height={shots.fourQuestions.height} alt="The 4 Questions tool: read a passage, then answer Why, Who, How, and When to obey it." loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <!-- 4. STEP 2: SHARE JESUS -->
  <section class="st-stage st-stage--sage st-stage--reverse" id="share-jesus">
    <div class="st-stage__inner">
      <div class="st-stage__intro">
        <p class="st-stage__kicker">2 &middot; Share Jesus</p>
        <h2>Share what Jesus has done, then explain the gospel simply.</h2>
        <p>
          Tell your own story, draw the gospel on a napkin with the 3 Circles, and invite the
          person to respond.
        </p>
      </div>
      <div class="st-stage__actions">
        <p class="st-do">Practice one tool until you can use it naturally.</p>
        <p class="st-stage__cta">
          <a
            class="button"
            href={utm(`${OBEY}/3-circles.html`, 'tool__gospel-step2')}
            target="_blank"
            rel="noopener"
            data-ecosystem-cta
            data-cta-level="tool"
            data-cta-type="obeytools"
            data-destination-site="obeytools"
          >Learn to Share the Gospel <span class="st-ext">&#8599;</span></a>
        </p>
        <p class="st-support">
          <strong>15-Second Testimony</strong> — say what Jesus has done in a sentence or two.
          <a href="/15-second-testimony-examples-ignite-your-faith/">See examples</a>
        </p>
        <p class="st-support">
          <strong>Stories of Hope</strong> — read a short gospel story with someone who is curious.
          <a
            href={utm(`${OBEY}/stories-of-hope.html`, 'tool__stories-step2')}
            target="_blank"
            rel="noopener"
            data-ecosystem-cta
            data-cta-level="tool"
            data-cta-type="obeytools"
            data-destination-site="obeytools"
          >Open Stories of Hope &#8599;</a>
        </p>
      </div>
      <div class="st-stage__visual">
        <figure class="st-frame st-frame--primary st-frame--plain">
          <img src={shots.threeCircles.src} width={shots.threeCircles.width} height={shots.threeCircles.height} alt="The 3 Circles gospel diagram: God's design, brokenness and sin, and the way back through Jesus to new creation." loading="lazy" decoding="async" />
          <figcaption>The 3 Circles gospel tool</figcaption>
        </figure>
        <figure class="st-frame st-frame--small">
          <span class="st-frame__bar" aria-hidden="true"><i></i><i></i><i></i><em>obey.tools/stories-of-hope</em></span>
          <img src={shots.storiesOfHope.src} width={shots.storiesOfHope.width} height={shots.storiesOfHope.height} alt="The Stories of Hope tool: a list of short gospel stories to read with a seeker." loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <!-- 5. COACHING INTERRUPTION — introduced only now, framed around the
       visitor's need to practice. No CoVo org explainer, no three-site
       statement. -->
  <section class="st-coach" aria-labelledby="st-coach-h">
    <div class="st-coach__inner">
      <h2 id="st-coach-h">Tools are simple. Using them with real people takes practice.</h2>
      <p>You learn disciple making by trying, sharing what happened, receiving feedback, and going again.</p>
      <ol class="st-rhythm" aria-label="The practice rhythm">
        <li>Learn</li>
        <li>Use</li>
        <li>Share</li>
        <li>Get feedback</li>
        <li>Repeat</li>
      </ol>
      <p class="st-coach__ctas">
        <a
          class="button button--secondary-dark"
          href="/#ch-practice"
          data-ecosystem-cta
          data-cta-level="training"
          data-cta-type="covo-lab"
          data-destination-site="multiplyingdisciples"
        >Join a Live Practice Lab</a>
        <a
          class="button button--secondary-dark"
          href={utm(COVO_COMMUNITY_URL, 'community__mid')}
          target="_blank"
          rel="noopener"
          data-ecosystem-cta
          data-cta-level="community"
          data-cta-type="covo-community"
          data-destination-site="covo"
        >Practice With the Community</a>
      </p>
    </div>
  </section>

  <!-- 6. STEP 3: MAKE DISCIPLES -->
  <section class="st-stage st-stage--paper" id="make-disciples">
    <div class="st-stage__inner">
      <div class="st-stage__intro">
        <p class="st-stage__kicker">3 &middot; Make disciples</p>
        <h2>When someone is responsive, meet again quickly.</h2>
        <p>
          Help them obey Jesus one command at a time, gather with others, and begin doing the same
          with people they know.
        </p>
      </div>
      <div class="st-stage__actions">
        <p class="st-do">Invite one responsive person to meet again.</p>
        <p class="st-stage__cta">
          <a
            class="button"
            href={utm(`${OBEY}/commands-of-christ.html`, 'tool__commands-step3')}
            target="_blank"
            rel="noopener"
            data-ecosystem-cta
            data-cta-level="tool"
            data-cta-type="obeytools"
            data-destination-site="obeytools"
          >Start Commands of Christ <span class="st-ext">&#8599;</span></a>
        </p>
        <p class="st-support">
          <strong>Three Thirds</strong> — a simple meeting pattern: look back, look up, look ahead.
          <a href="/three-thirds/">See Three Thirds</a>
        </p>
        <p class="st-support">
          <strong>Church Circle</strong> — check which habits of a healthy church your group is
          practicing. <a
            href={utm(`${OBEY}/church-assessment.html`, 'tool__church-step3')}
            target="_blank"
            rel="noopener"
            data-ecosystem-cta
            data-cta-level="tool"
            data-cta-type="obeytools"
            data-destination-site="obeytools"
          >Open the Church Circle &#8599;</a>
        </p>
        <p class="st-progression">Follow Jesus &rarr; obey together &rarr; gather as church &rarr; multiply</p>
      </div>
      <div class="st-stage__visual">
        <figure class="st-frame st-frame--primary">
          <span class="st-frame__bar" aria-hidden="true"><i></i><i></i><i></i><em>obey.tools/commands-of-christ</em></span>
          <img src={shots.commands.src} width={shots.commands.width} height={shots.commands.height} alt="The Commands of Christ tool: a numbered list of commands to obey together, from Repent & Believe to Be Baptized and beyond." loading="lazy" decoding="async" />
        </figure>
        <figure class="st-frame st-frame--small">
          <span class="st-frame__bar" aria-hidden="true"><i></i><i></i><i></i><em>obey.tools/church-circle</em></span>
          <img src={shots.churchCircle.src} width={shots.churchCircle.width} height={shots.churchCircle.height} alt="The Church Circle assessment: a circle of the twelve habits of a healthy church to check together." loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
  </section>

  <!-- 7. YOUR FIRST THREE MOVES — aligned to the page. -->
  <section class="st-first" aria-labelledby="st-first-h">
    <div class="st-first__inner">
      <h2 id="st-first-h">Your first three moves</h2>
      <ol class="st-first__list">
        <li>Add five people to the Conversation Box.</li>
        <li>Start one spiritual conversation.</li>
        <li>Practice with people who will help you keep going.</li>
      </ol>
      <p class="st-first__cta">
        <a
          class="button"
          href={utm(`${OBEY}/conversation-box.html`, 'tool__cbox-firstmove')}
          target="_blank"
          rel="noopener"
          data-ecosystem-cta
          data-cta-level="tool"
          data-cta-type="obeytools"
          data-destination-site="obeytools"
        >Take the First Step <span class="st-ext">&#8599;</span></a>
      </p>
    </div>
  </section>

  <!-- 8. FINAL — two paths only: tools, then practice. -->
  <section class="st-final" aria-labelledby="st-final-h">
    <div class="st-final__inner">
      <h2 id="st-final-h" class="st-visually-hidden">Take your next step</h2>
      <div class="st-final__grid">
        <div class="st-final__card st-final__card--primary">
          <h3>Use the Tools</h3>
          <p>Open the disciple-making toolbox and take your next step.</p>
          <a
            class="button"
            href={utm(`${OBEY}/`, 'toolbox__final')}
            target="_blank"
            rel="noopener"
            data-ecosystem-cta
            data-cta-level="tool"
            data-cta-type="obeytools"
            data-destination-site="obeytools"
          >Open Obey.Tools <span class="st-ext">&#8599;</span></a>
        </div>
        <div class="st-final__card">
          <h3>Practice With Others</h3>
          <p>Join live coaching and a community of people learning through real obedience.</p>
          <a
            class="button button--secondary"
            href={utm(COVO_COMMUNITY_URL, 'community__final')}
            target="_blank"
            rel="noopener"
            data-ecosystem-cta
            data-cta-level="community"
            data-cta-type="covo-community"
            data-destination-site="covo"
          >Join the Practice Community <span class="st-ext">&#8599;</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- 1. Hero --------------------------------------------------- */
  .st-hero {
    padding: 5.5rem 1.25rem 4rem;
    text-align: center;
    background: var(--color-bg);
  }
  .st-hero__inner { max-width: 42rem; margin: 0 auto; }
  .st-hero h1 {
    max-width: 20ch;
    margin: 0 auto 1.4rem;
    font-size: var(--fs-h1);
    line-height: 1.08;
    color: var(--color-primary);
  }
  .st-hero__subhead {
    max-width: 34rem;
    margin: 0 auto 2.25rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .st-hero__cta { margin: 0; }
  .st-hero__cta .button { padding: 0.95rem 2.3rem; font-size: 1.1rem; font-weight: 700; }

  /* --- 2. Pathway overview --------------------------------------- */
  .st-path {
    padding: 3rem 1.25rem 3.5rem;
    background: var(--color-primary);
  }
  .st-path__list {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .st-path__step {
    position: relative;
    padding: 0 1rem;
    text-align: center;
    color: var(--color-primary-text);
  }
  /* connector arrows between the three steps (desktop) */
  .st-path__step:not(:last-child)::after {
    content: '\2192';
    position: absolute;
    top: 0.5rem;
    right: -0.9rem;
    color: var(--color-gold);
    font-size: 1.5rem;
    font-weight: 700;
  }
  .st-path__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.85rem;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .st-path__step h2 {
    margin: 0 0 0.5rem;
    font-size: var(--fs-card-title);
    color: var(--color-primary-text);
  }
  .st-path__step p {
    margin: 0 auto;
    max-width: 22rem;
    font-size: var(--fs-support);
    line-height: 1.5;
    color: rgba(247, 243, 234, 0.85);
  }

  @media (max-width: 720px) {
    .st-path__list { grid-template-columns: 1fr; gap: 1.75rem; max-width: 24rem; }
    .st-path__step:not(:last-child)::after {
      content: '\2193';
      top: auto; bottom: -1.35rem; right: 50%; transform: translateX(50%);
    }
  }

  /* --- 3-6. Stages ---------------------------------------------- */
  .st-stage { padding: 5rem 1.5rem; }
  .st-stage--paper { background: var(--color-bg); }
  .st-stage--sage { background: var(--color-surface); }

  .st-stage__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "intro visual"
      "actions visual";
    column-gap: 3rem;
    row-gap: 1rem;
    align-items: start;
  }
  .st-stage__intro { grid-area: intro; align-self: end; }
  .st-stage__actions { grid-area: actions; align-self: start; }
  .st-stage__visual { grid-area: visual; align-self: center; }

  /* alternate: visual on the left for the reversed stage (desktop only) */
  @media (min-width: 861px) {
    .st-stage--reverse .st-stage__inner {
      grid-template-areas:
        "visual intro"
        "visual actions";
    }
  }

  .st-stage__kicker {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-clay-text);
  }
  .st-stage__intro h2 {
    margin: 0 0 1rem;
    font-size: var(--fs-h2);
    line-height: 1.15;
    color: var(--color-primary);
  }
  .st-stage__intro > p:not(.st-stage__kicker) {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink);
  }

  .st-do {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    display: inline-block;
    background: #ffffff;
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-button);
    font-weight: 700;
    color: var(--color-primary);
  }
  .st-stage--sage .st-do { background: var(--color-bg); }

  .st-stage__cta { margin: 0 0 1.5rem; }
  .st-stage__cta .button { padding: 0.9rem 1.9rem; font-weight: 700; }
  .st-ext { font-size: 0.85em; }

  .st-support {
    margin: 0 0 0.75rem;
    font-size: var(--fs-support);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .st-support strong { color: var(--color-ink); }
  .st-support a { color: var(--color-accent-hover); white-space: nowrap; }

  .st-progression {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-clay-text);
  }

  /* Tool preview frames — real Obey.Tools UI in a light browser frame. */
  .st-stage__visual { display: flex; flex-direction: column; gap: 1.25rem; }
  .st-frame {
    margin: 0;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--fm-shadow);
    overflow: hidden;
  }
  .st-frame__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    background: #f0ece2;
    border-bottom: 1px solid var(--color-border);
  }
  .st-frame__bar i {
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: var(--color-border);
  }
  .st-frame__bar em {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.72rem;
    color: var(--color-text-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .st-frame img { display: block; width: 100%; height: auto; }
  /* the small secondary tool preview reads as supporting, not equal */
  .st-frame--small { max-width: 22rem; align-self: flex-start; }
  .st-stage--reverse .st-frame--small { align-self: flex-end; }
  /* plain frame for the 3 Circles diagram (no browser chrome) */
  .st-frame--plain { padding: 1.5rem 1.5rem 1rem; text-align: center; }
  .st-frame--plain img { max-width: 26rem; margin: 0 auto; }
  .st-frame--plain figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .st-stage { padding: 3.5rem 1.25rem; }
    /* Mobile stack order: heading + copy -> tool visual -> action + CTA */
    .st-stage__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "intro"
        "visual"
        "actions";
      row-gap: 1.75rem;
    }
    .st-stage__intro, .st-stage__actions, .st-stage__visual { align-self: auto; }
    .st-frame--small { max-width: 20rem; align-self: center !important; }
    .st-frame--plain img { max-width: 20rem; }
  }

  /* --- 5. Coaching interruption --------------------------------- */
  .st-coach {
    padding: 4.5rem 1.5rem;
    text-align: center;
    background: var(--color-primary);
  }
  .st-coach__inner { max-width: 40rem; margin: 0 auto; }
  .st-coach h2 {
    margin: 0 0 1rem;
    font-size: var(--fs-h2);
    line-height: 1.15;
    color: var(--color-primary-text);
