---
// Homepage. Real content ported from the live WordPress "Home" page
// (post_id 4788, post_name "main-home") via the WordPress export XML,
// lightly cleaned up. See MIGRATION_PLAN.md for what "lightly cleaned
// up" means here.
//
// Layout follows the approved block-grid mockup: hero (unchanged),
// edge-to-edge 2-column grid of true 1:1 square cards, labs CTA on a
// warm gradient, full-width "From the Field" quote band, two-column
// FAQ, footer. No distressed textures anywhere — clean surfaces only,
// per the mockup direction.
//
// The labs CTA fetches CoVo Multipliers' next 3 upcoming labs
// client-side from their public-labs Edge Function (see
// src/lib/labs-feed.js) — the single source of truth for lab data, also
// used by CoVo's own homepage — so it stays in sync as labs are
// added/removed on their end without a rebuild here.
import BaseLayout from '../layouts/BaseLayout.astro';
import CovoMark from '../components/CovoMark.astro';
import { COVO_LABS_URL, COVO_HOME_URL } from '../data/site';
---

<BaseLayout
  title="Multiplying Disciples"
  description="Every believer needs to be equipped to share the gospel, disciple others and start churches. Get tools and training to multiply disciples and reach the lost."
  canonical="https://multiplyingdisciples.us/"
  type="website"
>
  <section class="hero">
    <div class="hero__inner">
      <h1>Multiply disciples in real life.</h1>
      <p class="hero__subhead">
        Get field-tested tools and ongoing coaching <strong>that push you to act.</strong>
      </p>
      <img
        class="hero__badge-img"
        src="/wp-content/uploads/2023/05/Copy-of-Experience-confidence-in-your-disciple-making-1.png"
        alt=""
        width="1000"
        height="100"
      />
      <p class="hero__ctas">
        <a
          class="button"
          href={COVO_LABS_URL}
          data-ecosystem-cta
          data-cta-level="level_3"
          data-cta-type="covo_training"
          data-destination-site="covo"
        >
          Start Training
        </a>
        <a class="button button--secondary" href="/contact-us/">Connect</a>
      </p>
      <p class="hero__secondary">
        New here? <a href="/start-here/">Start Here</a> to see the simple tools first.
      </p>
    </div>
  </section>

  <!-- Edge-to-edge block grid: 2 columns of true 1:1 square cards on
       desktop, stacked on mobile. DOM order pairs each text card with
       its image (text left, image right per row) and reads correctly
       when stacked: coaching copy, video, NA methods, women talking,
       community momentum, group praying. -->
  <section class="block-grid" aria-label="Why coaching">
    <!-- Card 1: main coaching copy -->
    <div class="block-grid__cell block-grid__cell--text block-grid__cell--green">
      <h2>
        Disciple making resources and tools can be found everywhere. Resources without
        coaching will never get you to multiplication.
      </h2>
      <p>
        Let's be honest: we've all Googled disciple-making resources or looked up YouTube
        videos and found them helpful. But you either don't know how to start or the tools
        you tried "haven't worked" to multiply disciples, leaders, and churches. It's not
        the tools&hellip;
      </p>
      <p class="block-grid__punch">You need effective coaching.</p>
    </div>

    <!-- Card 2: video thumbnail -->
    <div class="block-grid__cell block-grid__cell--image">
      <img
        src="/wp-content/uploads/2025/03/maxresdefault-7-1024x576.jpg"
        alt="A man recording a disciple-making teaching video"
        width="1024"
        height="576"
        loading="lazy"
      />
    </div>

    <!-- Card 4: field-tested methods -->
    <div class="block-grid__cell block-grid__cell--text block-grid__cell--sage">
      <span class="block-grid__check" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </span>
      <h3>Learn what is working in North America.</h3>
      <p>
        Get methods that have been field tested by practitioners in North America. Know that
        the tools and process we share are <strong>not only Biblical, but fruitful.</strong>
      </p>
    </div>

    <!-- Card 3: two women talking -->
    <div class="block-grid__cell block-grid__cell--image">
      <img
        src="/wp-content/uploads/2025/01/Copy-of-Untitled-47-768x768.webp"
        alt="Two women talking and laughing together outdoors"
        width="768"
        height="768"
        loading="lazy"
      />
    </div>

    <!-- Card 5: community of practice -->
    <div class="block-grid__cell block-grid__cell--text block-grid__cell--paper">
      <span class="block-grid__check" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12.5l4.5 4.5L19 7.5" />
        </svg>
      </span>
      <h3>The momentum of a community of practice.</h3>
      <p>
        We bring together like-minded practitioners into training cohorts that are committed
        to action. <strong>Everyone benefits from that momentum.</strong>
      </p>
    </div>

    <!-- Card 6: small group praying -->
    <div class="block-grid__cell block-grid__cell--image">
      <img
        src="/wp-content/uploads/2025/01/Copy-of-Untitled-48-768x768.webp"
        alt="A group gathered in a home, praying over someone"
        width="768"
        height="768"
        loading="lazy"
      />
    </div>
  </section>

  <section class="labs-cta">
    <div class="labs-cta__inner">
      <p class="labs-cta__eyebrow">Ready to practice this?</p>
      <h2><CovoMark /> Join a live Multiplying Lab</h2>
      <p class="labs-cta__descriptor">Practical disciple-making labs for everyday leaders.</p>

      <div
        class="labs-cta__grid"
        id="labs-cta-grid"
        aria-live="polite"
        data-labs-content-tag="home__training__labs-grid"
      >
        <p class="labs-cta__loading">Loading upcoming labs&hellip;</p>
      </div>

      <p class="labs-cta__view-all">
        <a
          href={COVO_LABS_URL}
          data-ecosystem-cta
          data-cta-level="level_3"
          data-cta-type="covo_training"
          data-destination-site="covo"
        >View all upcoming labs &rarr;</a>
      </p>

      <p class="labs-cta__bridge">
        Labs are hosted through <a
          href={COVO_HOME_URL}
          data-ecosystem-cta
          data-cta-level="level_3"
          data-cta-type="covo_home"
          data-destination-site="covo"
        >Covo Multipliers</a>, where we practice simple tools for making disciples in real life.
      </p>

      <noscript>
        <p class="labs-cta__descriptor">
          See the current lab schedule and save your seat on Covo Multipliers.
        </p>
      </noscript>
    </div>
  </section>

  <section class="field-quote">
    <div class="field-quote__inner">
      <p class="field-quote__eyebrow">From the Field</p>
      <span class="field-quote__mark" aria-hidden="true">&ldquo;</span>
      <blockquote class="field-quote__quote">
        <p>
          &ldquo;Going through this with other practitioners made it feel real, not theory.
          Something is actually happening now.&rdquo;
        </p>
        <footer>&mdash; Marcus T</footer>
      </blockquote>
      <img
        class="field-quote__faces"
        src="/images/labs-social-proof.webp"
        alt="Practitioners who have gone through a Multiplying Lab"
        width="695"
        height="150"
        loading="lazy"
      />
    </div>
  </section>

  <section class="faq-section">
    <div class="faq-section__inner">
      <div class="faq-section__label">
        <p class="faq-section__eyebrow">Common Questions</p>
        <h2>FAQ</h2>
      </div>

      <div class="faq-section__items">
        <details class="faq__item">
          <summary>What is the purpose of the disciple making training?</summary>
          <p>
            The purpose of our disciple making training and coaching is to equip and empower
            individuals to become effective disciple makers who can multiply disciples and reach
            the lost. The reality is, the process of training matters and equips disciple makers
            to equip others in both confidence and competence. We believe in cultivating a
            movement of disciple makers who are passionate about sharing the Gospel and making
            disciples.
          </p>
        </details>

        <details class="faq__item">
          <summary>Why is coaching important in the process of disciple making?</summary>
          <p>
            Coaching within a community of practice plays a crucial role in disciple making as it
            provides personalized guidance, support, and accountability. Growth happens through
            both challenge and support. Our training includes coaching from experienced
            practitioners who have seen fruitful results in their own disciple making efforts.
            They will walk alongside you, offering insights, answering questions, and helping you
            navigate challenges along the way.
          </p>
        </details>

        <details class="faq__item">
          <summary>Is the training completely free, or are there any hidden costs involved?</summary>
          <p>
            Yes, the training we offer is completely free of charge. Always. There are no hidden
            costs or fees associated with participating in the training. Our goal is to make
            high-quality disciple making resources and coaching accessible to all who have a
            passion for reaching and discipling people for Jesus.
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { renderLabsInto } from '../lib/labs-feed.js';

  const grid = document.getElementById('labs-cta-grid');
  if (grid) {
    renderLabsInto(grid, 3, 'Join This Lab', grid.dataset.labsContentTag);
  }
</script>

<style>
  .hero {
    text-align: center;
    background-image: url('/wp-content/uploads/home/Untitled-design-52.webp');
    background-size: cover;
    background-position: center 38%;
    background-repeat: no-repeat;
    padding: 1.25rem 1.25rem 24rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding-bottom: 20rem;
      background-position: center 28%;
    }
  }

  .hero__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .hero__subhead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .hero__badge-img {
    max-width: 22rem;
    margin: 0.25rem auto 1rem;
  }

  .hero__ctas {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0;
  }

  .hero__secondary {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  /* --- Edge-to-edge 1:1 block grid ------------------------------- */

  .block-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  /* Every cell is a true square; if a text cell's content ever
     outgrows the square, the cell (and its row) grows and the paired
     image simply covers the taller cell — no clipped copy. */
  .block-grid__cell {
    aspect-ratio: 1 / 1;
  }

  .block-grid__cell--image {
    position: relative;
    overflow: hidden;
  }

  .block-grid__cell--image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .block-grid__cell--text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(1.75rem, 5vw, 4.5rem);
  }

  .block-grid__cell--green {
    background: var(--color-primary);
    color: var(--color-primary-text);
  }

  .block-grid__cell--sage {
    background: var(--color-surface);
  }

  .block-grid__cell--paper {
    background: var(--color-bg);
  }

  .block-grid__cell--text h2 {
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    line-height: 1.35;
    margin: 0 0 1rem;
  }

  .block-grid__cell--text h3 {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.25;
    margin: 0 0 0.85rem;
  }

  .block-grid__cell--text p {
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.6;
    margin: 0;
  }

  .block-grid__cell--green p {
    color: rgba(247, 243, 234, 0.88);
  }

  .block-grid__cell--sage p,
  .block-grid__cell--paper p {
    color: var(--color-text-muted);
  }

  /* Brightened clay for small emphasis text on the dark green card —
     the brand #bd5a22 only hits 2.2:1 there; this passes WCAG AA. */
  .block-grid__punch {
    margin-top: 1rem !important;
    font-weight: 700;
    font-style: italic;
    color: #f09e63 !important;
  }

  .block-grid__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.1rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: #ffffff;
    flex-shrink: 0;
  }

  @media (max-width: 800px) {
    .block-grid {
      grid-template-columns: 1fr;
    }

    /* Stacked: images stay square, text cards take their natural
       height so long copy never gets cramped into a forced square. */
    .block-grid__cell--text {
      aspect-ratio: auto;
      padding: 2.5rem 1.5rem;
    }
  }

  /* --- "From the Field" quote band ------------------------------- */

  .field-quote {
    background: var(--color-primary);
    padding: 3.5rem 1.5rem;
  }

  .field-quote__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .field-quote__eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    /* Brightened gold: #d8a642 is 4.43:1 on this green, just under AA;
       this variant passes for small caps text. */
    color: #ddae50;
  }

  .field-quote__mark {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 4.5rem;
    line-height: 0.5;
    color: #ddae50;
    flex-shrink: 0;
    transform: translateY(0.35rem);
  }

  .field-quote__quote {
    margin: 0;
    flex: 1;
  }

  .field-quote__quote p {
    margin: 0;
    font-size: 1rem;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-primary-text);
  }

  .field-quote__quote footer {
    margin-top: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #ddae50;
  }

  .field-quote__faces {
    width: clamp(220px, 24vw, 300px);
    height: auto;
    flex-shrink: 0;
  }

  @media (max-width: 800px) {
    .field-quote__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .field-quote__mark {
      display: none;
    }

    .field-quote__faces {
      align-self: center;
    }
  }

  /* --- FAQ ---------------------------------------------------------- */

  .faq-section {
    padding: 4rem 1.5rem 4.5rem;
  }

  .faq-section__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .faq-section__eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-clay-text);
  }

  .faq-section__label h2 {
    margin: 0;
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1;
  }

  .faq-section__items {
    display: grid;
    gap: 1rem;
  }

  .faq__item {
    padding: 1.1rem 1.4rem;
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  /* Closed-by-default accordion — reuses the same <details>/<summary>
     chevron convention as the header's Resources dropdown
     (Header.astro) so the affordance is consistent site-wide. */
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '';
    flex-shrink: 0;
    width: 0.5em;
    height: 0.5em;
    border-right: 2px solid var(--color-gold-text);
    border-bottom: 2px solid var(--color-gold-text);
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.15s ease;
  }

  .faq__item[open] summary::after {
    transform: rotate(-135deg) translateY(2px);
  }

  .faq__item p {
    margin: 0.75rem 0 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .faq-section__inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
