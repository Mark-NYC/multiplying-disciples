---
// Homepage. Real content ported from the live WordPress "Home" page
// (post_id 4788, post_name "main-home") via the WordPress export XML,
// lightly cleaned up. See MIGRATION_PLAN.md for what "lightly cleaned
// up" means here.
//
// The closing CTA fetches CoVo Multipliers' next 3 upcoming labs
// client-side straight from their public Supabase REST API (the same
// anon-key pattern CoVo's own cross-site embed widget uses), so it
// stays in sync as labs are added/removed on their end without a
// rebuild here. See the <script> below for the fetch/render logic.
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  COVO_LABS_URL,
  COVO_HOME_URL,
  COVO_SUPABASE_URL,
  COVO_SUPABASE_ANON_KEY,
  COVO_SUBSCRIBE_FUNCTION_URL,
} from '../data/site';
---

<BaseLayout
  title="Multiplying Disciples"
  description="Every believer needs to be equipped to share the gospel, disciple others and start churches. Get tools and training to multiply disciples and reach the lost."
  canonical="https://multiplyingdisciples.us/"
  type="website"
>
  <section class="hero">
    <div class="hero__inner">
      <h1>Multiply disciples in real life.</h1>
      <p class="hero__subhead">
        Get field-tested tools and ongoing coaching <strong>that push you to act.</strong>
      </p>
      <img
        class="hero__badge-img"
        src="/wp-content/uploads/2023/05/Copy-of-Experience-confidence-in-your-disciple-making-1.png"
        alt=""
        width="1000"
        height="100"
      />
      <p class="hero__ctas">
        <a class="button" href={COVO_LABS_URL}>Start Training</a>
        <a class="button button--secondary" href="/contact-us/">Connect</a>
      </p>
      <p class="hero__secondary">
        New here? <a href="/start-here/">Start Here</a> to see the simple tools first.
      </p>
    </div>
  </section>

  <div class="page-container page-container--wide">
    <section>
      <h2>
        Disciple making resources and tools can be found everywhere. Resources without
        coaching will never get you to multiplication.
      </h2>
      <p>
        Let's be honest: we've all Googled disciple-making resources or looked up YouTube
        videos and found them helpful. But you either don't know how to start or the tools
        you tried "haven't worked" to multiply disciples, leaders, and churches. It's not
        the tools&hellip;
      </p>
      <p><em>You need effective coaching.</em></p>
    </section>

    <section class="feature-row">
      <div class="feature-badge">
        <span class="feature-badge__icon" aria-hidden="true">&check;</span>
        <p class="feature-badge__text">Learn what is working in North America.</p>
      </div>
      <p>
        Get methods that have been field tested by practitioners in North America. Know that
        the tools and process we share are <strong>not only Biblical, but fruitful.</strong>
      </p>
    </section>

    <section class="feature-row">
      <div class="feature-badge">
        <span class="feature-badge__icon" aria-hidden="true">&check;</span>
        <p class="feature-badge__text">The momentum of a community of practice.</p>
      </div>
      <p>
        We bring together like-minded practitioners into training cohorts that are committed
        to action. <strong>Everyone benefits from that momentum.</strong>
      </p>
    </section>

    <section class="faq">
      <div class="faq__item">
        <h3>What is the purpose of the disciple making training?</h3>
        <p>
          The purpose of our disciple making training and coaching is to equip and empower
          individuals to become effective disciple makers who can multiply disciples and reach
          the lost. The reality is, the process of training matters and equips disciple makers
          to equip others in both confidence and competence. We believe in cultivating a
          movement of disciple makers who are passionate about sharing the Gospel and making
          disciples.
        </p>
      </div>

      <div class="faq__item">
        <h3>Why is coaching important in the process of disciple making?</h3>
        <p>
          Coaching within a community of practice plays a crucial role in disciple making as it
          provides personalized guidance, support, and accountability. Growth happens through
          both challenge and support. Our training includes coaching from experienced
          practitioners who have seen fruitful results in their own disciple making efforts.
          They will walk alongside you, offering insights, answering questions, and helping you
          navigate challenges along the way.
        </p>
      </div>

      <div class="faq__item">
        <h3>Is the training completely free, or are there any hidden costs involved?</h3>
        <p>
          Yes, the training we offer is completely free of charge. Always. There are no hidden
          costs or fees associated with participating in the training. Our goal is to make
          high-quality disciple making resources and coaching accessible to all who have a
          passion for reaching and discipling people for Jesus.
        </p>
      </div>
    </section>

    <section class="explore">
      <h2>Explore the library</h2>
      <p class="explore__links">
        <a href="/disciple-making/">Disciple Making</a>
        <a href="/share-the-gospel/">Share the Gospel</a>
        <a href="/testimony/">Testimony</a>
        <a href="/church-planting-movements/">Church Planting Movements</a>
        <a href="/starter-tools/">Starter Tools</a>
        <a href="/vision/">Our Vision</a>
      </p>
    </section>

    <section class="labs-cta">
      <p class="labs-cta__eyebrow">Ready to practice this?</p>
      <h2>Join a live Multiplying Lab</h2>
      <p class="labs-cta__intro">
        Learn the tool. Practice it. Leave with a next step for real people in your life.
      </p>

      <div class="labs-cta__grid" id="labs-cta-grid" aria-live="polite">
        <p class="labs-cta__loading">Loading upcoming labs&hellip;</p>
      </div>

      <p class="labs-cta__actions">
        <a class="button button--secondary" href={COVO_LABS_URL}>View all labs</a>
      </p>

      <p class="labs-cta__bridge">
        Labs are hosted live through <a href={COVO_HOME_URL}>Covo Multipliers</a>, our training
        partner for practical, tool-based coaching.
      </p>

      <noscript>
        <p class="labs-cta__intro">
          See the current lab schedule and save your seat on Covo Multipliers.
        </p>
      </noscript>
    </section>
  </div>
</BaseLayout>

<script
  define:vars={{
    SUPABASE_URL: COVO_SUPABASE_URL,
    SUPABASE_ANON_KEY: COVO_SUPABASE_ANON_KEY,
    LABS_URL: COVO_LABS_URL,
    SUBSCRIBE_URL: COVO_SUBSCRIBE_FUNCTION_URL,
  }}
>
  const grid = document.getElementById('labs-cta-grid');

  function formatDate(iso) {
    return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function renderLabs(labs) {
    grid.innerHTML = labs
      .map((lab) => {
        const status = lab.has_availability
          ? `${lab.seats_remaining} seat${lab.seats_remaining === 1 ? '' : 's'} left`
          : 'Full';
        const ctaLabel = lab.has_availability ? 'Reserve Your Seat' : 'Join the Waitlist';
        const description = lab.description
          ? `<p class="lab-card__description">${escapeHtml(lab.description)}</p>`
          : '';
        return `
          <div class="lab-card">
            <p class="lab-card__meta">${formatDate(lab.event_date)} &middot; ${status}</p>
            <h3 class="lab-card__title">${escapeHtml(lab.title)}</h3>
            ${description}
            <a class="button lab-card__cta" href="${LABS_URL}">${ctaLabel}</a>
          </div>
        `;
      })
      .join('');
  }

  function renderNotifyForm() {
    grid.innerHTML = `
      <div class="lab-card lab-card--signup">
        <h3 class="lab-card__title">New labs are on the way</h3>
        <p class="lab-card__description">Get notified when the next lab opens.</p>
        <form id="labs-notify-form" class="lab-card__form">
          <input
            id="labs-notify-email"
            type="email"
            name="email"
            aria-label="Email address"
            placeholder="you@example.com"
            required
          />
          <button type="submit" class="button">Get notified</button>
        </form>
        <p id="labs-notify-status" class="lab-card__status" role="status"></p>
      </div>
    `;

    const form = document.getElementById('labs-notify-form');
    const status = document.getElementById('labs-notify-status');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = document.getElementById('labs-notify-email').value.trim();
      const button = form.querySelector('button');
      button.disabled = true;
      status.textContent = '';

      try {
        const res = await fetch(SUBSCRIBE_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            landing_page: window.location.href,
            referrer: document.referrer || null,
            utm_source: 'multiplyingdisciples',
            utm_medium: 'homepage_cta',
            utm_campaign: 'labs_notify',
          }),
        });
        if (!res.ok) throw new Error('request failed');
        form.hidden = true;
        status.textContent = "You're on the list — we'll email you when the next lab opens.";
      } catch (err) {
        status.textContent = 'Something went wrong. Please try again.';
        button.disabled = false;
      }
    });
  }

  async function loadLabs() {
    try {
      const url = new URL(`${SUPABASE_URL}/rest/v1/events_with_availability`);
      url.searchParams.set(
        'select',
        'slug,title,description,event_date,seats_remaining,has_availability'
      );
      url.searchParams.set('event_date', `gte.${new Date().toISOString()}`);
      url.searchParams.set('order', 'event_date.asc');
      url.searchParams.set('limit', '3');

      const res = await fetch(url, {
        headers: { apikey: SUPABASE_ANON_KEY, Authorization: `Bearer ${SUPABASE_ANON_KEY}` },
      });
      if (!res.ok) throw new Error('request failed');

      const labs = await res.json();
      if (Array.isArray(labs) && labs.length > 0) {
        renderLabs(labs);
      } else {
        renderNotifyForm();
      }
    } catch (err) {
      renderNotifyForm();
    }
  }

  loadLabs();
</script>

<style>
  .hero {
    text-align: center;
    background-image: url('/wp-content/uploads/home/Untitled-design-52.webp');
    background-size: cover;
    background-position: center 38%;
    background-repeat: no-repeat;
    padding: 1.25rem 1.25rem 24rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding-bottom: 20rem;
      background-position: center 28%;
    }
  }

  .hero__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .hero__subhead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .hero__badge-img {
    max-width: 22rem;
    margin: 0.25rem auto 1rem;
  }

  .hero__ctas {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0;
  }

  .hero__secondary {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .feature-row {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
  }

  .feature-row p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .faq {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
  }

  .faq__item {
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .faq__item h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .faq__item p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .explore {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .explore h2 {
    font-size: 1.1rem;
  }

  .explore__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
</style>
