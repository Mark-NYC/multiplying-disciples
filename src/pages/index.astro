---
// Homepage. Real content ported from the live WordPress "Home" page
// (post_id 4788, post_name "main-home") via the WordPress export XML,
// lightly cleaned up. See MIGRATION_PLAN.md for what "lightly cleaned
// up" means here.
//
// One deliberate simplification: the live page embeds a third-party
// Supabase-backed "next lab" widget (live JS pulling the next open
// CoVo Multipliers training slot). That's out of scope for a static
// Astro migration in Phase 1 — instead this uses the widget's own
// documented fallback copy/link (verbatim from its source), which
// points to the same destination it would show when no lab data loads.
import BaseLayout from '../layouts/BaseLayout.astro';
import { COVO_LABS_URL } from '../data/site';
---

<BaseLayout
  title="Multiplying Disciples"
  description="Every believer needs to be equipped to share the gospel, disciple others and start churches. Get tools and training to multiply disciples and reach the lost."
  canonical="https://multiplyingdisciples.us/"
  type="website"
>
  <section class="hero">
    <div class="hero__inner">
      <h1>Multiply disciples in real life.</h1>
      <p class="hero__subhead">
        Get field-tested tools and ongoing coaching <strong>that push you to act.</strong>
      </p>
      <img
        class="hero__badge-img"
        src="/wp-content/uploads/2023/05/Copy-of-Experience-confidence-in-your-disciple-making-1.png"
        alt=""
        width="1000"
        height="100"
      />
      <p class="hero__ctas">
        <a class="button" href={COVO_LABS_URL}>Start Training</a>
        <a class="button button--secondary" href="/contact-us/">Connect</a>
      </p>
      <p class="hero__secondary">
        New here? <a href="/start-here/">Start Here</a> to see the simple tools first.
      </p>
    </div>
  </section>

  <div class="page-container page-container--wide">
    <section>
      <h2>
        Disciple making resources and tools can be found everywhere. Resources without
        coaching will never get you to multiplication.
      </h2>
      <p>
        Let's be honest: we've all Googled disciple-making resources or looked up YouTube
        videos and found them helpful. But you either don't know how to start or the tools
        you tried "haven't worked" to multiply disciples, leaders, and churches. It's not
        the tools&hellip;
      </p>
      <p><em>You need effective coaching.</em></p>
    </section>

    <section class="feature-row">
      <div class="feature-badge">
        <span class="feature-badge__icon" aria-hidden="true">&check;</span>
        <p class="feature-badge__text">Learn what is working in North America.</p>
      </div>
      <p>
        Get methods that have been field tested by practitioners in North America. Know that
        the tools and process we share are <strong>not only Biblical, but fruitful.</strong>
      </p>
    </section>

    <section class="feature-row">
      <div class="feature-badge">
        <span class="feature-badge__icon" aria-hidden="true">&check;</span>
        <p class="feature-badge__text">The momentum of a community of practice.</p>
      </div>
      <p>
        We bring together like-minded practitioners into training cohorts that are committed
        to action. <strong>Everyone benefits from that momentum.</strong>
      </p>
    </section>

    <section class="faq">
      <div class="faq__item">
        <h3>What is the purpose of the disciple making training?</h3>
        <p>
          The purpose of our disciple making training and coaching is to equip and empower
          individuals to become effective disciple makers who can multiply disciples and reach
          the lost. The reality is, the process of training matters and equips disciple makers
          to equip others in both confidence and competence. We believe in cultivating a
          movement of disciple makers who are passionate about sharing the Gospel and making
          disciples.
        </p>
      </div>

      <div class="faq__item">
        <h3>Why is coaching important in the process of disciple making?</h3>
        <p>
          Coaching within a community of practice plays a crucial role in disciple making as it
          provides personalized guidance, support, and accountability. Growth happens through
          both challenge and support. Our training includes coaching from experienced
          practitioners who have seen fruitful results in their own disciple making efforts.
          They will walk alongside you, offering insights, answering questions, and helping you
          navigate challenges along the way.
        </p>
      </div>

      <div class="faq__item">
        <h3>Is the training completely free, or are there any hidden costs involved?</h3>
        <p>
          Yes, the training we offer is completely free of charge. Always. There are no hidden
          costs or fees associated with participating in the training. Our goal is to make
          high-quality disciple making resources and coaching accessible to all who have a
          passion for reaching and discipling people for Jesus.
        </p>
      </div>
    </section>

    <section class="explore">
      <h2>Explore the library</h2>
      <p class="explore__links">
        <a href="/disciple-making/">Disciple Making</a>
        <a href="/share-the-gospel/">Share the Gospel</a>
        <a href="/testimony/">Testimony</a>
        <a href="/church-planting-movements/">Church Planting Movements</a>
        <a href="/starter-tools/">Starter Tools</a>
        <a href="/vision/">Our Vision</a>
      </p>
    </section>

    <section class="cta-band">
      <h2>Get Hands-on Training on Zoom</h2>
      <p>Join our next 45-minute Multipliers Lab. New free labs are announced regularly — see the current schedule and save your seat for the next live session.</p>
      <div class="cta-band__actions">
        <a class="button" href={COVO_LABS_URL}>See Upcoming Labs</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    background-image: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.97) 0%,
        rgba(255, 255, 255, 0.94) 40%,
        rgba(255, 255, 255, 0.7) 60%,
        rgba(255, 255, 255, 0.15) 80%
      ),
      url('/wp-content/uploads/home/Untitled-design-52.webp');
    background-size: cover;
    background-position: center 38%;
    background-repeat: no-repeat;
    padding: 1.25rem 1.25rem 24rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding-bottom: 20rem;
      background-position: center 28%;
    }
  }

  .hero__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .hero__subhead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .hero__badge-img {
    max-width: 22rem;
    margin: 0.25rem auto 1rem;
  }

  .hero__ctas {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0;
  }

  .hero__secondary {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .feature-row {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
  }

  .feature-row p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .faq {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
  }

  .faq__item {
    padding: 1.25rem 1.5rem;
    background: var(--color-surface);
    border-radius: var(--radius-card);
  }

  .faq__item h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .faq__item p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .explore {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .explore h2 {
    font-size: 1.1rem;
  }

  .explore__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
</style>
