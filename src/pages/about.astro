---
// About / "Ordinary Christians can make disciples" — the site's About
// page, the destination behind the "About" nav slot (see navigation.ts /
// Footer.astro). Replaces the old placeholder that pointed at the /vision/
// theology article; that article still lives at /vision/ unchanged.
//
// Uses the homepage visual system wholesale — shared color tokens,
// monospace eyebrows, full-bleed photo hero with a green overlay (the
// kingdom-ministry-training precedent), Primary Green conviction bands, a
// Soft Sage core-convictions grid, the numbered three-step pathway, and
// the gold-ruled final band. No new design language, no new tokens.
//
// The primary journey stays focused: Start Here (/starter-tools/),
// Obey.Tools, the Lab (/#ch-practice — the homepage's own dynamic
// next-lab section, the single funnel point for every lab CTA on the
// site; see the note in navigation.ts), and the tribe/community. The
// founder bio is plain prose on purpose — no résumé links out — so the
// visitor and the mission stay central.
//
// Founder photo: public/images/mark-goering-nyc.jpg (Mark and his wife
// Megan in NYC), copied from the covo-multipliers repo — a real, natural
// photo, never stock. Hero photo reuses the brand's NYC basketball-court
// disciple-making image.
//
// Keep the search entry in src/pages/search-index.json.ts in sync with
// this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import { imageDimensions } from '../lib/image-dimensions.mjs';

const OBEY = 'https://obey.tools';
const CAMPAIGN = 'about_page';

// Cross-domain UTM (page-slug + level + placement), matching the
// convention in ECOSYSTEM_GROWTH_STRATEGY.md. Same-domain anchors never
// get UTMs. Query precedes any #fragment.
function utm(href: string, content: string): string {
  const params = new URLSearchParams({
    utm_source: 'multiplyingdisciples',
    utm_medium: 'organic_cta',
    utm_campaign: CAMPAIGN,
    utm_content: `about__${content}`,
  });
  const h = href.indexOf('#');
  const base = h === -1 ? href : href.slice(0, h);
  const frag = h === -1 ? '' : href.slice(h);
  return `${base}${base.includes('?') ? '&' : '?'}${params.toString()}${frag}`;
}

const founder = { src: '/images/mark-goering-nyc.jpg', ...imageDimensions('/images/mark-goering-nyc.jpg') };

const CONVICTIONS = [
  'Every follower of Jesus can make disciples.',
  'Disciple-making begins with obedience, not expertise.',
  'The best tools are simple enough to reproduce.',
  'Training is incomplete until it becomes practice.',
  'Churches can begin wherever disciples gather and obey Jesus together.',
  'Healthy disciples multiply disciples, leaders, and churches.',
  'Coaching and community help people stay in the game.',
  'Local obedience matters more than platform growth.',
  'The goal is generational fruit that outlives us.',
];
---

<BaseLayout
  title="About | Multiplying Disciples"
  description="Multiplying Disciples helps ordinary Christians move from learning about disciple-making to actually making disciples — through simple tools, real practice, coaching, and a community of practitioners."
  canonical="https://multiplyingdisciples.us/about/"
  ogImage="/wp-content/uploads/home/Untitled-design-52.webp"
  type="website"
>
  <!-- 1. HERO — names the promise and offers one clear next step, with a
       lighter second path to the tools. -->
  <section class="ab-hero">
    <div class="ab-hero__inner">
      <p class="eyebrow eyebrow--gold-bright">About Multiplying Disciples</p>

      <h1>
        Ordinary Christians can{' '}
        <span class="fm-underline fm-underline--shape-a fm-underline--clay-text">make disciples</span>.
      </h1>

      <p class="ab-hero__subhead">
        Multiplying Disciples helps people move from learning about disciple-making to actually
        doing it — through simple tools, real-world practice, coaching, and a community of
        practitioners.
      </p>

      <p class="ab-hero__cta">
        <a class="button" href="/starter-tools/">Start Making Disciples</a>
      </p>

      <p class="ab-hero__secondary">
        <a
          href={utm(`${OBEY}/`, 'hero__explore-tools')}
          target="_blank"
          rel="noopener"
          data-ecosystem-cta
          data-cta-level="tool"
          data-cta-type="obeytools"
          data-destination-site="obeytools"
        >Explore the Tools <span class="ab-ext">&#8599;</span></a>
      </p>
    </div>
  </section>

  <!-- 2. WHY THIS EXISTS — the gap, named, then the four things people
       actually need, as a clean four-part row. -->
  <section class="ab-why">
    <div class="ab-why__inner">
      <p class="eyebrow eyebrow--gold-text">Why This Exists</p>
      <h2>Most Christians do not need more information. They need a way to begin.</h2>

      <div class="ab-why__copy">
        <p>
          Many Christians have spent years in church but still do not feel equipped to share the
          gospel, disciple someone, or help a simple church begin.
        </p>
        <p>
          The problem is not a lack of sermons, books, or training events. People need simple tools
          they can use, practice in real life, coaching when they get stuck, and other practitioners
          who will stay in the game with them.
        </p>
        <p><strong>Multiplying Disciples exists to help close that gap.</strong></p>
      </div>

      <ul class="ab-needs" aria-label="What people actually need">
        <li class="ab-need">
          <p class="ab-need__label">Simple Tools</p>
          <p class="ab-need__text">Clear enough to use and reproduce.</p>
        </li>
        <li class="ab-need">
          <p class="ab-need__label">Real Practice</p>
          <p class="ab-need__text">Training becomes useful when it leads to obedience.</p>
        </li>
        <li class="ab-need">
          <p class="ab-need__label">Coaching</p>
          <p class="ab-need__text">Help applying the tools when real life gets messy.</p>
        </li>
        <li class="ab-need">
          <p class="ab-need__label">Tribe</p>
          <p class="ab-need__text">A community of practitioners learning and multiplying together.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- 3. WHAT WE ARE PURSUING — the goal, on a Primary Green band, with a
       simple generational progression. -->
  <section class="ab-pursuing">
    <div class="ab-pursuing__inner">
      <p class="eyebrow eyebrow--gold-bright">What We Are Pursuing</p>
      <h2>The goal is multiplication.</h2>
      <p class="ab-pursuing__body">
        We are not trying to build an audience around a ministry brand. We want to see ordinary
        people obey Jesus, make disciples, develop leaders, and start churches that multiply across
        generations.
      </p>

      <ol class="ab-progression" aria-label="Disciples to leaders to churches to generations">
        <li>Disciples</li>
        <li>Leaders</li>
        <li>Churches</li>
        <li>Generations</li>
      </ol>

      <p class="ab-pursuing__note">
        The work is not finished when someone learns the tool. It is bearing fruit when they obey
        it, pass it on, and help others do the same.
      </p>
    </div>
  </section>

  <!-- 4. CORE CONVICTIONS — a brief two-column list, then one emphasized
       statement. Not a doctrinal statement. -->
  <section class="ab-convictions">
    <div class="ab-convictions__inner">
      <p class="eyebrow eyebrow--gold-text">Core Convictions</p>
      <h2>What shapes the work</h2>

      <ul class="ab-convictions__list">
        {CONVICTIONS.map((line) => (
          <li>{line}</li>
        ))}
      </ul>

      <p class="ab-convictions__emphasis">
        Be part of a church where you are trained. Start a church where people can practice what
        they are learning.
      </p>
    </div>
  </section>

  <!-- 5. FOUNDER — a natural photo of Mark (and Megan) in NYC beside a
       grounded bio. Credible guide, not a résumé. -->
  <section class="ab-founder">
    <div class="ab-founder__inner">
      <figure class="ab-founder__photo">
        <img
          src={founder.src}
          width={founder.width}
          height={founder.height}
          alt="Mark Goering with his wife, Megan, on a street in New York City"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Mark and Megan in New York City</figcaption>
      </figure>

      <div class="ab-founder__body">
        <p class="eyebrow eyebrow--clay">Meet the Founder</p>
        <h2>Mark Goering</h2>

        <p>
          Mark is a disciple-maker, church planter, and movement catalyst based in New York City. He
          has spent years helping ordinary Christians share the gospel, disciple new believers,
          develop leaders, and start simple churches in the places where they already live, work,
          and play.
        </p>
        <p>
          He founded Multiplying Disciples to give practitioners the simple tools, coaching, and
          community he wished more Christians had. His work is shaped by field experience in New York
          City, collaboration with disciple-makers across North America, and a conviction that
          Jesus&rsquo; methods are still simple enough for ordinary people to obey and reproduce.
        </p>
        <p>
          Mark also hosts the H3X podcast and helps lead CoVo Multipliers, a community for
          disciple-makers pursuing multiplication alongside ordinary work and family life.
        </p>
        <p>Mark lives in Queens with his wife, Megan, and their twin sons.</p>
      </div>
    </div>
  </section>

  <!-- 6. HOW TO BEGIN — the site's three-step pathway (learn / practice /
       find your tribe) with the primary and secondary next steps. -->
  <section class="ab-begin">
    <p class="eyebrow eyebrow--gold-text">How to Begin</p>
    <h2>You do not need to have it all figured out.</h2>
    <p class="ab-begin__subhead">
      Start where you are. Take one step, use what you learn, and let someone help you keep going.
    </p>

    <ol class="ab-begin__steps">
      <li class="ab-begin__step">
        <span class="ab-begin__num">Step 01</span>
        <h3>Learn</h3>
        <p>Use the practical tools to begin sharing the gospel and making disciples.</p>
      </li>
      <li class="ab-begin__step">
        <span class="ab-begin__num">Step 02</span>
        <h3>Practice</h3>
        <p>Join a live Lab and work through real disciple-making challenges with other practitioners.</p>
      </li>
      <li class="ab-begin__step">
        <span class="ab-begin__num">Step 03</span>
        <h3>Find Your Tribe</h3>
        <p>Stay connected to people who are practicing, learning, and multiplying over the long haul.</p>
      </li>
    </ol>

    <p class="ab-begin__ctas">
      <a class="button" href="/starter-tools/">Start Making Disciples</a>
      <a class="button button--secondary" href="/#ch-practice">Join the Next Lab</a>
    </p>
  </section>

  <!-- 7. FINAL LINE — the closing statement on a gold-ruled band. -->
  <section class="ab-final">
    <div class="ab-final__inner">
      <p>
        Multiplying Disciples was built by practitioners to help ordinary Christians move from
        learning about disciple-making to actually making disciples.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- 1. Hero — full-bleed photo + green overlay (kmt-hero
     precedent) ------------------------------------------------------- */
  .ab-hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 34rem;
    padding: 6rem 1.25rem 5rem;
    text-align: center;
    isolation: isolate;
    background:
      linear-gradient(
        180deg,
        rgba(12, 34, 28, 0.74) 0%,
        rgba(12, 34, 28, 0.6) 45%,
        rgba(12, 34, 28, 0.8) 100%
      ),
      url('/wp-content/uploads/home/Untitled-design-52.webp') center 42% / cover no-repeat;
  }

  .ab-hero__inner {
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
  }

  .ab-hero .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-gold-bright);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }

  .ab-hero h1 {
    max-width: 20ch;
    margin: 0 auto 1.5rem;
    font-size: var(--fs-h1);
    line-height: 1.06;
    color: #ffffff;
    text-wrap: balance;
    text-shadow:
      0 2px 6px rgba(0, 0, 0, 0.3),
      0 12px 32px rgba(0, 0, 0, 0.28);
  }

  .ab-hero h1 .fm-underline {
    color: #ffffff;
  }

  .ab-hero__subhead {
    max-width: 40rem;
    margin: 0 auto 2.25rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.94);
    text-wrap: balance;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.38);
  }

  .ab-hero__cta {
    margin: 0 0 1.25rem;
  }

  .ab-hero__cta .button {
    padding: 0.95rem 2.3rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-gold-bright);
    border-color: var(--color-gold-bright);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .ab-hero__cta .button:hover {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-primary);
  }

  .ab-hero__secondary {
    margin: 0;
    font-size: var(--fs-support);
  }

  .ab-hero__secondary a {
    color: #ffffff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  .ab-hero__secondary a:hover {
    color: var(--color-gold-bright);
  }

  .ab-ext {
    font-size: 0.85em;
  }

  @media (max-width: 640px) {
    .ab-hero {
      min-height: 32rem;
      padding: 4.75rem 1.25rem 4.25rem;
    }
    .ab-hero__subhead {
      max-width: 32rem;
    }
    .ab-hero__cta .button {
      display: block;
      width: 100%;
      max-width: 22rem;
      margin: 0 auto;
      text-align: center;
    }
  }

  /* --- 2. Why this exists ------------------------------------------- */
  .ab-why {
    padding: 5.5rem 1.5rem;
    background: var(--color-bg);
  }

  .ab-why__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    text-align: center;
  }

  .ab-why h2 {
    max-width: 24ch;
    margin: 0 auto 1.75rem;
    font-size: var(--fs-h2);
    line-height: 1.15;
    color: var(--color-primary);
  }

  .ab-why__copy {
    max-width: 42rem;
    margin: 0 auto 3.25rem;
  }

  .ab-why__copy p {
    margin: 0 0 1.1rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .ab-why__copy p:last-child {
    margin-bottom: 0;
  }

  .ab-why__copy strong {
    color: var(--color-primary);
  }

  /* Four simple cards, clean row. */
  .ab-needs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .ab-need {
    padding: 1.5rem 1.4rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--radius-card);
    box-shadow: var(--fm-shadow);
  }

  .ab-need__label {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-clay-text);
  }

  .ab-need__text {
    margin: 0;
    font-size: var(--fs-support);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .ab-needs {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 460px) {
    .ab-needs {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .ab-why {
      padding: 4rem 1.25rem;
    }
  }

  /* --- 3. What we are pursuing — Primary Green band ----------------- */
  .ab-pursuing {
    padding: 5rem 1.5rem;
    text-align: center;
    background: var(--color-primary);
  }

  .ab-pursuing__inner {
    max-width: 44rem;
    margin: 0 auto;
  }

  .ab-pursuing h2 {
    margin: 0 0 1.5rem;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-primary-text);
  }

  .ab-pursuing__body {
    max-width: 40rem;
    margin: 0 auto 2.5rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: rgba(247, 243, 234, 0.88);
  }

  /* Generational progression — pill row with arrow connectors, the same
     pattern as the starter-tools practice rhythm. */
  .ab-progression {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }

  .ab-progression li {
    display: flex;
    align-items: center;
    padding: 0.5rem 1.1rem;
    border: 1px solid rgba(247, 243, 234, 0.3);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-text);
  }

  .ab-progression li:not(:last-child)::after {
    content: '\2192';
    margin-left: 0.85rem;
    color: var(--color-gold-bright);
    font-size: 1.05rem;
  }

  .ab-pursuing__note {
    max-width: 40rem;
    margin: 0 auto;
    font-size: var(--fs-support);
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-primary-text);
  }

  @media (max-width: 640px) {
    .ab-pursuing {
      padding: 4rem 1.25rem;
    }
    /* Drop the inline arrows on the wrapped mobile layout so pills read
       cleanly stacked two-up instead of trailing a stray glyph. */
    .ab-progression li:not(:last-child)::after {
      display: none;
    }
  }

  /* --- 4. Core convictions — Soft Sage, two-column list ------------- */
  .ab-convictions {
    padding: 5.5rem 1.5rem;
    background: var(--color-surface);
  }

  .ab-convictions__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    text-align: center;
  }

  .ab-convictions h2 {
    margin: 0 0 2.5rem;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-primary);
  }

  .ab-convictions__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem 2.5rem;
    max-width: 52rem;
    margin: 0 auto 3rem;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .ab-convictions__list li {
    position: relative;
    padding: 0.35rem 0 0.35rem 1.6rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .ab-convictions__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .ab-convictions__emphasis {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1.75rem 2rem;
    background: var(--color-bg);
    border-left: 3px solid var(--color-gold);
    border-radius: var(--radius-card);
    font-size: var(--fs-card-title);
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-primary);
    text-align: left;
  }

  @media (max-width: 640px) {
    .ab-convictions {
      padding: 4rem 1.25rem;
    }
    .ab-convictions__list {
      grid-template-columns: 1fr;
      max-width: 30rem;
    }
  }

  /* --- 5. Founder -------------------------------------------------- */
  .ab-founder {
    padding: 5.5rem 1.5rem;
    background: var(--color-bg);
  }

  .ab-founder__inner {
    max-width: var(--site-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 3rem;
    align-items: center;
  }

  .ab-founder__photo {
    margin: 0;
  }

  .ab-founder__photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  .ab-founder__photo figcaption {
    margin-top: 0.75rem;
    font-style: italic;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .ab-founder__body h2 {
    margin: 0 0 1.25rem;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-primary);
  }

  .ab-founder__body p:not(.eyebrow) {
    margin: 0 0 1.1rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-ink);
  }

  .ab-founder__body p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 780px) {
    .ab-founder {
      padding: 4rem 1.25rem;
    }
    .ab-founder__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .ab-founder__photo {
      max-width: 22rem;
      margin: 0 auto;
    }
  }

  /* --- 6. How to begin — three-step pathway ------------------------ */
  .ab-begin {
    padding: 6rem 1.5rem 5.5rem;
    text-align: center;
    background: var(--color-surface);
  }

  .ab-begin > h2 {
    max-width: 20ch;
    margin: 0.4rem auto 1rem;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-primary);
  }

  .ab-begin__subhead {
    max-width: 36rem;
    margin: 0 auto 3.5rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .ab-begin__steps {
    max-width: var(--site-max-width);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .ab-begin__step {
    position: relative;
    padding: 0 0.75rem;
  }

  /* Connector arrows between steps (desktop). */
  .ab-begin__step:not(:last-child)::after {
    content: '\2192';
    position: absolute;
    top: 0.4rem;
    right: -1.15rem;
    color: var(--color-gold-text);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .ab-begin__num {
    display: block;
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-clay-text);
  }

  .ab-begin__step h3 {
    margin: 0 0 0.5rem;
    font-size: var(--fs-card-title);
    color: var(--color-primary);
  }

  .ab-begin__step p {
    margin: 0 auto;
    max-width: 22rem;
    font-size: var(--fs-support);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .ab-begin__ctas {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 3.5rem 0 0;
  }

  .ab-begin__ctas .button {
    padding: 0.9rem 2rem;
    font-size: 1.05rem;
