---
// About page: one clear explanation, one visual breath, one founder story.
// Keep the search entry in src/pages/search-index.json.ts in sync with this page.
import BaseLayout from '../layouts/BaseLayout.astro';
import { imageDimensions } from '../lib/image-dimensions.mjs';

const OBEY = 'https://obey.tools';
const CAMPAIGN = 'about_page';

function utm(href: string, content: string): string {
  const params = new URLSearchParams({
    utm_source: 'multiplyingdisciples',
    utm_medium: 'organic_cta',
    utm_campaign: CAMPAIGN,
    utm_content: `about__${content}`,
  });
  return `${href}${href.includes('?') ? '&' : '?'}${params.toString()}`;
}

const founder = {
  src: '/images/mark-goering-nyc.jpg',
  ...imageDimensions('/images/mark-goering-nyc.jpg'),
};
---

<BaseLayout
  title="About | Multiplying Disciples"
  description="Multiplying Disciples is a practical pathway that helps ordinary Christians move from learning about disciple-making to actually making disciples."
  canonical="https://multiplyingdisciples.us/about/"
  ogImage="/wp-content/uploads/home/Untitled-design-52.webp"
  type="website"
>
  <section class="ab-main">
    <div class="ab-main__inner">
      <header class="ab-intro">
        <p class="eyebrow eyebrow--gold-text">About Multiplying Disciples</p>
        <h1>
          A practical pathway for{' '}
          <span class="fm-underline fm-underline--shape-a fm-underline--clay-text">making disciples</span>.
        </h1>
        <p class="ab-intro__lead">
          Multiplying Disciples helps ordinary Christians move from learning about disciple-making
          to actually doing it.
        </p>
      </header>

      <div class="ab-story">
        <div class="ab-problem">
          <h2>Most disciple-making training stops too soon.</h2>
          <p class="ab-problem__medium">
            You attend a training, learn a few tools, and leave inspired. Then real life happens.
            You are not sure who to talk to, which tool to use, or what to do when someone responds.
          </p>
          <p>
            You do not need more information. You need a clear next step, practice using what you
            learn, and people who will help you keep going.
          </p>
        </div>

        <div class="ab-pathway" aria-labelledby="pathway-title">
          <p class="eyebrow eyebrow--clay">The Pathway</p>
          <h2 id="pathway-title">Tools, practice, and people in one clear pathway.</h2>

          <ol class="ab-pathway__steps">
            <li>
              <span class="ab-pathway__number">01</span>
              <div>
                <h3>Tools</h3>
                <p>Simple, biblical tools show you what to do and are easy to pass on.</p>
                <a
                  href={utm(`${OBEY}/`, 'pathway__tools')}
                  target="_blank"
                  rel="noopener"
                  data-ecosystem-cta
                  data-cta-level="tool"
                  data-cta-type="obeytools"
                  data-destination-site="obeytools"
                >Explore the Tools <span aria-hidden="true">&#8599;</span></a>
              </div>
            </li>
            <li>
              <span class="ab-pathway__number">02</span>
              <div>
                <h3>Live Labs</h3>
                <p>Practice applying the tools to real disciple-making situations.</p>
                <a href="/#ch-practice">Join the Next Lab</a>
              </div>
            </li>
            <li>
              <span class="ab-pathway__number">03</span>
              <div>
                <h3>Coaching + Tribe</h3>
                <p>Get help when you are stuck and keep growing with people doing the work.</p>
              </div>
            </li>
          </ol>

          <p class="ab-pathway__summary">
            Tools show you what to do. Labs help you practice. Coaching and tribe help you keep going.
          </p>
        </div>
      </div>

      <div class="ab-outcome">
        <p>
          The goal is not to complete training. It is to make disciples who make disciples, develop
          leaders, and see new churches begin.
        </p>
        <a class="button" href="/starter-tools/">Start Making Disciples</a>
      </div>
    </div>
  </section>

  <!-- Visual breath only. This can be swapped for the existing animated
       napkin component without changing the two-section page structure. -->
  <div class="ab-napkin-break" aria-hidden="true">
    <div class="ab-napkin">
      <span>Learn</span><b>&#8594;</b><span>Practice</span><b>&#8594;</b><span>Multiply</span>
    </div>
  </div>

  <section class="ab-founder">
    <div class="ab-founder__inner">
      <figure class="ab-founder__photo">
        <img
          src={founder.src}
          width={founder.width}
          height={founder.height}
          alt="Mark Goering with his wife, Megan, on a street in New York City"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Mark and Megan in New York City</figcaption>
      </figure>

      <div class="ab-founder__body">
        <p class="eyebrow eyebrow--clay">Built by a Practitioner</p>
        <h2>Mark Goering</h2>
        <p>
          Mark is a disciple-maker, church planter, and movement catalyst based in New York City. He
          founded Multiplying Disciples to close the gap between disciple-making training and
          disciple-making practice.
        </p>
        <p>
          He has spent years sharing the gospel, discipling new believers, developing leaders, and
          starting simple churches in the places where people live, work, and play. Everything here
          is shaped by real field experience and made to be used, not just read.
        </p>
        <p>Mark lives in Queens with his wife, Megan, and their twin sons.</p>
        <p class="ab-founder__cta">
          <a class="button" href="/starter-tools/">Start Making Disciples</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ab-main {
    padding: 7rem 1.5rem 6rem;
    background: radial-gradient(circle at 50% 0%, rgba(221, 232, 214, 0.7), transparent 34rem), var(--color-bg);
  }
  .ab-main__inner { max-width: var(--site-max-width); margin: 0 auto; }
  .ab-intro { max-width: 52rem; margin: 0 auto 5rem; text-align: center; }
  .ab-intro h1 {
    max-width: 18ch; margin: 0 auto 1.5rem; font-size: var(--fs-h1); line-height: 1.05;
    color: var(--color-primary); text-wrap: balance;
  }
  .ab-intro__lead {
    max-width: 39rem; margin: 0 auto; font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.55; color: var(--color-ink); text-wrap: balance;
  }
  .ab-story {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 7vw, 6.5rem); align-items: start; max-width: 66rem; margin: 0 auto;
  }
  .ab-story h2 {
    margin: 0 0 1.35rem; font-size: var(--fs-h2); line-height: 1.12;
    color: var(--color-primary); text-wrap: balance;
  }
  .ab-problem { padding-top: 2rem; }
  .ab-problem p {
    margin: 0 0 1.15rem; font-size: 1.075rem; line-height: 1.7; color: var(--color-ink);
  }
  .ab-problem .ab-problem__medium {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-primary);
  }
  .ab-pathway {
    padding: clamp(2rem, 4vw, 3rem); background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: var(--radius-card); box-shadow: var(--fm-shadow);
  }
  .ab-pathway__steps { margin: 2rem 0 0; padding: 0; list-style: none; }
  .ab-pathway__steps li {
    position: relative; display: grid; grid-template-columns: 2.5rem 1fr;
    gap: 1rem; padding: 0 0 2rem;
  }
  .ab-pathway__steps li:last-child { padding-bottom: 0; }
  .ab-pathway__steps li:not(:last-child)::before {
    content: ''; position: absolute; top: 2.35rem; bottom: 0.4rem; left: 1.1rem;
    width: 2px; background: var(--color-gold);
  }
  .ab-pathway__number {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%;
    font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700;
    color: var(--color-primary-text); background: var(--color-primary);
  }
  .ab-pathway h3 { margin: 0 0 0.3rem; font-size: var(--fs-card-title); color: var(--color-primary); }
  .ab-pathway__steps p {
    margin: 0 0 0.35rem; font-size: var(--fs-support); line-height: 1.5; color: var(--color-text-muted);
  }
  .ab-pathway__steps a {
    font-size: var(--fs-support); font-weight: 700; color: var(--color-clay-text); text-underline-offset: 0.2em;
  }
  .ab-pathway__summary {
    margin: 2.25rem 0 0; padding-top: 1.5rem; border-top: 1px solid var(--color-border);
    font-size: 1rem; font-weight: 700; line-height: 1.55; color: var(--color-primary);
  }
  .ab-outcome {
    display: flex; justify-content: space-between; align-items: center; gap: 2rem;
    max-width: 66rem; margin: 4.5rem auto 0; padding-top: 2.5rem; border-top: 2px solid var(--color-gold);
  }
  .ab-outcome p {
    max-width: 46rem; margin: 0; font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 700; line-height: 1.45; color: var(--color-primary);
  }
  .ab-outcome .button, .ab-founder__cta .button { flex: 0 0 auto; padding: 0.9rem 1.7rem; font-weight: 700; }

  .ab-napkin-break {
    display: grid; place-items: center; min-height: 8rem; padding: 0 1.5rem;
    background: linear-gradient(to bottom, var(--color-bg) 0 50%, var(--color-surface) 50% 100%);
  }
  .ab-napkin {
    display: flex; align-items: center; justify-content: center; gap: clamp(0.6rem, 2vw, 1.4rem);
    width: min(34rem, 92vw); min-height: 7rem; padding: 1.4rem 2rem; transform: rotate(-1.2deg);
    background: #fffdf8; border: 1px solid rgba(31, 37, 35, 0.12);
    box-shadow: 0 12px 30px rgba(31, 37, 35, 0.12); font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2.4vw, 1.25rem); font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--color-ink);
  }
  .ab-napkin b { color: var(--color-clay-text); font-size: 1.25em; }

  .ab-founder { padding: 6rem 1.5rem 3rem; background: var(--color-surface); }
  .ab-founder__inner {
    display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center; max-width: 58rem; margin: 0 auto;
  }
  .ab-founder__photo { margin: 0; }
  .ab-founder__photo img {
    display: block; width: 100%; height: auto; border-radius: var(--radius-image);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .ab-founder__photo figcaption {
    margin-top: 0.75rem; font-size: 0.9rem; font-style: italic; color: var(--color-text-muted);
  }
  .ab-founder__body h2 {
    margin: 0 0 1.25rem; font-size: var(--fs-h2); line-height: 1.12; color: var(--color-primary);
  }
  .ab-founder__body p:not(.eyebrow, .ab-founder__cta) {
    margin: 0 0 1.1rem; font-size: 1.0625rem; line-height: 1.65; color: var(--color-ink);
  }
  .ab-founder__cta { margin: 1.8rem 0 0; }

  @media (max-width: 780px) {
    .ab-main { padding: 5rem 1.25rem 4.5rem; }
    .ab-intro { margin-bottom: 3.5rem; }
    .ab-story { grid-template-columns: 1fr; gap: 2.75rem; }
    .ab-problem {
      display: flex;
      flex-direction: column;
      justify-content: center;
      aspect-ratio: 1 / 1;
      width: min(100%, 34rem);
      margin: 0 auto;
      padding: 12% 13% 11%;
      background: url('/tools-images/blank-napkin.webp') center / contain no-repeat;
    }
    .ab-problem h2 {
      margin-bottom: 0.85rem;
      font-size: clamp(1.45rem, 6vw, 2rem);
    }
    .ab-problem .ab-problem__medium {
      margin-bottom: 0.75rem;
      font-size: clamp(1rem, 3.6vw, 1.25rem);
      line-height: 1.4;
    }
    .ab-problem p:not(.ab-problem__medium) {
      margin-bottom: 0;
      font-size: clamp(0.86rem, 3.1vw, 1rem);
      line-height: 1.5;
    }
    .ab-outcome { display: block; margin-top: 3.5rem; }
    .ab-outcome .button { display: inline-block; margin-top: 1.5rem; }
    .ab-founder { padding: 4.5rem 1.25rem 2.5rem; }
    .ab-founder__inner { grid-template-columns: 1fr; gap: 2rem; }
    .ab-founder__photo { max-width: 22rem; margin: 0 auto; }
  }
  @media (max-width: 480px) {
    .ab-problem { padding: 11% 12% 10%; }
    .ab-pathway { padding: 1.75rem 1.35rem; }
    .ab-napkin { gap: 0.45rem; min-height: 6rem; padding: 1rem; letter-spacing: 0; }
    .ab-outcome .button, .ab-founder__cta .button { display: block; width: 100%; text-align: center; }
  }
</style>
