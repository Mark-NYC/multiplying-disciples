---
// Kingdom Ministry Training landing page.
// Every Training CTA in the Disciple Training cluster lands here.
//
// This page uses the homepage visual system: shared color tokens,
// monospace eyebrows, dark conviction band, Soft Sage practice band,
// and gold-ruled final CTA.
//
// Keep the session list in src/pages/search-index.json.ts in sync
// with SESSIONS below.
import BaseLayout from '../layouts/BaseLayout.astro';

interface Session {
  num: string;
  id: string;
  title: string;
  description: string;
  slidesUrl: string;
  videoUrl: string;
  videoLabel: string;
}

const SESSIONS: Session[] = [
  {
    num: '01',
    id: 'session-1',
    title: 'Hearing God for Self',
    description:
      'Unpack and practice hearing God for yourself. Learn hands-on activations in the ways God speaks and how you can hear Him practically.',
    slidesUrl:
      'https://docs.google.com/presentation/d/13xAfMBJuACeUwJ0RqmWCbCdllR6SYCM1MTHsE1aEYnM/edit?usp=sharing',
    videoUrl: 'https://www.youtube.com/watch?v=yHq6WdQoNDU',
    videoLabel: 'Watch the training',
  },
  {
    num: '02',
    id: 'session-2',
    title: 'Practicing Prophecy',
    description:
      'Look at prophecy in the New Testament to understand the why, who, and how of prophecy 101. Grow in giving and receiving prophetic words through hands-on activations.',
    slidesUrl:
      'https://docs.google.com/presentation/d/13r7HYZ_egjPmIMVMCxx6aV-6NNiTl2Tn9sCyRRq6Y2g/edit?usp=sharing',
    videoUrl: 'https://www.youtube.com/watch?v=qkqjphLSXRk',
    videoLabel: 'Watch the training',
  },
  {
    num: '03',
    id: 'session-3',
    title: 'Building a Community of Practice',
    description:
      'Experience and learn to create a community of practice that integrates Kingdom Ministry skills into a local church network context — including how to lead and start a 1 Corinthians 14 meeting.',
    slidesUrl: 'https://bit.ly/1COR14',
    videoUrl: 'https://rumble.com/v31o6gg-1cor14-meeting-how-to-lead-and-start-one.html',
    videoLabel: 'Watch the training',
  },
  {
    num: '04',
    id: 'session-4',
    title: 'Simple 5-Step Healing Prayer Model (GAPAP)',
    description:
      'Jesus both models and commands us to pray for the sick. This practical model, adapted from John Wimber’s 5-Step Model, trains any believer to pray more effectively for physical healing.',
    slidesUrl:
      'https://docs.google.com/presentation/d/1-qPkBIoF4OZ-EglqCi1FBiuzKkjB9eTIWKD3URhLZ_Y/edit?usp=sharing',
    videoUrl: 'https://www.youtube.com/watch?v=FmjPyUM-1SA',
    videoLabel: 'Watch the training',
  },
  {
    num: '05',
    id: 'session-5',
    title: 'Power Evangelism',
    description:
      'Demonstrating the Kingdom of God was a central part of Jesus’s ministry as He went about Galilee. Review what power evangelism includes — hearing God, prophecy, and healing prayer — and practice simple skills for engaging.',
    slidesUrl:
      'https://docs.google.com/presentation/d/1ROW4QDrGrWMjGYzqPK8pFft51B7Bla9SYyHfs5q6X9g/edit?usp=sharing',
    videoUrl: 'https://www.youtube.com/watch?v=z_DIWdOHDxg',
    videoLabel: 'Watch the training',
  },
];
---

<BaseLayout
  title="Kingdom Ministry Training | Multiplying Disciples"
  description="Bridging the theology and practice of spiritual gifts through hands-on training — hearing God, prophecy, healing prayer, and power evangelism."
  canonical="https://multiplyingdisciples.us/kingdom-ministry-training/"
  ogImage="/kingdom-ministry-training-2.webp"
  type="website"
>
  <!-- 1. HERO -->
  <section class="kmt-hero">
    <div class="kmt-hero__inner">
      <p class="eyebrow eyebrow--gold-text">Kingdom Ministry Training</p>

      <h1>
        Do what Jesus
        <span class="fm-underline fm-underline--shape-a fm-underline--clay-text">
          did
        </span>.
      </h1>

      <p class="kmt-hero__subhead">
        Hands-on training in hearing God, prophecy, healing prayer, and power evangelism —
        bridging the theology and practice of spiritual gifts.
      </p>

      <p class="kmt-hero__ctas">
        <a class="button" href="#session-1">Start with Session 1</a>
        <a class="button button--secondary" href="#sessions">See all five sessions</a>
      </p>

      <p class="kmt-hero__meta">
        Five sessions &middot; Slides + full training video for each
      </p>
    </div>
  </section>

  <!-- 2. THE MODEL -->
  <section class="kmt-model" id="the-model">
    <div class="kmt-model__inner">
      <p class="eyebrow eyebrow--gold-bright">The Model</p>

      <h2>
        Jesus proclaimed <em>and demonstrated</em> the gospel of the Kingdom.
      </h2>

      <p>
        Jesus not only shared the good news &mdash; He also demonstrated it in the power of the
        Holy Spirit (Matthew 4:23). We are called to follow in His model.
      </p>

      <p class="kmt-model__question">
        But how do you get started? That question is what these five sessions answer, one
        practiced skill at a time.
      </p>
    </div>
  </section>

  <!-- 3. THE FIVE SESSIONS -->
  <section class="kmt-sessions" id="sessions">
    <div class="kmt-sessions__inner">
      <p class="eyebrow eyebrow--gold-text">The Curriculum</p>

      <h2>Five sessions, practiced &mdash; not just presented.</h2>

      <ul class="kmt-format" aria-label="What every session includes">
        <li><strong>Teaching</strong> &mdash; the biblical why, who, and how</li>
        <li><strong>Tools</strong> &mdash; simple, reproducible models</li>
        <li><strong>Activations</strong> &mdash; hands-on practice, every session</li>
      </ul>

      <ol class="kmt-session-list">
        {
          SESSIONS.map((session) => (
            <li class="kmt-session" id={session.id}>
              <span class="kmt-session__num" aria-hidden="true">
                {session.num}
              </span>

              <div class="kmt-session__body">
                <p class="kmt-session__label">Session {session.num}</p>

                <h3>{session.title}</h3>

                <p class="kmt-session__description">
                  {session.description}
                </p>

                <p class="kmt-session__actions">
                  <a
                    class="button"
                    href={session.videoUrl}
                    target="_blank"
                    rel="noopener"
                  >
                    {session.videoLabel}
                  </a>

                  <a
                    class="button button--secondary"
                    href={session.slidesUrl}
                    target="_blank"
                    rel="noopener"
                  >
                    View the slides
                  </a>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. HEALTHY PRACTICE -->
  <section class="kmt-community" id="community">
    <div class="kmt-community__inner">
      <p class="eyebrow eyebrow--clay">Healthy Practice</p>

      <h2>Build a healthy Kingdom Ministry learning community.</h2>

      <p>
        As networks begin to implement Spirit-led Kingdom Ministry, most have questions about
        building in guardrails for healthy practice.
      </p>

      <p>
        As a practicing network in New York City, we offer the discipleship packet below as an
        emerging model &mdash; one way to build a community of practice into short- and mid-term
        discipleship. The structure models a regular equipping and self-correcting rhythm for
        emerging and established networks.
      </p>

      <p class="kmt-community__cta">
        <a
          class="button"
          href="/wp-content/uploads/2023/04/Church-Waffle-English-04-2023.pdf"
          target="_blank"
          rel="noopener"
        >
          View the discipleship packet (PDF)
        </a>
      </p>

      <p class="kmt-community__note">
        Why a system instead of more content? See
        <a href="/content-vs-systems-the-game-changer-for-leadership-development/">
          Content vs. Systems
        </a>.
      </p>
    </div>
  </section>

  <!-- 5. FINAL CTA -->
  <section class="kmt-final-cta">
    <div class="kmt-final-cta__inner">
      <h2>
        Don&rsquo;t practice
        <span class="fm-underline fm-underline--shape-b fm-underline--clay">
          alone
        </span>.
      </h2>

      <p class="kmt-final-cta__body">
        Work through the sessions at your own pace &mdash; then practice what you are learning
        with real people.
      </p>

      <p class="kmt-final-cta__ctas">
        <a class="button" href="/free-training/">
          Join a Free Live Training
        </a>
      </p>

      <p class="kmt-final-cta__secondary">
        <a href="/how-to-get-started-in-four-fields-training/">
          Or get started in Four Fields training
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero -------------------------------------------------------- */

  .kmt-hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 42rem;
    padding: 6.5rem 1.25rem 5.5rem;
    text-align: center;
    isolation: isolate;
    background:
      linear-gradient(
        180deg,
        rgba(12, 34, 28, 0.7) 0%,
        rgba(12, 34, 28, 0.58) 45%,
        rgba(12, 34, 28, 0.75) 100%
      ),
      url('/kingdom-ministry-training-2.webp') center center / cover no-repeat;
  }

  .kmt-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        circle at center,
        rgba(12, 34, 28, 0.05) 0%,
        rgba(12, 34, 28, 0.25) 75%,
        rgba(12, 34, 28, 0.4) 100%
      );
    pointer-events: none;
  }

  .kmt-hero__inner {
    width: 100%;
    max-width: 48rem;
    margin: 0 auto;
  }

  .kmt-hero .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-gold-bright);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }

  .kmt-hero h1 {
    max-width: 43rem;
    margin: 0 auto 1.5rem;
    font-size: var(--fs-h1);
    line-height: 1.05;
    color: #ffffff;
    text-wrap: balance;
    text-shadow:
      0 2px 6px rgba(0, 0, 0, 0.3),
      0 12px 32px rgba(0, 0, 0, 0.28);
  }

  .kmt-hero h1 .fm-underline {
    color: #ffffff;
  }

  .kmt-hero__subhead {
    max-width: 38rem;
    margin: 0 auto 2.5rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.94);
    text-wrap: balance;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.38);
  }

  .kmt-hero__ctas {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 1.75rem;
  }

  .kmt-hero__ctas .button {
    padding: 0.9rem 2.1rem;
    font-size: 1.05rem;
  }

  .kmt-hero__ctas .button:not(.button--secondary) {
    color: var(--color-primary);
    font-weight: 700;
    background: var(--color-gold-bright);
    border-color: var(--color-gold-bright);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  .kmt-hero__ctas .button:not(.button--secondary):hover {
    background: var(--color-gold);
    border-color: var(--color-gold);
  }

  .kmt-hero__ctas .button--secondary {
    color: #ffffff;
    background: rgba(12, 34, 28, 0.34);
    border-color: rgba(255, 255, 255, 0.72);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    backdrop-filter: blur(4px);
  }

  .kmt-hero__ctas .button--secondary:hover {
    color: var(--color-primary);
    background: #ffffff;
    border-color: #ffffff;
  }

  .kmt-hero__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 640px) {
    .kmt-hero {
      min-height: 39rem;
      padding: 4.75rem 1.25rem 4.25rem;
      background-position: 51% center;
    }

    .kmt-hero__subhead {
      max-width: 31rem;
      margin-bottom: 2rem;
    }

    .kmt-hero__ctas {
      align-items: stretch;
      gap: 0.75rem;
    }

    .kmt-hero__ctas .button {
      width: 100%;
      max-width: 22rem;
      margin: 0 auto;
      text-align: center;
    }

    .kmt-hero__meta {
      max-width: 19rem;
      margin-right: auto;
      margin-left: auto;
      line-height: 1.6;
    }
  }

  /* --- The Model --------------------------------------------------- */

  .kmt-model {
    padding: 5rem 1.5rem;
    text-align: center;
    background: var(--color-primary);
  }

  .kmt-model__inner {
    max-width: 44rem;
    margin: 0 auto;
  }

  .kmt-model h2 {
    margin: 0 0 1.5rem;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-primary-text);
  }

  .kmt-model h2 em {
    font-style: normal;
    color: var(--color-gold-bright);
  }

  .kmt-model p:not(.eyebrow) {
    max-width: 38rem;
    margin: 0 auto 1.1rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: rgba(247, 243, 234, 0.88);
  }

  .kmt-model__question {
    font-weight: 600;
    color: var(--color-primary-text) !important;
  }

  .kmt-model p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .kmt-model {
      padding: 4rem 1.25rem;
    }
  }

  /* --- Sessions ---------------------------------------------------- */

  .kmt-sessions {
    padding: 5.5rem 1.25rem 6rem;
  }

  .kmt-sessions__inner {
    max-width: 52rem;
    margin: 0 auto;
    text-align: center;
  }

  .kmt-sessions h2 {
    margin: 0 0 2rem;
    font-size: var(--fs-h2);
    line-height: 1.12;
    color: var(--color-primary);
  }

  .kmt-format {
    display: flex;
    justify-content: center;
    gap: 0.75rem 2.5rem;
    flex-wrap: wrap;
    margin: 0 0 3.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--fs-support);
    color: var(--color-text-muted);
  }

  .kmt-format strong {
    color: var(--color-ink);
  }

  .kmt-session-list {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .kmt-session {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    scroll-margin-top: 1.5rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 3px 14px rgba(31, 37, 35, 0.06);
  }

  .kmt-session__num {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 2rem 0 0;
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-gold);
    border-right: 1px solid var(--color-border);
  }

  .kmt-session__body {
    padding: 2rem 2.25rem 2.25rem;
  }

  .kmt-session__label {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-clay-text);
  }

  .kmt-session h3 {
    margin: 0 0 0.75rem;
    font-size: var(--fs-card-title);
    line-height: 1.2;
    color: var(--color-primary);
  }

  .kmt-session__description {
    margin: 0 0 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .kmt-session__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 0;
  }

  @media (max-width: 640px) {
    .kmt-sessions {
      padding: 4.5rem 1.25rem;
    }

    .kmt-session {
      grid-template-columns: 1fr;
    }

    .kmt-session__num {
      justify-content: flex-start;
      padding: 1.5rem 1.5rem 0;
      font-size: 1.5rem;
      border-right: none;
    }

    .kmt-session__body {
      padding: 0.9rem 1.5rem 1.75rem;
    }

    .kmt-session__actions .button {
      width: 100%;
      text-align: center;
    }
  }

  /* --- Healthy practice -------------------------------------------- */

  .kmt-community {
    padding: 5rem 1.5rem;
    background: var(--color-surface);
  }

  .kmt-community__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    text-align: center;
  }

  .kmt-community h2 {
    margin: 0 0 1.5rem;
    font-size: var(--fs-h3);
    line-height: 1.15;
    color: var(--color-primary);
  }

  .kmt-community p:not(.eyebrow) {
    margin: 0 0 1.1rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .kmt-community__cta {
    margin: 2rem 0 1.25rem !important;
  }

  .kmt-community__cta .button {
    padding: 0.9rem 2.1rem;
    font-size: 1rem;
  }

  .kmt-community__note {
    margin-bottom: 0 !important;
    font-size: var(--fs-support) !important;
    color: var(--color-text-muted) !important;
  }

  @media (max-width: 640px) {
    .kmt-community {
      padding: 4rem 1.25rem;
    }
  }

  /* --- Final CTA --------------------------------------------------- */

  .kmt-final-cta {
    padding: 5.75rem 1.5rem;
    text-align: center;
    background: var(--color-bg);
    border-top: 3px solid var(--color-gold);
  }

  .kmt-final-cta__inner {
    max-width: 38rem;
    margin: 0 auto;
  }

  .kmt-final-cta h2 {
    margin: 0 0 1.5rem;
    font-size: var(--fs-h2);
    line-height: 1.15;
    color: var(--color-primary);
  }

  .kmt-final-cta__body {
    margin: 0 0 2.25rem;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .kmt-final-cta__ctas {
    margin: 0 0 1.25rem;
  }

  .kmt-final-cta__ctas .button {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
  }

  .kmt-final-cta__secondary {
    margin: 0;
    font-size: var(--fs-support);
  }

  .kmt-final-cta__secondary a {
    font-weight: 600;
    color: var(--color-clay-text);
  }

  @media (max-width: 640px) {
    .kmt-final-cta {
      padding: 4rem 1.5rem;
    }
  }
</style>
