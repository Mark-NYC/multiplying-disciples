---
// /blog/ — a new Astro page, not a migration of WordPress content.
// The WordPress export confirmed `post_name: blog` is an empty
// posts-page placeholder (WordPress's Settings -> Reading "posts
// page", auto-populated by the post loop, no authored body of its
// own) — see PHASE_6_ARCHIVE_URL_DECISION.md section 5. Already
// linked from header/footer nav (src/data/navigation.ts) today, so
// this closes what would otherwise be a live nav-linked 404.
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleList from '../../components/ArticleList.astro';
import QuestionSearch from '../../components/QuestionSearch.astro';
import { imageDimensions } from '../../lib/image-dimensions.mjs';

const [articles, hubs] = await Promise.all([getCollection('articles'), getCollection('hubs')]);

const TIER_RANK: Record<string, number> = {
  'tier-1': 0,
  'tier-2': 1,
  'tier-3': 2,
  unknown: 3,
};

function bestDate(entry: CollectionEntry<'articles'>): Date | undefined {
  return entry.data.updated ?? entry.data.date;
}

// Sort newest-first when a reliable date exists; since roughly half of
// migrated articles have no date/updated field at all (inconsistent
// across WordPress export data), migration priority (tier) is the
// primary sort key and date is the secondary tiebreaker within a tier,
// per this phase's instructions.
const sorted = articles
  .filter((entry) => !entry.data.exclude_from_blog)
  .sort((a, b) => {
  const tierDiff = (TIER_RANK[a.data.migration_priority] ?? 99) - (TIER_RANK[b.data.migration_priority] ?? 99);
  if (tierDiff !== 0) return tierDiff;

  const dateA = bestDate(a);
  const dateB = bestDate(b);
  if (dateA && dateB) return dateB.valueOf() - dateA.valueOf();
  if (dateA && !dateB) return -1;
  if (!dateA && dateB) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
];

// Hub pills, largest topic first — each carries a live article count
// so the row reads as a real map of the library, not a link dump.
const hubArticleCount = new Map<string, number>();
for (const entry of sorted) {
  if (!entry.data.hub) continue;
  hubArticleCount.set(entry.data.hub, (hubArticleCount.get(entry.data.hub) ?? 0) + 1);
}

const hubPills = [...hubs]
  .map((hub) => ({
    title: hub.data.title,
    slug: hub.data.slug,
    count: hubArticleCount.get(hub.data.slug.replace(/^\/|\/$/g, '')) ?? 0,
  }))
  .filter((hub) => hub.count > 0)
  .sort((a, b) => b.count - a.count || a.title.localeCompare(b.title));

// Featured band — always exactly 3. Editorially flagged articles
// (`featured: true`) come first in index order; if fewer than 3 are
// flagged, the band fills from the top of the index. The first slot
// renders as the large lead card.
const flagged = sorted.filter((entry) => entry.data.featured);
const featured = [
  ...flagged,
  ...sorted.filter((entry) => !entry.data.featured),
].slice(0, 3);
const featuredIds = new Set(featured.map((entry) => entry.id));
const listEntries = sorted.filter((entry) => !featuredIds.has(entry.id));

function hubTitleFor(entry: CollectionEntry<'articles'>): string | undefined {
  if (!entry.data.hub) return undefined;
  return hubs.find((hub) => hub.id === `/${entry.data.hub}/`)?.data.title;
}

const featuredCards = featured.map((entry, index) => {
  const image = entry.data.og_image ?? entry.data.hero_image;
  return {
    href: entry.data.slug,
    title: entry.data.display_title ?? entry.data.title,
    description: entry.data.description,
    hubTitle: hubTitleFor(entry),
    image,
    dims: image ? imageDimensions(image) : undefined,
    questions: entry.data.questions.slice(0, 3),
    lead: index === 0,
  };
});
---

<BaseLayout
  title="Blog"
  description="Browse every article from Multiplying Disciples on evangelism, discipleship, prayer, and church planting movements — sorted newest first."
  canonical="https://multiplyingdisciples.us/blog/"
  type="website"
>
  <div class="page-container page-container--wide">
    <Breadcrumbs items={breadcrumbItems} />

    <p class="eyebrow eyebrow--gold-text">Field Manual &middot; Full Index</p>
    <h1>Blog</h1>
    <p class="blog-intro">
      Every article we've published on evangelism, discipleship, prayer, and church planting
      movements — in one place.
    </p>

    <QuestionSearch />

    {
      hubPills.length > 0 && (
        <nav class="blog-topics" aria-label="Browse by topic">
          <p class="blog-topics__label eyebrow eyebrow--gold-text">Browse by Topic</p>
          <div class="blog-topics__scroller" data-topics-scroller>
            <button
              class="blog-topics__arrow blog-topics__arrow--prev"
              type="button"
              aria-label="Scroll topics left"
              data-topics-prev
              hidden
            >
              <span aria-hidden="true">&lsaquo;</span>
            </button>
            <ul class="blog-topics__list" data-topics-list>
              {hubPills.map((hub) => (
                <li>
                  <a class="blog-topics__pill" href={hub.slug}>
                    <span class="blog-topics__name">{hub.title}</span>
                    <span class="blog-topics__count" aria-hidden="true">{hub.count}</span>
                    <span class="sr-only">
                      &nbsp;— {hub.count} article{hub.count === 1 ? '' : 's'}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <button
              class="blog-topics__arrow blog-topics__arrow--next"
              type="button"
              aria-label="Scroll topics right"
              data-topics-next
              hidden
            >
              <span aria-hidden="true">&rsaquo;</span>
            </button>
          </div>

          {/* Mobile only: the same topics as a native dropdown. */}
          <div class="blog-topics__select-wrap">
            <select class="blog-topics__select" data-topics-select aria-label="Browse by topic">
              <option value="" selected>Choose a topic&hellip;</option>
              {hubPills.map((hub) => (
                <option value={hub.slug}>
                  {hub.title} ({hub.count})
                </option>
              ))}
            </select>
            <span class="blog-topics__select-caret" aria-hidden="true">&rsaquo;</span>
          </div>
        </nav>
      )
    }

    <section class="blog-featured" aria-label="Featured articles">
      <p class="blog-featured__label eyebrow eyebrow--gold-text">Featured</p>
      <div class="blog-featured__grid">
        {featuredCards.map((card) => (
          <article class:list={['blog-featured__card', { 'blog-featured__card--lead': card.lead }]}>
            {card.image && (
              <a class="blog-featured__media" href={card.href} aria-hidden="true" tabindex="-1">
                <img
                  src={card.image}
                  alt=""
                  loading={card.lead ? 'eager' : 'lazy'}
                  decoding="async"
                  width={card.dims?.width}
                  height={card.dims?.height}
                />
              </a>
            )}
            <div class="blog-featured__body">
              {card.hubTitle && <p class="blog-featured__hub">{card.hubTitle}</p>}
              <h2 class="blog-featured__title">
                <a href={card.href}>{card.title}</a>
              </h2>
              <p class="blog-featured__desc">{card.description}</p>
              {card.questions.length > 0 && (
                <ul class="blog-featured__questions" aria-label="Questions this article answers">
                  {card.questions.map((question) => (
                    <li>
                      <a class="qpill" href={`${card.href}#${question.anchor}`}>
                        <span>{question.q}</span>
                        <span class="qpill__arrow" aria-hidden="true">&rarr;</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <p class="blog-all-label eyebrow eyebrow--gold-text">All Articles</p>
    <ArticleList entries={listEntries} />
  </div>
</BaseLayout>

<style>
  /* Same Primary Green headline treatment as article pages. */
  h1 {
    color: var(--color-primary);
  }

  .blog-intro {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    max-width: 58ch;
  }

  /* Browse-by-topic pills — same visual family as the article
     role-nav pills (white pill, hairline border, quiet lift on
     hover), each with a live article count in a Soft Sage badge. */
  .blog-topics {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-topics__label {
    margin: 0 0 0.85rem;
  }

  /* Single-row horizontal scroller instead of a wrapping cloud — the
     row slides left/right (arrows on desktop, swipe/trackpad on touch)
     so the topic list stays one line tall. */
  .blog-topics__scroller {
    position: relative;
    display: flex;
    align-items: center;
  }

  .blog-topics__list {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0.15rem 0.1rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    /* Hide the scrollbar; the arrows + edge fades signal scrollability. */
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .blog-topics__list::-webkit-scrollbar {
    display: none;
  }

  /* Fade the edges when there's more to scroll, toggled by JS via the
     is-start / is-end classes. Default (no JS): both fades, since the
     row may overflow either way. */
  .blog-topics__scroller::before,
  .blog-topics__scroller::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.25rem;
    pointer-events: none;
    z-index: 1;
    opacity: 1;
    transition: opacity 0.15s ease;
  }

  .blog-topics__scroller::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), transparent);
  }

  .blog-topics__scroller::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), transparent);
  }

  .blog-topics__scroller.is-start::before {
    opacity: 0;
  }

  .blog-topics__scroller.is-end::after {
    opacity: 0;
  }

  .blog-topics__arrow {
    flex-shrink: 0;
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-primary);
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    box-shadow: 0 1px 3px rgba(31, 37, 35, 0.06);
    cursor: pointer;
    z-index: 2;
  }

  /* Shown only when JS confirms the row overflows (it un-hides the
     buttons and the .blog-topics__scroller--scrollable flag). */
  .blog-topics__scroller--scrollable .blog-topics__arrow:not([hidden]) {
    display: inline-flex;
  }

  .blog-topics__arrow--prev {
    margin-right: 0.4rem;
  }

  .blog-topics__arrow--next {
    margin-left: 0.4rem;
  }

  .blog-topics__arrow:hover {
    border-color: var(--color-accent);
    color: var(--color-primary-hover);
  }

  .blog-topics__arrow:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* At an end of the row: keep the button in place (no width shift) but
     dim it and drop the hover affordance. */
  .blog-topics__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .blog-topics__arrow:disabled:hover {
    border-color: var(--color-border);
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-topics__list {
      scroll-behavior: auto;
    }
  }

  /* Mobile-only native dropdown. Hidden on desktop, where the slider
     above is shown instead. */
  .blog-topics__select-wrap {
    display: none;
    position: relative;
  }

  .blog-topics__select {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.6rem 2.75rem 0.6rem 1.1rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    box-shadow: 0 1px 3px rgba(31, 37, 35, 0.05);
    /* Custom caret via the sibling span, so drop the native one. */
    appearance: none;
    -webkit-appearance: none;
  }

  .blog-topics__select:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }

  .blog-topics__select-caret {
    position: absolute;
    top: 50%;
    right: 1.1rem;
    transform: translateY(-50%) rotate(90deg);
    color: var(--color-primary);
    font-size: 1.35rem;
    line-height: 1;
    pointer-events: none;
  }

  @media (max-width: 600px) {
    .blog-topics__scroller {
      display: none;
    }

    .blog-topics__select-wrap {
      display: block;
    }
  }

  .blog-topics__pill {
    flex: 0 0 auto;
    scroll-snap-align: start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.5rem 0.45rem 1.1rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    box-shadow: 0 1px 3px rgba(31, 37, 35, 0.05);
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
    white-space: nowrap;
    text-decoration: none;
  }

  .blog-topics__pill:hover {
    border-color: var(--color-accent);
    box-shadow: 0 3px 10px rgba(23, 76, 60, 0.12);
    transform: translateY(-1px);
  }

  .blog-topics__pill:hover .blog-topics__name {
    color: var(--color-primary);
  }

  .blog-topics__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.65rem;
    height: 1.65rem;
    padding: 0 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .blog-topics__pill:hover .blog-topics__count {
    background: var(--color-accent);
    color: var(--color-accent-text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .blog-topics__pill {
      transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }

    .blog-topics__count {
      transition: background 0.15s ease, color 0.15s ease;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* --- Featured band ----------------------------------------------
     Editorial lead-plus-two layout: the first card runs full width
     with a wide image; the other two share a row on desktop. Calm,
     not card-boxed — image, eyebrow, green title, description. */
  /* Featured band — a full-width lead card (image beside text on
     desktop) plus two image-top cards, all in the same card language
     as the ArticleList grid below. */
  .blog-featured {
    margin: 0 0 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-featured__label {
    margin: 0 0 1rem;
  }

  .blog-featured__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 720px) {
    .blog-featured__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .blog-featured__card--lead {
      grid-column: 1 / -1;
    }
  }

  .blog-featured__card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(31, 37, 35, 0.05);
  }

  .blog-featured__card:hover {
    border-color: var(--color-accent);
  }

  @media (min-width: 720px) {
    .blog-featured__card--lead {
      flex-direction: row;
    }

    .blog-featured__card--lead .blog-featured__media {
      flex: 0 0 52%;
      aspect-ratio: auto;
    }

    .blog-featured__card--lead .blog-featured__body {
      flex: 1;
      align-self: center;
      padding: 1.75rem 1.9rem;
    }
  }

  .blog-featured__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: var(--color-surface);
  }

  .blog-featured__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .blog-featured__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.1rem 1.15rem 1.2rem;
  }

  .blog-featured__hub {
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-text);
  }

  .blog-featured__title {
    margin: 0 0 0.5rem;
    font-size: 1.3rem;
    line-height: 1.3;
  }

  .blog-featured__title a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .blog-featured__title a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .blog-featured__card--lead .blog-featured__title {
    font-size: clamp(1.5rem, 1.3rem + 1vw, 2rem);
    line-height: 1.2;
  }

  .blog-featured__desc {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* Question pills — same visual family as the ArticleList cards. */
  .blog-featured__questions {
    list-style: none;
    margin: auto 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px dashed var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .qpill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  .qpill__arrow {
    color: var(--color-accent);
    font-weight: 700;
  }

  .qpill:hover {
    border-color: var(--color-accent);
    background: #ffffff;
    color: var(--color-primary-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .blog-featured__card {
      transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }

    .blog-featured__card:hover {
      box-shadow: 0 8px 24px rgba(23, 76, 60, 0.12);
      transform: translateY(-2px);
    }

    .blog-featured__media img {
      transition: transform 0.35s ease;
    }

    .blog-featured__card:hover .blog-featured__media img {
      transform: scale(1.02);
    }

    .qpill {
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    }

    .qpill:hover {
      transform: translateY(-1px);
    }
  }

  .blog-all-label {
    margin: 0 0 0.5rem;
  }
</style>

<script>
  // Browse-by-topic row: a horizontal scroller. Reveal the prev/next
  // arrows only when the row actually overflows, disable each at its end,
  // and toggle the edge fades. Progressive enhancement — with JS off the
  // row still scrolls natively (trackpad/touch) and the arrows stay
  // hidden.
  const scroller = document.querySelector('[data-topics-scroller]');
  const list = scroller?.querySelector('[data-topics-list]');
  const prev = scroller?.querySelector('[data-topics-prev]');
  const next = scroller?.querySelector('[data-topics-next]');

  if (
    scroller &&
    list instanceof HTMLElement &&
    prev instanceof HTMLButtonElement &&
    next instanceof HTMLButtonElement
  ) {
    const update = () => {
      const overflow = list.scrollWidth - list.clientWidth > 2;
      scroller.classList.toggle('blog-topics__scroller--scrollable', overflow);
      if (!overflow) {
        prev.hidden = true;
        next.hidden = true;
        scroller.classList.add('is-start', 'is-end');
        return;
      }
      const atStart = list.scrollLeft <= 1;
      const atEnd = list.scrollLeft + list.clientWidth >= list.scrollWidth - 1;
      prev.hidden = false;
      next.hidden = false;
      prev.disabled = atStart;
      next.disabled = atEnd;
      scroller.classList.toggle('is-start', atStart);
      scroller.classList.toggle('is-end', atEnd);
    };

    const nudge = (dir: number) => {
      list.scrollBy({ left: dir * list.clientWidth * 0.8, behavior: 'smooth' });
    };

    prev.addEventListener('click', () => nudge(-1));
    next.addEventListener('click', () => nudge(1));
    let ticking = false;
    list.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    update();
  }

  // Mobile dropdown: navigate to the chosen topic. The slider and this
  // select carry the same links; CSS shows only one at a time.
  const topicSelect = document.querySelector('[data-topics-select]');
  if (topicSelect instanceof HTMLSelectElement) {
    topicSelect.addEventListener('change', () => {
      if (topicSelect.value) window.location.href = topicSelect.value;
    });
  }
</script>
